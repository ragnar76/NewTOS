+  rm -rf "$TOP"
+fi
 if [ ! -d "$TOP" ]; then
   [ -f "$TARBALL" ] || { echo "error: pristine tarball $TARBALL missing" >&2; exit 1; }
   echo "extracting pristine cflib from $(basename "$TARBALL")…"
