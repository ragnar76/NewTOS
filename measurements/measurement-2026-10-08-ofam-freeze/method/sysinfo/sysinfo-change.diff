+    aes_intin[0] = FMD_START;
+    aes_intin[1] = x; aes_intin[2] = y; aes_intin[3] = w; aes_intin[4] = h;
+    aes_intin[5] = x; aes_intin[6] = y; aes_intin[7] = w; aes_intin[8] = h;
+    aes_call(51, 9, 1, 0); /* form_dial */
