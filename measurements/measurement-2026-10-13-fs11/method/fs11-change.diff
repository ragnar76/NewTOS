+/// BDOS character-device handle (`-1` CON, `-2` AUX, `-3` PRN) → BIOS device
+/// number: EmuTOS `HXFORM(h) = 3 + h` (`bdos/console.h:36`).
+fn hxform(numl: i16) -> u16 {
+    (3 + numl) as u16
