+/// `char ch`, `console.c:542`), echo to that device's `Bconout`.
+struct DeviceLineIo<'a, B: DevBuf> {
+    dev: &'static dyn CharDevice,
+    buf: &'a B,
+    faulted: core::cell::Cell<bool>,
