+/// selected button is deselected on the way out.
+fn inf_what(tree: &mut [Object], ok: usize) -> i16 {
+    let field = inf_gindex(tree, ok, 2);
+    if field == -1 {
+        return -1;
+    }
+    tree[ok + field as usize].ob_state = 0; // `objptr->ob_state = NORMAL;`
+    i16::from(field == 0)
+}
