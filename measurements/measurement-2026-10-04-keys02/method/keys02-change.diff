+    p[-1] = (unsigned long)old_kbdvec;   /* restore (A6.4) */
+
+    puts_("KBDVEC: hook saw");
+    for (i = 0; i < nseen; i++) {
+        puts_(" ");
+        puthex(seen[i], 2);
+    }
+    puts_("\r\nKBDVEC: AES words");
+    for (i = 0; i < nwords; i++) {
+        puts_(" ");
+        puthex(words[i], 4);
+    }
+    puts_("\r\nKBDVEC: Bconin=");
+    puthex((unsigned long)bc, 8);
+    puts_("\r\n");
