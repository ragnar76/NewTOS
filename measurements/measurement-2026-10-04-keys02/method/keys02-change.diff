+        seen[n] = (unsigned char)scancode;
+        nseen = n + 1;
+    }
+    old_kbdvec(scancode, iorec);
+}
+
+/* ------------------------------------------------------------------------- */
+
+static const unsigned char want[6] = { 0x48, 0x4D, 0xCD, 0xC8, 0x1E, 0x9E };
+
