+        regs: [0; 8],
+        func: func as u64,
+        svc_imm: TrapClass::Xbios as u16,
+    })
+}
+
+fn gemdos(func: u16, a0: u64, a1: u64, a2: u64) -> i32 {
+    tos_api::gemdos::dispatch(&TrapArgs {
