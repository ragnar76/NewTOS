# drop-shortcut.script -- DESK62 bug path: drag C:\README.TXT from the C:\ window (text view) onto the desktop shortcut QED.NAP.
# Geometry from screendumps/cal-park.png (640x480): README row y~138 x~275; shortcut icon centre ~(130,38).
# Park bottom-left first (left/down moves only: the pointer never crosses the menu bar).
200 0xF8 0x80 0x7F 0xF8 0x80 0x7F 0xF8 0x80 0x7F 0xF8 0x80 0x7F 0xF8 0x80 0x7F 0xF8 0x80 0x7F
# (0,479) -> (275,138): +275 = 127+127+21, -341 = -128-128-85
300 0xF8 0x7F 0x80 0xF8 0x7F 0x80 0xF8 0x15 0xAB
# click: select README.TXT
500 0xFA 0x00 0x00
510 0xF8 0x00 0x00
# press and hold on the selected item, drag (-145,-100) in five steps to (130,38), release on the shortcut
800 0xFA 0x00 0x00
850 0xFA 0xE3 0xEC
870 0xFA 0xE3 0xEC
890 0xFA 0xE3 0xEC
910 0xFA 0xE3 0xEC
930 0xFA 0xE3 0xEC
1000 0xF8 0x00 0x00
# +20 s after the drop: move the pointer onto free desktop (130,38)->(330,418) and click there
5000 0xF8 0x64 0x64 0xF8 0x64 0x64 0xF8 0x00 0x50
5100 0xFA 0x00 0x00
5110 0xF8 0x00 0x00
