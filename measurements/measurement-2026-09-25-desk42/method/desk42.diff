+/// then [`inf_sset`] into the field's text.
+fn set_tedinfo_name(buf: &mut [u8], name: &[u8]) {
+    let mut temp = [0u8; LEN_ZFNAME];
+    let n = fmt_str(name, &mut temp);
+    inf_sset(buf, &temp[..n]);
+}
