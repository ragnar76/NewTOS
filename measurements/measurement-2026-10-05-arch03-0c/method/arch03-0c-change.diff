+.Luacc_ct_loop:
+    ldrb    w3, [x1], #1
+.Luacc_ct_insn:
+    sttrb   w3, [x0]
+    add     x0, x0, #1
+    subs    x2, x2, #1
+    b.ne    .Luacc_ct_loop
+.Luacc_ct_done:
+    mov     x0, x2
+    ret
+
+    // x0 = dst (kernel), x1 = src (user), x2 = max; returns length or -1
