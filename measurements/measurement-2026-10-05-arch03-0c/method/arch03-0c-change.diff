+        #[link_name = "__uaccess_st16"]
+        pub fn st16(dst: u64, v: u64) -> u64;
+        #[link_name = "__uaccess_st32"]
+        pub fn st32(dst: u64, v: u64) -> u64;
+        #[link_name = "__uaccess_st64"]
+        pub fn st64(dst: u64, v: u64) -> u64;
+        #[link_name = "__uaccess_copy_from"]
