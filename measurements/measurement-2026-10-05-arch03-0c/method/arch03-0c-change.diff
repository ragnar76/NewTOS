+.Luacc_sc_insn:
+    ldtrb   w3, [x1, #0]
+    cbz     w3, .Luacc_sc_done
+    strb    w3, [x0, x4]
+    add     x1, x1, #1
+    add     x4, x4, #1
+    b       .Luacc_sc_loop
+.Luacc_sc_done:
+    mov     x0, x4
+    ret
+.Luacc_sc_fault:
