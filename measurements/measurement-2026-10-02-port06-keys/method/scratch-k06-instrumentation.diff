+// K06-TEMP BEGIN -- scripted IKBD key make/break for the PORT06 key-hold
+// diagnosis (QEMU raspi4b has no USB keyboard). Feeds exactly the bytes
+// `drivers::usb::hid::keyboard_report` feeds for a held key: ONE make when the
+// key goes down, ONE break when it goes up -- a HID boot keyboard reports
+// changes only. Schedule relative to the first pump of the first EL0 program.
+pub mod k06_inject {
+    use core::sync::atomic::{AtomicU32, AtomicUsize, Ordering};
+    static T0: AtomicU32 = AtomicU32::new(0);
+    static NEXT: AtomicUsize = AtomicUsize::new(0);
+    // (ticks after arm @200 Hz, byte). 0x48 = up arrow make, 0xC8 = break.
+    const SCRIPT: &[(u32, u8)] = &[
+        (3000, 0x48), (4000, 0xC8),   // hold up-arrow 5 s
+        (4600, 0x48), (5000, 0xC8),   // hold again 2 s
+    ];
+    pub fn step() {
+        if tos_api::bdos::process::RUN.load(Ordering::Acquire).is_null() {
+            return;
+        }
+        let now = tos_api::bios::tick::hz_200();
+        if T0.load(Ordering::Relaxed) == 0 {
+            T0.store(now.max(1), Ordering::Relaxed);
+            crate::kprintln!("[k06] injector armed at hz_200 {}", now);
+            return;
+        }
+        let t0 = T0.load(Ordering::Relaxed);
+        let i = NEXT.load(Ordering::Relaxed);
+        if i >= SCRIPT.len() {
+            return;
+        }
+        let (at, b) = SCRIPT[i];
+        if now.wrapping_sub(t0) >= at {
+            crate::kprintln!("[k06] feed {:#04x} at hz_200 {} (+{})", b, now, now.wrapping_sub(t0));
+            crate::ikbd::feed(b);
+            NEXT.store(i + 1, Ordering::Relaxed);
+        }
+    }
 }
