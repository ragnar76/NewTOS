+//! Memory protection per address space — FreeMiNT's `PROT_P/G/S/PR/I` on
+//! AArch64 (ARCH03 stage 3b, plan `docs/analysis/arch03-implementation-plan.md`
+//! §3.2–§3.4, §3.15, invariants I7–I10, decisions E5, E10, E15, E16).
+//!
+//! ## Model (FreeMiNT `sys/arch/mprot030.c`)
+//!
+//! Every allocated pool block carries a **protection mode** — FreeMiNT keeps
+//! it in `global_mode_table` per page (`mprot030.c:605-615`), NewTOS in a
+//! record per block ([`record`]): `Mxalloc` takes it from the mode word or
+//! the caller's `PRGFLAGS` (`sys/dosmem.c:209-221`), `Malloc` from the
+//! `PRGFLAGS` (nibble 0), a program's TPA and environment from the program's
+//! own `PRGFLAGS` (`sys/memory.c:1403-1407,1511-1513`, `sys/k_exec.c:398`),
+//! the kernel's own blocks are `PROT_S` (`sys/memory.c:150-159`).
+//!
+//! What a process may do with a page follows from the mode and whether it is
+//! an **owner** (`mark_region`, `mprot030.c:617-693`; table §3.3 of the
+//! plan):
+//!
+//! | mode | owner | everybody else |
+//! |---|---|---|
+//! | `PROT_P` | read/write/execute | invalid |
+//! | `PROT_G` | read/write/execute | read/write/execute |
+//! | `PROT_S` | read/write/execute | invalid (EL1 reaches it through the kernel alias) |
+//! | `PROT_PR` | read/write/execute | read/execute |
+//! | `PROT_I` | invalid | invalid |
+//!
+//! Free pool memory is invalid for everybody (I8, FreeMiNT `free_region` →
+//! `mark_region(PROT_I)`, `sys/memory.c:932`).
+//!
+//! **Owners** are the block's EmuTOS tag `m_own` and its further owners
+//! ([`crate::bdos::mem::region`]). A process slot counts as owner when one of
+//! them is a process of its **memory space** — itself, or, for a `Pexec(4)`
+//! child, the space it shares ([`super::Process::space_pd`], FreeMiNT
+//! `FORK_SHAREVM`, plan E6) — so a thread and its caller see each other's
+//! blocks. In addition:
+//!
+//! * **E5, not strict (default):** a child started with `Pexec` 0/6 keeps
+//!   the rights to the blocks its parent's space owned when it started
+//!   (FreeMiNT forks the region list and, unless `MPF_STRICT`, does not
+//!   revoke it on exec: `sys/k_exec.c:799-806`). The boot argument
+//!   `memprot=strict` switches this off.
+//! * **E10:** while a user routine of another process runs in the current
+//!   one (a `G_USERDEF` callout of a foreign tree), the current space may
+//!   reach the owner's blocks ([`grant_temp`]) — FreeMiNT's `prot_temp`
+//!   (`mprot030.c:775-805`).
+//! * `Ptermres`: what only the resident program owned and was `PROT_P`
+//!   becomes `PROT_G` (`sys/k_exit.c:320-336`).
+//!
+//! ## Switch
+//!
+//! The boot argument `memprot=off` (FreeMiNT `MEM_PROT=NO`,
+//! `sys/bootmenu.c:207-219`) leaves everything as in stage 3a: the pools are
+//! mapped once for everybody, block sizes keep the 16-byte grain, no record
+//! is kept. With protection on (the default) the pool grain is one page
+//! (E16, FreeMiNT `QUANTUM`, `sys/mint/mem.h:152`), so no page has two
+//! owners (I10).
+//!
+//! ## Tables
+//!
+//! Changes are collected as **dirty ranges** ([`touch`]) and slots that need
+//! a full rebuild; [`sync`] brings the tables in line — the shared L3 tables
+//! get the non-owner rights, a slot whose rights differ in a 2-MiB region gets
+//! a private copy of that region's L3 ([`mmu::make_private`]), a slot whose
+//! rights no longer differ is pointed back at the shared table
+//! ([`mmu::drop_private`]). [`sync`] runs at the end of every mutating BDOS
+//! operation, before every root is installed ([`mmu::install_ttbr0`]) and at
+//! the end of every trap, and ends with the TLB maintenance the change needs
+//! ([`mmu::flush_tlb`]).
+//!
+//! ## Concurrency
+//!
+//! Everything here runs under the BDOS giant lock (single CPU, trap / boot
+//! context), like the pools and the tables.
+
+use core::cell::UnsafeCell;
+use core::ffi::c_void;
+use core::sync::atomic::{AtomicBool, AtomicU32, AtomicUsize, Ordering};
+
+use tos_types::{BasePage, Long, ProtMode};
+
+use super::mmu::{self, PageFlags, REGION_SPAN};
+use super::{MAX_PROCESSES, PROCESS_TABLE};
+use crate::bdos::mem::init::{is_initialised, pmd, pmdalt, stram_range, ttram_range};
+
+// ─── Switch ──────────────────────────────────────────────────────────
+
+static ENABLED: AtomicBool = AtomicBool::new(false);
+static STRICT: AtomicBool = AtomicBool::new(false);
+
+/// Is memory protection on? (`false` until [`configure`], and with the boot
+/// argument `memprot=off`.)
+#[inline]
+pub fn enabled() -> bool {
+    ENABLED.load(Ordering::Relaxed)
+}
+
+/// Is the parent-to-child rule strict (`memprot=strict`, E5)?
+#[inline]
+pub fn strict() -> bool {
+    STRICT.load(Ordering::Relaxed)
+}
+
+/// Set the switch from the boot arguments. Must run before the BDOS pools
+/// are seeded and mapped (the pool grain and the pool mapping depend on it).
+///
+/// # Safety
+///
+/// Boot CPU, before any pool allocation.
+pub unsafe fn configure(enable: bool, strict_mode: bool) {
+    ENABLED.store(enable, Ordering::Relaxed);
+    STRICT.store(strict_mode, Ordering::Relaxed);
+}
+
+/// The allocation grain of the BDOS pools as an `align_mask`: one page with
+/// protection on (E16), else the stage-3a 16 bytes.
+#[inline]
+pub fn pool_align_mask() -> Long {
+    if enabled() { mmu::PAGE_SIZE as Long - 1 } else { 15 }
+}
+
+// ─── Block records ───────────────────────────────────────────────────
+
+/// One record per allocated block: at most one per MD.
+const MAX_RECORDS: usize =
+    crate::bdos::mem::mdpool::MD_BLOCK_COUNT * crate::bdos::mem::mdpool::MDS_PER_BLOCK + 2;
+
+#[derive(Copy, Clone)]
+struct Rec {
+    /// Block start (`m_start`); `0` = unused.
+    loc: u64,
+    mode: ProtMode,
+    /// Slots that inherited access at their start (E5, not strict).
+    inherit: u32,
+}
+
+const NO_REC: Rec = Rec { loc: 0, mode: ProtMode::P, inherit: 0 };
+
+struct Records(UnsafeCell<[Rec; MAX_RECORDS]>);
+// SAFETY: BDOS giant lock (single CPU).
+unsafe impl Sync for Records {}
+static RECS: Records = Records(UnsafeCell::new([NO_REC; MAX_RECORDS]));
+
+/// # Safety
+///
+/// BDOS giant lock held; no other borrow of the records alive.
+unsafe fn recs() -> &'static mut [Rec; MAX_RECORDS] {
+    // SAFETY: caller contract.
+    unsafe { &mut *RECS.0.get() }
+}
+
+fn rec_of(r: &mut [Rec; MAX_RECORDS], loc: u64) -> Option<&mut Rec> {
+    if loc == 0 {
+        return None;
+    }
+    r.iter_mut().find(|e| e.loc == loc)
+}
+
+/// Record (or re-record) the mode of the block that starts at `loc`. A stale
+/// record of a freed block at the same address is replaced. `false` only if
+/// the table is full, which cannot happen while every record names a live
+/// block (one per MD).
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn record(loc: u64, mode: ProtMode) -> bool {
+    // SAFETY: lock held.
+    let r = unsafe { recs() };
+    if let Some(e) = rec_of(r, loc) {
+        *e = Rec { loc, mode, inherit: 0 };
+        return true;
+    }
+    match r.iter_mut().find(|e| e.loc == 0) {
+        Some(e) => {
+            *e = Rec { loc, mode, inherit: 0 };
+            true
+        }
+        None => false,
+    }
+}
+
+/// The protection mode of the block that starts at `loc` (`PROT_P` for a
+/// block without a record).
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn mode_of(loc: u64) -> ProtMode {
+    // SAFETY: lock held.
+    rec_of(unsafe { recs() }, loc).map_or(ProtMode::P, |e| e.mode)
+}
+
+/// The block that starts at `old` now starts at `new` (the aligned TPA
+/// allocation gives its front slack back).
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn rekey(old: u64, new: u64) {
+    if !enabled() || old == new {
+        return;
+    }
+    // SAFETY: lock held.
+    let r = unsafe { recs() };
+    if let Some(e) = rec_of(r, new) {
+        *e = NO_REC;
+    }
+    if let Some(e) = rec_of(r, old) {
+        e.loc = new;
+    }
+}
+
+/// A block was just allocated at `[loc, loc + len)` with `mode`: record it
+/// and enter its rights. Nothing with protection off.
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn on_alloc(loc: u64, len: u64, mode: ProtMode) {
+    if !enabled() {
+        return;
+    }
+    // SAFETY: lock held.
+    unsafe {
+        record(loc, mode);
+        touch(loc, loc + len);
+        sync();
+    }
+}
+
+/// The block that started at `loc` and spanned `len` bytes went back to the
+/// pool: forget it, and make its pages invalid for everybody (I8) before
+/// anybody can be handed them again.
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn on_freed(loc: u64, len: u64) {
+    if !enabled() {
+        return;
+    }
+    // SAFETY: lock held.
+    unsafe {
+        if let Some(e) = rec_of(recs(), loc) {
+            *e = NO_REC;
+        }
+        touch(loc, loc + len);
+        sync();
+    }
+}
+
+/// Change the mode of the block that starts at `loc` (`mark_region`).
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn set_mode(loc: u64, mode: ProtMode) {
+    if !enabled() {
+        return;
+    }
+    // SAFETY: lock held.
+    unsafe {
+        match rec_of(recs(), loc) {
+            Some(e) => e.mode = mode,
+            None => {
+                record(loc, mode);
+            }
+        }
+        touch_block(loc);
+        sync();
+    }
+}
+
+/// The owners of the block at `loc` changed (attach, detach, hand-over,
+/// `set_owner`): enter the new rights.
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn on_owner_change(loc: u64) {
+    if !enabled() {
+        return;
+    }
+    // SAFETY: lock held.
+    unsafe {
+        touch_block(loc);
+        sync();
+    }
+}
+
+/// `Ptermres`: the block at `loc` now belongs to the resident holder alone;
+/// if it was private it becomes global, so every process can call into and
+/// read the resident program (FreeMiNT `sys_ptermres`, `sys/k_exit.c:320-336`:
+/// `links == 1 && PROT_P → mark_region(PROT_G)`).
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn on_resident(loc: u64) {
+    if !enabled() {
+        return;
+    }
+    // SAFETY: lock held.
+    unsafe {
+        if mode_of(loc) == ProtMode::P {
+            set_mode(loc, ProtMode::G);
+        } else {
+            on_owner_change(loc);
+        }
+    }
+}
+
+// ─── Dirty tracking ──────────────────────────────────────────────────
+
+const MAX_DIRTY: usize = 8;
+
+struct Dirty(UnsafeCell<([(u64, u64); MAX_DIRTY], usize)>);
+// SAFETY: BDOS giant lock.
+unsafe impl Sync for Dirty {}
+static DIRTY: Dirty = Dirty(UnsafeCell::new(([(0, 0); MAX_DIRTY], 0)));
+
+/// Slots whose tables need a full rebuild at the next [`sync`].
+static REBUILD: AtomicU32 = AtomicU32::new(0);
+
+/// [`sync`] is running (it must not re-enter itself).
+static SYNCING: AtomicBool = AtomicBool::new(false);
+
+/// Times a private table could not be had (arena exhausted) — boot log.
+static NO_TABLE: AtomicUsize = AtomicUsize::new(0);
+
+/// Note that the rights of `[lo, hi)` may have changed.
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn touch(lo: u64, hi: u64) {
+    if !enabled() || hi <= lo {
+        return;
+    }
+    let lo = lo & !(mmu::PAGE_SIZE - 1);
+    let hi = (hi + mmu::PAGE_SIZE - 1) & !(mmu::PAGE_SIZE - 1);
+    // SAFETY: lock held.
+    let (ranges, n) = unsafe { &mut *DIRTY.0.get() };
+    for r in ranges[..*n].iter_mut() {
+        if lo <= r.1 && hi >= r.0 {
+            r.0 = r.0.min(lo);
+            r.1 = r.1.max(hi);
+            return;
+        }
+    }
+    if *n < MAX_DIRTY {
+        ranges[*n] = (lo, hi);
+        *n += 1;
+    } else {
+        // Too many: one bounding range.
+        let r = &mut ranges[MAX_DIRTY - 1];
+        r.0 = r.0.min(lo);
+        r.1 = r.1.max(hi);
+    }
+}
+
+/// [`touch`] the whole block that starts at (or contains) `loc`.
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn touch_block(loc: u64) {
+    // SAFETY: lock held.
+    if let Some((s, e)) = unsafe { block_containing(loc) } {
+        // SAFETY: lock held.
+        unsafe { touch(s, e) };
+    }
+}
+
+/// Rebuild `slot`'s tables completely at the next [`sync`] (a new root, a
+/// changed memory space, a granted or revoked temporary right).
+pub fn mark_rebuild(slot: usize) {
+    if enabled() && slot < MAX_PROCESSES {
+        REBUILD.fetch_or(1 << slot, Ordering::Relaxed);
+    }
+}
+
+/// Bring the page tables in line with the recorded rights (see the module
+/// docs) and do the TLB maintenance the changes need. Cheap when nothing is
+/// pending.
+///
+/// # Safety
+///
+/// BDOS giant lock held; EL1 (on the target).
+pub unsafe fn sync() {
+    if !enabled() || !is_initialised() {
+        return;
+    }
+    // SAFETY: lock held; read of the pending count only.
+    if unsafe { (*DIRTY.0.get()).1 } == 0 && REBUILD.load(Ordering::Relaxed) == 0 {
+        return; // nothing pending: no table write, no barrier (the trap fast path)
+    }
+    if SYNCING.swap(true, Ordering::Acquire) {
+        return;
+    }
+    // SAFETY: lock held.
+    let (ranges, n) = unsafe { &mut *DIRTY.0.get() };
+    let rebuild = REBUILD.swap(0, Ordering::Relaxed);
+    if rebuild != 0 {
+        for (s, e) in pools() {
+            // SAFETY: lock held.
+            unsafe { refresh(s, e, rebuild) };
+        }
+    }
+    while *n > 0 {
+        *n -= 1;
+        let (lo, hi) = ranges[*n];
+        // SAFETY: lock held.
+        unsafe { refresh(lo, hi, 0) };
+    }
+    // SAFETY: EL1, barriers + TLB maintenance only.
+    unsafe { mmu::flush_tlb() };
+    SYNCING.store(false, Ordering::Release);
+}
+
+// ─── Rights ──────────────────────────────────────────────────────────
+
+/// E10 grants: `TEMP[s]` = slots whose blocks slot `s` may reach for now.
+static TEMP: [AtomicU32; MAX_PROCESSES] = [const { AtomicU32::new(0) }; MAX_PROCESSES];
+
+/// Is `slot` a process with a root (its tables built)?
+fn live(slot: usize) -> bool {
+    PROCESS_TABLE[slot].l0_pa.load(Ordering::Acquire) != 0
+}
+
+/// The memory space of `slot`: its own PD, or the PD of the space it shares
+/// as a `Pexec(4)` child.
+fn space_root(slot: usize) -> u64 {
+    let sp = PROCESS_TABLE[slot].space_pd.load(Ordering::Acquire);
+    if sp.is_null() { super::pd_of(slot) as u64 } else { sp as u64 }
+}
+
+/// For every live slot, the set of slots in its memory space.
+fn group_masks() -> [u32; MAX_PROCESSES] {
+    let mut roots = [0u64; MAX_PROCESSES];
+    let mut alive = 0u32;
+    for (s, root) in roots.iter_mut().enumerate() {
+        if live(s) {
+            *root = space_root(s);
+            alive |= 1 << s;
+        }
+    }
+    let mut g = [0u32; MAX_PROCESSES];
+    for s in 0..MAX_PROCESSES {
+        if alive & (1 << s) == 0 || roots[s] == 0 {
+            continue;
+        }
+        for t in 0..MAX_PROCESSES {
+            if alive & (1 << t) != 0 && roots[t] == roots[s] {
+                g[s] |= 1 << t;
+            }
+        }
+    }
+    g
+}
+
+/// The live slot (one with a root) whose PD pointer is `pd`. Unlike
+/// [`super::slot_for`] it does not look at the slot's state: a root exists from the
+/// moment the loader built it (some kernel launch paths — the self-tests —
+/// run a slot they never claimed), and its rights must be there before its
+/// first instruction.
+fn live_slot_of(pd: *mut c_void) -> Option<usize> {
+    if pd.is_null() {
+        return None;
+    }
+    let kva = super::kalias(pd as u64) as *mut BasePage;
+    (0..MAX_PROCESSES).find(|&s| live(s) && PROCESS_TABLE[s].basepage_kva.load(Ordering::Acquire) == kva)
+}
+
+/// The slots behind the owner cookies of a block (`m_own` + further owners).
+fn owner_slots(own: *mut c_void, further: &[*mut c_void]) -> u32 {
+    let mut m = 0u32;
+    for &o in core::iter::once(&own).chain(further.iter()) {
+        if let Some(s) = live_slot_of(o) {
+            m |= 1 << s;
+        }
+    }
+    m
+}
+
+/// What an owner of a block in `mode` may do with its pages (table §3.3).
+fn owner_flags(mode: ProtMode) -> Option<PageFlags> {
+    match mode {
+        ProtMode::I => None,
+        _ => Some(PageFlags::UserRwExec),
+    }
+}
+
+/// What everybody else may do (table §3.3, FreeMiNT `other_dt/other_s/
+/// other_wp`, `mprot030.c:400-402`).
+fn other_flags(mode: ProtMode) -> Option<PageFlags> {
+    match mode {
+        ProtMode::G => Some(PageFlags::UserRwExec),
+        ProtMode::Pr => Some(PageFlags::UserRoExec),
+        ProtMode::P | ProtMode::S | ProtMode::I => None,
+    }
+}
+
+/// Does an owner see this mode differently from everybody else?
+fn owner_differs(mode: ProtMode) -> bool {
+    matches!(mode, ProtMode::P | ProtMode::S | ProtMode::Pr)
+}
+
+/// The pool ranges, as `[start, end)`.
+fn pools() -> impl Iterator<Item = (u64, u64)> {
+    [stram_range(), ttram_range()]
+        .into_iter()
+        .filter(|&(s, e)| e > s)
+        .map(|(s, e)| (s as u64, e as u64))
+}
+
+fn in_pool(va: u64) -> bool {
+    pools().any(|(s, e)| va >= s && va < e)
+}
+
+/// One allocated block overlapping the region being refreshed.
+#[derive(Copy, Clone)]
+struct Blk {
+    mode: ProtMode,
+    owners: u32,
+    inherit: u32,
+}
+
+const NO_BLK: Blk = Blk { mode: ProtMode::P, owners: 0, inherit: 0 };
+
+/// Page → block index + 1 in the region (`0` = free pool page,
+/// [`NOT_POOL`] = not pool memory — left alone).
+const NOT_POOL: u16 = u16::MAX;
+
+struct Scratch(UnsafeCell<([Blk; MAX_RECORDS], [u16; 512])>);
+// SAFETY: BDOS giant lock.
+unsafe impl Sync for Scratch {}
+static SCRATCH: Scratch = Scratch(UnsafeCell::new(([NO_BLK; MAX_RECORDS], [0; 512])));
+
+/// Does `slot` hold owner rights on `b`?
+fn has_rights(slot: usize, b: &Blk, groups: &[u32; MAX_PROCESSES]) -> bool {
+    b.owners & groups[slot] != 0
+        || b.inherit & (1 << slot) != 0
+        || b.owners & TEMP[slot].load(Ordering::Relaxed) != 0
+}
+
+/// The leaf descriptor of pool page `va` for `slot` (`None` = the shared,
+/// non-owner pattern).
+fn page_desc(va: u64, bi: u16, blks: &[Blk], slot: Option<(usize, &[u32; MAX_PROCESSES])>) -> u64 {
+    if bi == 0 {
+        return 0; // free pool memory: nobody's (I8)
+    }
+    let b = &blks[(bi - 1) as usize];
+    let flags = match slot {
+        Some((s, groups)) if has_rights(s, b, groups) => owner_flags(b.mode),
+        _ => other_flags(b.mode),
+    };
+    mmu::leaf_desc(va, flags)
+}
+
+/// Refresh the rights of the pool pages in `[lo, hi)` for the shared tables
+/// and every live slot; slots in `full` get their whole 2-MiB regions
+/// recomputed (a rebuild).
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+unsafe fn refresh(lo: u64, hi: u64, full: u32) {
+    let groups = group_masks();
+    // SAFETY: lock held; exclusive scratch.
+    let (blks, pageb) = unsafe { &mut *SCRATCH.0.get() };
+    let mut region = lo & !(REGION_SPAN - 1);
+    while region < hi {
+        let rend = region + REGION_SPAN;
+        // SAFETY: lock held.
+        let Some(shared) = (unsafe { mmu::shared_l3(region) }) else {
+            region = rend;
+            continue;
+        };
+        // The region's blocks, and which page belongs to which.
+        let mut nb = 0usize;
+        for (i, p) in pageb.iter_mut().enumerate() {
+            *p = if in_pool(region + (i as u64) * mmu::PAGE_SIZE) { 0 } else { NOT_POOL };
+        }
+        for mp in [pmd(), pmdalt()] {
+            // SAFETY: lock held; read-only list walk.
+            let mut m = unsafe { (*mp).mp_mal };
+            while !m.is_null() && nb < blks.len() {
+                // SAFETY: list invariant.
+                let (start, len, own, next) =
+                    unsafe { ((*m).m_start as u32 as u64, (*m).m_length as u32 as u64, (*m).m_own, (*m).m_link) };
+                let end = start + len;
+                if start < rend && end > region && len > 0 {
+                    // SAFETY: lock held.
+                    let further = unsafe { crate::bdos::mem::region::further_owners(start as Long) };
+                    // SAFETY: lock held.
+                    let (mode, inherit) = match rec_of(unsafe { recs() }, start) {
+                        Some(r) => (r.mode, r.inherit),
+                        None => (ProtMode::P, 0),
+                    };
+                    blks[nb] = Blk { mode, owners: owner_slots(own, &further), inherit };
+                    nb += 1;
+                    let a = start.max(region);
+                    let z = end.min(rend);
+                    let mut va = a & !(mmu::PAGE_SIZE - 1);
+                    while va < z {
+                        let i = ((va - region) / mmu::PAGE_SIZE) as usize;
+                        if pageb[i] != NOT_POOL {
+                            pageb[i] = nb as u16;
+                        }
+                        va += mmu::PAGE_SIZE;
+                    }
+                }
+                m = next;
+            }
+        }
+        let blks = &blks[..nb];
+        // The pages of this region inside the range.
+        let i_lo = ((lo.max(region) - region) / mmu::PAGE_SIZE) as usize;
+        let i_hi = ((hi.min(rend) - region).div_ceil(mmu::PAGE_SIZE)) as usize;
+        // Shared tables: the non-owner pattern.
+        for (i, &bi) in pageb.iter().enumerate().take(i_hi).skip(i_lo) {
+            if bi == NOT_POOL {
+                continue;
+            }
+            let va = region + (i as u64) * mmu::PAGE_SIZE;
+            // SAFETY: lock held; `shared` is a live table.
+            unsafe { mmu::set_leaf(shared, i, page_desc(va, bi, blks, None)) };
+        }
+        // Every live slot.
+        for s in 0..MAX_PROCESSES {
+            if !live(s) {
+                continue;
+            }
+            let needs = blks.iter().any(|b| owner_differs(b.mode) && has_rights(s, b, &groups));
+            if !needs {
+                // SAFETY: lock held.
+                unsafe { mmu::drop_private(s, region) };
+                continue;
+            }
+            // SAFETY: lock held.
+            let had = unsafe { mmu::slot_private_l3(s, region) }.is_some();
+            // SAFETY: lock held.
+            let p = match unsafe { mmu::make_private(s, region) } {
+                Ok(p) => p,
+                Err(_) => {
+                    // No table left: the slot keeps the shared (non-owner)
+                    // rights here — it can lose access, never gain it.
+                    NO_TABLE.fetch_add(1, Ordering::Relaxed);
+                    continue;
+                }
+            };
+            let (a, z) = if !had || full & (1 << s) != 0 { (0, 512) } else { (i_lo, i_hi) };
+            for (i, &bi) in pageb.iter().enumerate().take(z).skip(a) {
+                if bi == NOT_POOL {
+                    continue;
+                }
+                let va = region + (i as u64) * mmu::PAGE_SIZE;
+                // SAFETY: lock held; `p` is the slot's private table.
+                unsafe { mmu::set_leaf(p, i, page_desc(va, bi, blks, Some((s, &groups)))) };
+            }
+        }
+        region = rend;
+    }
+}
+
+/// Times a slot could not get a private table (the arena was exhausted).
+pub fn table_shortfalls() -> usize {
+    NO_TABLE.load(Ordering::Relaxed)
+}
+
+// ─── Process events ──────────────────────────────────────────────────
+
+/// A root was (re)built for `slot` ([`super::loader`]): enter its rights.
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn on_root_built(slot: usize) {
+    if !enabled() {
+        return;
+    }
+    mark_rebuild(slot);
+    // SAFETY: lock held.
+    unsafe { sync() };
+}
+
+/// `slot` starts running, launched by the process `parent` (`null`: by the
+/// kernel) — `Pexec` 0/4/6. A `Pexec(4)` child shares its caller's space
+/// (its rights follow from [`super::Process::space_pd`]); any other child
+/// of a process inherits the rights to the blocks its parent's space owns
+/// now, unless the mode is strict (E5, FreeMiNT `sys/k_exec.c:799-806`).
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn on_launch(slot: usize, parent: *mut BasePage) {
+    if !enabled() || slot >= MAX_PROCESSES {
+        return;
+    }
+    let thread = !PROCESS_TABLE[slot].space_pd.load(Ordering::Acquire).is_null();
+    if !thread && !strict() {
+        if let Some(ps) = live_slot_of(parent.cast()) {
+            let groups = group_masks();
+            let pg = groups[ps] | (1 << ps);
+            for mp in [pmd(), pmdalt()] {
+                // SAFETY: lock held; read-only list walk.
+                let mut m = unsafe { (*mp).mp_mal };
+                while !m.is_null() {
+                    // SAFETY: list invariant.
+                    let (start, own, next) = unsafe { ((*m).m_start as u32 as u64, (*m).m_own, (*m).m_link) };
+                    // SAFETY: lock held.
+                    let further = unsafe { crate::bdos::mem::region::further_owners(start as Long) };
+                    if owner_slots(own, &further) & pg != 0 {
+                        // SAFETY: lock held.
+                        let r = unsafe { recs() };
+                        if rec_of(r, start).is_none() {
+                            // SAFETY: lock held.
+                            unsafe { record(start, ProtMode::P) };
+                        }
+                        if let Some(e) = rec_of(r, start) {
+                            e.inherit |= 1 << slot;
+                        }
+                    }
+                    m = next;
+                }
+            }
+        }
+    }
+    mark_rebuild(slot);
+    // SAFETY: lock held.
+    unsafe { sync() };
+}
+
+/// `slot` is released: its private tables go back to the arena, its
+/// inherited and temporary rights are forgotten.
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn on_slot_released(slot: usize) {
+    if !enabled() || slot >= MAX_PROCESSES {
+        return;
+    }
+    // SAFETY: lock held.
+    for e in unsafe { recs() }.iter_mut() {
+        e.inherit &= !(1 << slot);
+    }
+    TEMP[slot].store(0, Ordering::Relaxed);
+    for t in &TEMP {
+        t.fetch_and(!(1 << slot), Ordering::Relaxed);
+    }
+    REBUILD.fetch_and(!(1 << slot), Ordering::Relaxed);
+    // SAFETY: lock held.
+    unsafe {
+        mmu::release_private_tables(slot);
+        // The released root may still be the installed one until the next
+        // switch: drop what the TLB holds of it.
+        mmu::flush_tlb_always();
+    }
+}
+
+/// E10: let `slot` reach the blocks of `owner`'s memory space while a user
+/// routine of `owner` runs in `slot` (a `G_USERDEF` callout of a foreign
+/// tree) — FreeMiNT `prot_temp(loc, len, -1)` (`mprot030.c:775-805`) for
+/// the owner's regions. Revoked by [`revoke_temp`].
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn grant_temp(slot: usize, owner: usize) {
+    if !enabled() || slot >= MAX_PROCESSES || owner >= MAX_PROCESSES {
+        return;
+    }
+    let g = group_masks()[owner] | (1 << owner);
+    TEMP[slot].fetch_or(g, Ordering::Relaxed);
+    mark_rebuild(slot);
+    // SAFETY: lock held.
+    unsafe { sync() };
+}
+
+/// End every temporary right of `slot` ([`grant_temp`]).
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn revoke_temp(slot: usize) {
+    if !enabled() || slot >= MAX_PROCESSES {
+        return;
+    }
+    if TEMP[slot].swap(0, Ordering::Relaxed) != 0 {
+        mark_rebuild(slot);
+        // SAFETY: lock held.
+        unsafe { sync() };
+    }
+}
+
+// ─── Lookups ─────────────────────────────────────────────────────────
+
+/// The allocated block `[start, end)` that contains `addr`, on either pool.
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn block_containing(addr: u64) -> Option<(u64, u64)> {
+    if !is_initialised() {
+        return None;
+    }
+    for mp in [pmd(), pmdalt()] {
+        // SAFETY: lock held; read-only list walk.
+        let mut m = unsafe { (*mp).mp_mal };
+        while !m.is_null() {
+            // SAFETY: list invariant.
+            let (start, len, next) =
+                unsafe { ((*m).m_start as u32 as u64, (*m).m_length as u32 as u64, (*m).m_link) };
+            if addr >= start && addr < start + len {
+                return Some((start, start + len));
+            }
+            m = next;
+        }
+    }
+    None
+}
+
+/// What a faulting address was, for the crash report — FreeMiNT
+/// `report_buserr` (`sys/arch/mprot.x:71-124`): the mode of the block it
+/// lies in ("private", "super", "readable"; a global block is a hardware
+/// error), "free" pool memory, or memory protection does not control
+/// ("hardware"). `None` with protection off (FreeMiNT reports nothing then,
+/// `mprot.x:96-97`).
+pub fn region_kind(far: u64) -> Option<crate::bios::crash::RegionKind> {
+    use crate::bios::crash::RegionKind;
+    if !enabled() {
+        return None;
+    }
+    if !in_pool(far) {
+        return Some(RegionKind::Hardware);
+    }
+    // SAFETY: the crash path runs in the trap of the faulting program, under
+    // the BDOS lock; read-only walks.
+    unsafe {
+        match block_containing(far) {
+            None => Some(RegionKind::Free),
+            Some((start, _)) => Some(match mode_of(start) {
+                ProtMode::P => RegionKind::Private,
+                ProtMode::G => RegionKind::Hardware,
+                ProtMode::S => RegionKind::Super,
+                ProtMode::Pr => RegionKind::Readable,
+                ProtMode::I => RegionKind::Free,
+            }),
+        }
+    }
+}
diff --git a/tos-api/tests/arch03_3b_fsetdta.rs b/tos-api/tests/arch03_3b_fsetdta.rs
new file mode 100644
index 0000000..058a129
--- /dev/null
+++ b/tos-api/tests/arch03_3b_fsetdta.rs
@@ -0,0 +1,46 @@
+//! ARCH03 stage 3b — `Fsetdta` from a kernel (EL1) caller while a process is
+//! running must not cut the kernel address to 32 bits into that process's
+//! `p_xdta` (3a observation). EmuTOS `xsetdta` stores into `run->p_xdta`
+//! (`bdos/fsmain.c:403-405`) — every EmuTOS caller is a process; NewTOS's
+//! kernel callers (the in-kernel desktop, the built-in shell) keep their own
+//! DTA cell (`bdos::fs::find`, `KERNEL_DTA`).
+
+use tos_api::bdos::fs::find;
+use tos_api::bdos::process;
+use tos_api::trap::TrapArgs;
+use tos_api::uaccess::Space;
+use tos_types::{BasePage, Long};
+
+fn args(space: Space, a0: u64) -> TrapArgs {
+    TrapArgs { regs: [a0, 0, 0, 0, 0, 0, 0, 0], func: 0x1A, svc_imm: 1, space }
+}
+
+#[test]
+fn a_kernel_dta_never_lands_in_the_running_processs_basepage() {
+    // A running process with its own DTA.
+    let slot = process::allocate_slot().expect("a slot");
+    let mut b = Box::new([0u8; 256]);
+    let user_dta: u32 = 0x0123_4080;
+    b[0x20..0x24].copy_from_slice(&user_dta.to_le_bytes()); // p_xdta
+    let bp = Box::into_raw(b) as *mut BasePage;
+    process::PROCESS_TABLE[slot].basepage_kva.store(bp, std::sync::atomic::Ordering::Release);
+    process::set_current(process::pd_of(slot));
+
+    // A kernel caller sets a high-half kernel DTA.
+    let kdta: u64 = 0xFFFF_0000_0012_3440;
+    assert_eq!(find::fsetdta(&args(Space::Kernel, kdta)), 0);
+    // SAFETY: `bp` is the live test basepage.
+    assert_eq!(unsafe { (*bp).p_xdta } as u32, user_dta, "the program's DTA is untouched");
+    assert_eq!(find::fgetdta(&args(Space::User, 0)) as u32, user_dta, "the program reads its own");
+    assert_eq!(find::fgetdta(&args(Space::Kernel, 0)), kdta as Long, "the kernel caller its own");
+
+    // The program's own Fsetdta still goes to its basepage.
+    assert_eq!(find::fsetdta(&args(Space::User, 0x0123_5000)), 0);
+    // SAFETY: as above.
+    assert_eq!(unsafe { (*bp).p_xdta } as u32, 0x0123_5000);
+
+    process::set_current(std::ptr::null_mut());
+    process::free_slot(slot);
+    // SAFETY: allocated by `Box::new` above.
+    drop(unsafe { Box::from_raw(bp as *mut [u8; 256]) });
+}
diff --git a/tos-api/tests/arch03_3b_memprot.rs b/tos-api/tests/arch03_3b_memprot.rs
new file mode 100644
index 0000000..508ee61
--- /dev/null
+++ b/tos-api/tests/arch03_3b_memprot.rs
@@ -0,0 +1,389 @@
+//! ARCH03 stage 3b — **rights per address space** (FreeMiNT `PROT_P/G/S/PR/I`,
+//! plan `docs/analysis/arch03-implementation-plan.md` §3.2–§3.4, invariants
+//! I7–I10, decisions E5, E6, E10, E15, E16).
+//!
+//! Checked on the host, against the real pool, ownership table and page
+//! tables, with memory protection switched on for this test binary:
+//!
+//! * the rights matrix (table §3.3): owner / non-owner descriptor bits for
+//!   every mode, free memory invalid for everybody (I8 — MEM04);
+//! * table sharing: a process whose rights equal everybody else's in a
+//!   2-MiB region uses the shared L3; one whose rights differ gets its own
+//!   copy, which goes away when the difference does (copy-on-differ);
+//! * ownership transitions: `Pexec(4)` thread shares its caller's space
+//!   (E6), a `Pexec(0)` child inherits its parent's blocks unless strict
+//!   (E5), attach/detach of a further owner, `Ptermres` turns sole-owner
+//!   private memory global, temporary rights (E10), slot release;
+//! * the page grain (E16) and the crash-report classification.
+//!
+//! The pool is bookkeeping only (its addresses are never dereferenced); the
+//! basepages are host memory; the table arena is a leaked, page-aligned host
+//! buffer. One binary, one pool, one lock.
+
+use std::sync::atomic::Ordering;
+use std::sync::{Mutex, MutexGuard, Once};
+
+use tos_api::bdos::mem::{region, traps};
+use tos_api::bdos::process::mmu::{self, PageFlags};
+use tos_api::bdos::process::{self, memprot, PROCESS_TABLE};
+use tos_api::bios::crash::RegionKind;
+use tos_types::{BasePage, Long, ProtMode, MX_STRAM, MX_TTRAM};
+
+const ST_START: u64 = 0x0040_0000;
+const ST_LEN: u64 = 10 * 1024 * 1024;
+const TT_START: u64 = 0x0100_0000;
+const TT_LEN: u64 = 64 * 1024 * 1024;
+const ARENA_TABLES: usize = 512;
+
+static LOCK: Mutex<()> = Mutex::new(());
+static SETUP: Once = Once::new();
+
+#[repr(C, align(4096))]
+struct Page([u8; 4096]);
+
+fn lock() -> MutexGuard<'static, ()> {
+    let g = LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    SETUP.call_once(|| {
+        let arena: Vec<Page> = (0..ARENA_TABLES).map(|_| Page([0; 4096])).collect();
+        let arena = Box::leak(arena.into_boxed_slice());
+        // SAFETY: once per binary, before the pools exist.
+        unsafe {
+            memprot::configure(true, false);
+            mmu::set_table_arena(arena.as_mut_ptr() as u64, ARENA_TABLES);
+            tos_api::bdos::mem::init::init(ST_START, ST_LEN, TT_START, TT_LEN).expect("pools");
+            mmu::map_pools().expect("the pools map");
+        }
+    });
+    g
+}
+
+/// A process the host can "run": a basepage of its own (host memory) in a
+/// claimed slot with a root.
+struct Proc {
+    slot: usize,
+    bp: *mut BasePage,
+}
+
+impl Proc {
+    fn new() -> Proc {
+        let slot = process::allocate_slot().expect("a slot");
+        let b = Box::new([0u8; 256]);
+        let bp = Box::into_raw(b) as *mut BasePage;
+        let p = &PROCESS_TABLE[slot];
+        p.basepage_kva.store(bp, Ordering::Release);
+        // SAFETY: under the lock; the slot is not an installed root.
+        unsafe { mmu::init_slot_tables(slot) }.unwrap();
+        p.l0_pa.store(mmu::l0_pa_for(slot), Ordering::Release);
+        p.set_state(process::State::Running);
+        // SAFETY: under the lock.
+        unsafe { memprot::on_root_built(slot) };
+        Proc { slot, bp }
+    }
+
+    fn pd(&self) -> *mut core::ffi::c_void {
+        process::pd_of(self.slot).cast()
+    }
+
+    /// Allocate as this process (it is `RUN` for the call).
+    fn alloc(&self, n: Long, mode: i16) -> u64 {
+        process::set_current(process::pd_of(self.slot));
+        // SAFETY: under the lock.
+        let a = unsafe { traps::mxalloc(n, mode) };
+        process::set_current(std::ptr::null_mut());
+        assert_ne!(a, 0, "allocation");
+        a as u32 as u64
+    }
+}
+
+impl Drop for Proc {
+    fn drop(&mut self) {
+        // SAFETY: under the lock.
+        unsafe { tos_api::bdos::mem::free_all_owned::free_all_owned(self.pd()) };
+        process::free_slot(self.slot);
+        // SAFETY: allocated by `Box::new` in `new`.
+        drop(unsafe { Box::from_raw(self.bp as *mut [u8; 256]) });
+    }
+}
+
+/// What `slot` may do at `va`: `None` = invalid, else the leaf's AP bits
+/// (`0b01` RW, `0b11` RO).
+fn access(slot: usize, va: u64) -> Option<u64> {
+    mmu::translate(slot, va).map(|(pa, d)| {
+        assert_eq!(pa, va, "VA = PA");
+        (d >> 6) & 0b11
+    })
+}
+
+const RW: Option<u64> = Some(0b01);
+const RO: Option<u64> = Some(0b11);
+
+#[test]
+fn rights_matrix_owner_and_others_for_every_mode() {
+    let _g = lock();
+    let a = Proc::new();
+    let b = Proc::new();
+    // Mxalloc mode nibble = PROT value + 1 (FreeMiNT `sys/dosmem.c:209-221`).
+    for (nibble, mode, owner, other) in [
+        (0x10, ProtMode::P, RW, None),
+        (0x20, ProtMode::G, RW, RW),
+        (0x30, ProtMode::S, RW, None),
+        (0x40, ProtMode::Pr, RW, RO),
+        (0x50, ProtMode::I, None, None),
+    ] {
+        let blk = a.alloc(0x2000, MX_TTRAM | nibble);
+        // SAFETY: under the lock.
+        assert_eq!(unsafe { memprot::mode_of(blk) }, mode);
+        for va in [blk, blk + 0x1FFF] {
+            assert_eq!(access(a.slot, va), owner, "owner, {mode:?}");
+            assert_eq!(access(b.slot, va), other, "other, {mode:?}");
+        }
+        // PXN on everything; owners may execute (UXN clear) as in stage 1.
+        if let Some((_, d)) = mmu::translate(a.slot, blk) {
+            assert_ne!(d & (1 << 53), 0, "PXN");
+            assert_eq!(d & (1 << 54), 0, "UXN clear");
+        }
+        // SAFETY: under the lock.
+        assert_eq!(unsafe { traps::mfree(blk as Long) }, 0);
+    }
+}
+
+#[test]
+fn malloc_takes_the_prgflags_mode_and_free_memory_is_nobodys() {
+    let _g = lock();
+    let a = Proc::new();
+    let b = Proc::new();
+    // PRGFLAGS nibble 0 = PROT_P (PF_STANDARD).
+    let blk = a.alloc(100, MX_STRAM);
+    assert_eq!(access(a.slot, blk), RW);
+    assert_eq!(access(b.slot, blk), None);
+    // MEM04 / I8: after Mfree the former owner can no longer touch it.
+    // SAFETY: under the lock.
+    assert_eq!(unsafe { traps::mfree(blk as Long) }, 0);
+    assert_eq!(access(a.slot, blk), None, "freed memory is invalid for its former owner");
+    assert_eq!(access(b.slot, blk), None);
+    // The same pages handed to b: b only.
+    let again = b.alloc(100, MX_STRAM);
+    assert_eq!(again, blk, "first fit reuses the pages");
+    assert_eq!(access(b.slot, again), RW);
+    assert_eq!(access(a.slot, again), None);
+}
+
+#[test]
+fn page_grain_with_protection_on() {
+    let _g = lock();
+    let a = Proc::new();
+    let x = a.alloc(10, MX_TTRAM);
+    let y = a.alloc(10, MX_TTRAM);
+    assert_eq!(x % 4096, 0);
+    assert_eq!(y % 4096, 0);
+    assert!(y.abs_diff(x) >= 4096, "no page has two blocks (I10)");
+    // Mshrink keeps a page grain too: shrinking 3 pages to 1 byte keeps one
+    // page and frees the rest, which becomes invalid again.
+    let z = a.alloc(3 * 4096, MX_TTRAM);
+    process::set_current(process::pd_of(a.slot));
+    // SAFETY: under the lock.
+    assert_eq!(unsafe { traps::mshrink(0, z as Long, 1) }, 0);
+    process::set_current(std::ptr::null_mut());
+    assert_eq!(access(a.slot, z), RW);
+    assert_eq!(access(a.slot, z + 4096), None, "the shrunk tail is nobody's");
+}
+
+#[test]
+fn equal_rights_share_the_table_and_different_rights_copy_it() {
+    let _g = lock();
+    let a = Proc::new();
+    let b = Proc::new();
+    let region = |va: u64| va & !(mmu::REGION_SPAN - 1);
+    // A global block: everybody sees the same → nobody needs a copy.
+    let g = a.alloc(0x1000, MX_TTRAM | 0x20);
+    // SAFETY: under the lock.
+    unsafe {
+        assert!(mmu::slot_private_l3(a.slot, region(g)).is_none());
+        assert!(mmu::slot_private_l3(b.slot, region(g)).is_none());
+    }
+    // A private block in the same region: its owner gets a copy, b does not.
+    let p = a.alloc(0x1000, MX_TTRAM);
+    assert_eq!(region(p), region(g));
+    // SAFETY: under the lock.
+    unsafe {
+        assert!(mmu::slot_private_l3(a.slot, region(p)).is_some());
+        assert!(mmu::slot_private_l3(b.slot, region(p)).is_none());
+    }
+    let used = mmu::private_l3_used();
+    // Freed: the difference is gone, so is the copy.
+    // SAFETY: under the lock.
+    unsafe {
+        assert_eq!(traps::mfree(p as Long), 0);
+        assert!(mmu::slot_private_l3(a.slot, region(p)).is_none());
+    }
+    assert_eq!(mmu::private_l3_used(), used - 1);
+    // SAFETY: under the lock.
+    unsafe { assert_eq!(traps::mfree(g as Long), 0) };
+}
+
+#[test]
+fn a_pexec4_thread_shares_its_callers_space() {
+    let _g = lock();
+    let parent = Proc::new();
+    let child = Proc::new();
+    let mine = parent.alloc(0x1000, MX_TTRAM);
+    assert_eq!(access(child.slot, mine), None);
+    // `Pexec(4)`: the child runs in its caller's memory space (E6).
+    PROCESS_TABLE[child.slot].space_pd.store(parent.pd().cast(), Ordering::Release);
+    // SAFETY: under the lock.
+    unsafe { memprot::on_launch(child.slot, parent.pd().cast()) };
+    assert_eq!(access(child.slot, mine), RW, "the thread sees its caller's memory");
+    // And the caller sees what the thread allocates (LDG).
+    let theirs = child.alloc(0x1000, MX_TTRAM);
+    assert_eq!(access(parent.slot, theirs), RW);
+    PROCESS_TABLE[child.slot].space_pd.store(std::ptr::null_mut(), Ordering::Release);
+}
+
+#[test]
+fn a_child_inherits_its_parents_blocks_unless_strict() {
+    let _g = lock();
+    let parent = Proc::new();
+    let before = parent.alloc(0x1000, MX_TTRAM);
+    let child = Proc::new();
+    // SAFETY: under the lock.
+    unsafe { memprot::on_launch(child.slot, parent.pd().cast()) };
+    assert_eq!(access(child.slot, before), RW, "E5: what the parent had at the start");
+    let after = parent.alloc(0x1000, MX_TTRAM);
+    assert_eq!(access(child.slot, after), None, "not what it allocates later");
+    // Strict mode: nothing is inherited.
+    // SAFETY: under the lock; restored below.
+    unsafe { memprot::configure(true, true) };
+    let strict_child = Proc::new();
+    // SAFETY: under the lock.
+    unsafe { memprot::on_launch(strict_child.slot, parent.pd().cast()) };
+    assert_eq!(access(strict_child.slot, before), None, "E5 strict");
+    // SAFETY: as above.
+    unsafe { memprot::configure(true, false) };
+    // The inherited right ends with the block.
+    // SAFETY: under the lock.
+    unsafe { assert_eq!(traps::mfree(before as Long), 0) };
+    assert_eq!(access(child.slot, before), None);
+}
+
+#[test]
+fn further_owners_get_and_lose_rights() {
+    let _g = lock();
+    let a = Proc::new();
+    let b = Proc::new();
+    let blk = a.alloc(0x1000, MX_TTRAM);
+    // SAFETY: under the lock.
+    unsafe { region::attach(blk as Long, b.pd()) }.unwrap();
+    assert_eq!(access(b.slot, blk), RW, "attached: an owner");
+    // SAFETY: under the lock.
+    assert_eq!(unsafe { region::detach(blk as Long, b.pd()) }, Ok(region::Detached::Kept));
+    assert_eq!(access(b.slot, blk), None, "detached: not any more");
+    assert_eq!(access(a.slot, blk), RW);
+    // `Pexec(6)` hand-over: b becomes the owner, a stops being one.
+    // SAFETY: under the lock.
+    unsafe { region::hand_over(blk as Long, a.pd(), b.pd()) }.unwrap();
+    assert_eq!(access(b.slot, blk), RW);
+    assert_eq!(access(a.slot, blk), None);
+}
+
+#[test]
+fn resident_private_memory_becomes_global() {
+    let _g = lock();
+    let tsr = Proc::new();
+    let other = Proc::new();
+    let code = tsr.alloc(0x1000, MX_TTRAM);
+    let ro = tsr.alloc(0x1000, MX_TTRAM | 0x40);
+    // SAFETY: under the lock.
+    unsafe { tos_api::bdos::mem::free_all_owned::reserve_all_owned(tsr.pd()) };
+    // FreeMiNT `sys_ptermres`: sole-owner PROT_P → PROT_G; PROT_PR stays.
+    // SAFETY: under the lock.
+    unsafe {
+        assert_eq!(memprot::mode_of(code), ProtMode::G);
+        assert_eq!(memprot::mode_of(ro), ProtMode::Pr);
+    }
+    assert_eq!(access(other.slot, code), RW, "resident code is callable by everybody");
+    assert_eq!(access(other.slot, ro), RO);
+    // SAFETY: under the lock.
+    unsafe {
+        assert_eq!(traps::mfree(code as Long), 0);
+        assert_eq!(traps::mfree(ro as Long), 0);
+    }
+}
+
+#[test]
+fn temporary_rights_for_a_foreign_callout() {
+    let _g = lock();
+    let owner = Proc::new();
+    let host = Proc::new();
+    let tree = owner.alloc(0x1000, MX_TTRAM);
+    assert_eq!(access(host.slot, tree), None);
+    // SAFETY: under the lock.
+    unsafe { memprot::grant_temp(host.slot, owner.slot) };
+    assert_eq!(access(host.slot, tree), RW, "E10: during the callout");
+    // SAFETY: under the lock.
+    unsafe { memprot::revoke_temp(host.slot) };
+    assert_eq!(access(host.slot, tree), None, "and not after it");
+}
+
+#[test]
+fn a_released_slot_gives_its_tables_back() {
+    let _g = lock();
+    let free_before = mmu::arena_free_count();
+    let a = Proc::new();
+    let _x = a.alloc(0x1000, MX_TTRAM);
+    let _y = a.alloc(0x1000, MX_STRAM);
+    assert!(mmu::arena_free_count() < free_before);
+    drop(a);
+    assert_eq!(mmu::arena_free_count(), free_before, "every private table back");
+}
+
+#[test]
+fn the_kernel_allocates_supervisor_memory() {
+    let _g = lock();
+    let a = Proc::new();
+    process::set_current(std::ptr::null_mut());
+    // SAFETY: under the lock; no running process = a kernel caller.
+    let k = unsafe { traps::mxalloc(0x1000, MX_TTRAM) } as u32 as u64;
+    assert_ne!(k, 0);
+    // SAFETY: under the lock.
+    assert_eq!(unsafe { memprot::mode_of(k) }, ProtMode::S);
+    assert_eq!(access(a.slot, k), None, "PROT_S: invalid for programs");
+    // SAFETY: under the lock.
+    unsafe { assert_eq!(traps::mfree(k as Long), 0) };
+}
+
+#[test]
+fn crash_classification_names_what_was_hit() {
+    let _g = lock();
+    let a = Proc::new();
+    let p = a.alloc(0x1000, MX_TTRAM);
+    let s = a.alloc(0x1000, MX_TTRAM | 0x30);
+    let r = a.alloc(0x1000, MX_TTRAM | 0x40);
+    let g = a.alloc(0x1000, MX_TTRAM | 0x20);
+    assert_eq!(memprot::region_kind(p + 8), Some(RegionKind::Private));
+    assert_eq!(memprot::region_kind(s), Some(RegionKind::Super));
+    assert_eq!(memprot::region_kind(r), Some(RegionKind::Readable));
+    assert_eq!(memprot::region_kind(g), Some(RegionKind::Hardware), "global: not a protection fault");
+    assert_eq!(memprot::region_kind(0xDEAD_0000), Some(RegionKind::Hardware), "outside the pools");
+    // SAFETY: under the lock.
+    unsafe { assert_eq!(traps::mfree(p as Long), 0) };
+    assert_eq!(memprot::region_kind(p), Some(RegionKind::Free));
+}
+
+#[test]
+fn publications_reach_private_copies() {
+    let _g = lock();
+    let a = Proc::new();
+    // A private block at the very end of the TT pool's last region forces a
+    // private copy of a region that also holds non-pool pages above it.
+    let blk = a.alloc(0x1000, MX_TTRAM);
+    let region = blk & !(mmu::REGION_SPAN - 1);
+    // SAFETY: under the lock.
+    assert!(unsafe { mmu::slot_private_l3(a.slot, region) }.is_some());
+    // Publish a kernel page below the pools into a region nobody has a copy
+    // of, and check the owner still sees its block and the publication.
+    let low = 0x0009_3000u64;
+    // SAFETY: under the lock; nothing is dereferenced.
+    unsafe { mmu::map_shared(low, 0x1000, PageFlags::UserRoNx, false) }.unwrap();
+    assert_eq!(access(a.slot, low), RO);
+    assert_eq!(access(a.slot, blk), RW);
+}
diff --git a/sdk/examples/mpkid.c b/sdk/examples/mpkid.c
new file mode 100644
index 0000000..bc3b1d4
--- /dev/null
+++ b/sdk/examples/mpkid.c
@@ -0,0 +1,87 @@
+/*
+ * mpkid.c -- the child of the ARCH03 stage-3b memory-protection probe
+ * (driver: mprot3b.c). The command tail is "<case> <8 hex digits>": the
+ * case selects what the child does with the address (a block of its
+ * parent's, allocated with a given protection mode):
+ *
+ *   p  read the parent's PROT_P block      P  write it
+ *   g  read + write the parent's PROT_G block
+ *   r  read the parent's PROT_PR block     R  write it
+ *   t  read + write the parent's PROT_P block (started as a Pexec 4 thread)
+ *   f  MEM04: Malloc a page, write, Mfree it, write it again
+ *   .  nothing
+ *
+ * Exit code: 0 = the access went through and read the parent's pattern,
+ * 2 = it read something else. A refused access does not come back: the
+ * EmuTOS crash report, a key, Pterm(-1) -- the parent sees 0x0000FFFF.
+ *
+ * Build: sdk/build.sh sdk/examples/mpkid.c <out>/MPKID.NAP
+ */
+#include <newtos.h>
+
+#define P_CMDLIN 0x80
+#define PATTERN 0x50415254UL /* "PART" */
+#define MARK 0x4B494431UL    /* "KID1" */
+
+typedef unsigned long UL;
+
+static const unsigned char *own_basepage(void)
+{
+    UL sysbase = *(volatile unsigned int *)0x4F2UL;
+    UL run_cell = *(volatile unsigned int *)(sysbase + 0x28);
+    return (const unsigned char *)(UL)*(volatile unsigned int *)run_cell;
+}
+
+static UL hex8(const unsigned char *s)
+{
+    UL v = 0;
+    int i;
+    for (i = 0; i < 8; i++) {
+        unsigned char c = s[i];
+        v <<= 4;
+        if (c >= '0' && c <= '9') v |= (UL)(c - '0');
+        else if (c >= 'a' && c <= 'f') v |= (UL)(c - 'a' + 10);
+        else if (c >= 'A' && c <= 'F') v |= (UL)(c - 'A' + 10);
+    }
+    return v;
+}
+
+int main(void)
+{
+    const unsigned char *tail = own_basepage() + P_CMDLIN;
+    char c = (char)tail[1];
+    volatile unsigned int *a = (volatile unsigned int *)hex8(tail + 3);
+    UL v;
+
+    switch (c) {
+    case 'p':
+    case 'r':
+        v = *a;
+        Cconws("MPKID: read done\r\n");
+        Pterm(v == PATTERN ? 0 : 2);
+    case 'P':
+    case 'R':
+        *a = (unsigned int)MARK;
+        Cconws("MPKID: write done\r\n");
+        Pterm(0);
+    case 'g':
+    case 't':
+        v = *a;
+        *a = (unsigned int)MARK;
+        Cconws("MPKID: read+write done\r\n");
+        Pterm(v == PATTERN ? 0 : 2);
+    case 'f': {
+        volatile unsigned int *m = (volatile unsigned int *)gemdos1(0x48, 4096); /* Malloc */
+        if (!m)
+            Pterm(3);
+        *m = (unsigned int)MARK;
+        gemdos1(0x49, (NLONG)m); /* Mfree */
+        Cconws("MPKID: freed, writing again\r\n");
+        *m = (unsigned int)MARK;
+        Cconws("MPKID: write after Mfree went through\r\n");
+        Pterm(0);
+    }
+    default:
+        Pterm(0);
+    }
+}
diff --git a/sdk/examples/mprot3b.c b/sdk/examples/mprot3b.c
new file mode 100644
index 0000000..a7cd246
--- /dev/null
+++ b/sdk/examples/mprot3b.c
@@ -0,0 +1,180 @@
+/*
+ * mprot3b.c -- driver of the ARCH03 stage-3b memory-protection probe.
+ *
+ * Allocates three blocks of its own -- PROT_P (Malloc, PRGFLAGS default),
+ * PROT_G (Mxalloc mode 0x20|3) and PROT_PR (Mxalloc mode 0x40|3) -- fills
+ * them with a pattern and starts C:\MPKID.NAP once per case with the
+ * address in the command tail (mpkid.c). It checks the child's exit code
+ * (0x0000FFFF = the child was stopped by a protection fault: EmuTOS crash
+ * report + Pterm(-1)) and, for the write cases, whether the child's write
+ * reached its memory. Afterwards it checks its own blocks once more: a
+ * refused child leaves them untouched and this process unharmed.
+ *
+ * The expected answers depend on the boot argument (FreeMiNT's
+ * MEM_PROT / MPF_STRICT), chosen at build time with -DMPROT_MODE:
+ *   0  protection on, default (E5: a Pexec 0 child keeps its parent's
+ *      blocks) -- MPROT3B.NAP
+ *   1  protection on, `memprot=strict` -- MPROTS.NAP
+ *   2  `memprot=off` (stage 3a: no protection at all) -- MPROTO.NAP
+ * In every mode: PROT_G works across processes, PROT_PR is readable, a
+ * Pexec 4 thread shares its caller's memory (E6); with protection on a
+ * block given back with Mfree can no longer be written by its former
+ * owner (MEM04).
+ *
+ * Prints one line per case and "MPROT3B: PASS"/"MPROT3B: FAIL".
+ *
+ * Build: sdk/build.sh -DMPROT_MODE=n sdk/examples/mprot3b.c <out>
+ */
+#include <newtos.h>
+
+#ifndef MPROT_MODE
+#define MPROT_MODE 0
+#endif
+#define STRICT (MPROT_MODE == 1)
+#define OFF (MPROT_MODE == 2)
+
+#define PATTERN 0x50415254UL
+#define MARK 0x4B494431UL
+#define CRASH 0xFFFFUL
+
+typedef unsigned long UL;
+
+static NLONG Pexec(short mode, const char *path, const char *tail, const char *env)
+{
+    register NLONG x8 __asm__("x8") = 0x4B;
+    register NLONG r0 __asm__("x0") = mode;
+    register NLONG r1 __asm__("x1") = (NLONG)path;
+    register NLONG r2 __asm__("x2") = (NLONG)tail;
+    register NLONG r3 __asm__("x3") = (NLONG)env;
+    __asm__ volatile("svc #1" : "+r"(r0) : "r"(x8), "r"(r1), "r"(r2), "r"(r3) : "memory");
+    return r0;
+}
+
+static __attribute__((noinline)) void put_hex(UL v)
+{
+    volatile char buf[11];
+    int i;
+    buf[0] = '0';
+    buf[1] = 'x';
+    for (i = 0; i < 8; i++) {
+        unsigned d = (unsigned)(v >> (28 - 4 * i)) & 0xF;
+        buf[2 + i] = (char)(d < 10 ? '0' + d : 'A' + d - 10);
+    }
+    buf[10] = '\0';
+    Cconws((const char *)buf);
+}
+
+static int fails;
+
+static void verdict(char c, const char *what, UL got, UL want)
+{
+    char line[] = "MPROT3B: case ? ";
+    line[14] = c;
+    Cconws(line);
+    Cconws(what);
+    Cconws(" got=");
+    put_hex(got);
+    Cconws(" want=");
+    put_hex(want);
+    if (got == want) {
+        Cconws(" OK\r\n");
+    } else {
+        Cconws(" WRONG\r\n");
+        fails++;
+    }
+}
+
+static void make_tail(char *tail, char c, UL addr)
+{
+    static const char hex[] = "0123456789abcdef";
+    int i;
+    tail[0] = 10;
+    tail[1] = c;
+    tail[2] = ' ';
+    for (i = 0; i < 8; i++)
+        tail[3 + i] = hex[(addr >> ((7 - i) * 4)) & 0xF];
+    tail[11] = '\0';
+}
+
+static UL run_kid(char c, UL addr)
+{
+    char tail[12];
+    make_tail(tail, c, addr);
+    return (UL)Pexec(0, "C:\\MPKID.NAP", tail, 0);
+}
+
+int main(void)
+{
+    volatile unsigned int *priv = (volatile unsigned int *)gemdos1(0x48, 4096);          /* Malloc */
+    volatile unsigned int *glob = (volatile unsigned int *)gemdos2(0x44, 4096, 0x20 | 3); /* Mxalloc PROT_G */
+    volatile unsigned int *rdon = (volatile unsigned int *)gemdos2(0x44, 4096, 0x40 | 3); /* Mxalloc PROT_PR */
+    char tail[12];
+    UL rc, pd;
+
+    Cconws(OFF ? "MPROT3B: start (expecting memprot=off)\r\n"
+               : STRICT ? "MPROT3B: start (expecting memprot=strict)\r\n"
+                        : "MPROT3B: start (expecting protection on, default)\r\n");
+    if (!priv || !glob || !rdon) {
+        Cconws("MPROT3B: FAIL (allocation)\r\n");
+        return 1;
+    }
+    *priv = PATTERN;
+    *glob = PATTERN;
+    *rdon = PATTERN;
+
+    /* A child reads / writes our private block: E5 (default) lets it, the
+       strict mode stops it (translation fault, "private"). */
+    rc = run_kid('p', (UL)priv);
+    verdict('p', "child reads parent PROT_P", rc, STRICT ? CRASH : 0);
+    rc = run_kid('P', (UL)priv);
+    verdict('P', "child writes parent PROT_P", rc, STRICT ? CRASH : 0);
+    verdict('P', "  parent block afterwards", *priv, STRICT ? PATTERN : MARK);
+    *priv = PATTERN;
+
+    /* PROT_G: everybody, every mode. */
+    rc = run_kid('g', (UL)glob);
+    verdict('g', "child reads+writes parent PROT_G", rc, 0);
+    verdict('g', "  parent block afterwards", *glob, MARK);
+    *glob = PATTERN;
+
+    /* PROT_PR: readable by everybody; writable by an owner only (the
+       default child inherited owner rights, E5) -- strict: permission fault. */
+    rc = run_kid('r', (UL)rdon);
+    verdict('r', "child reads parent PROT_PR", rc, 0);
+    rc = run_kid('R', (UL)rdon);
+    verdict('R', "child writes parent PROT_PR", rc, STRICT ? CRASH : 0);
+    verdict('R', "  parent block afterwards", *rdon, STRICT ? PATTERN : MARK);
+    *rdon = PATTERN;
+
+    /* Pexec 3 + 4: the child runs as a thread in our memory space (E6) and
+       sees our private block in every mode. */
+    make_tail(tail, 't', (UL)priv);
+    pd = (UL)Pexec(3, "C:\\MPKID.NAP", tail, 0);
+    if ((long)pd <= 0) {
+        verdict('t', "Pexec 3", pd, 1);
+    } else {
+        UL env = *(volatile unsigned int *)(pd + 0x2C);
+        rc = (UL)Pexec(4, 0, (const char *)pd, 0);
+        verdict('t', "Pexec 4 thread reads+writes parent PROT_P", rc, 0);
+        verdict('t', "  parent block afterwards", *priv, MARK);
+        gemdos1(0x49, (NLONG)env);
+        gemdos1(0x49, (NLONG)pd);
+    }
+    *priv = PATTERN;
+
+    /* MEM04: a block given back with Mfree is nobody's -- writing it ends
+       its former owner (translation fault, "free"); without protection the
+       write goes through (stage 3a). */
+    rc = run_kid('f', 0);
+    verdict('f', "write after Mfree", rc, OFF ? 0 : CRASH);
+
+    /* We are unharmed: our blocks still hold what we wrote. */
+    verdict('.', "own PROT_P intact", *priv, PATTERN);
+    verdict('.', "own PROT_G intact", *glob, PATTERN);
+    verdict('.', "own PROT_PR intact", *rdon, PATTERN);
+    rc = run_kid('.', 0);
+    verdict('.', "clean child", rc, 0);
+
+    Cconws(fails ? "MPROT3B: FAIL\r\n" : "MPROT3B: PASS\r\n");
+    return fails;
+}
