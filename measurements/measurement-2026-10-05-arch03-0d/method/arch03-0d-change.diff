diff --git a/tos-api/src/bdos/process/reloc.rs b/tos-api/src/bdos/process/reloc.rs
new file mode 100644
index 0000000..006af4c
--- /dev/null
+++ b/tos-api/src/bdos/process/reloc.rs
@@ -0,0 +1,319 @@
+//! Dynamic relocation of a position-independent executable (ARCH03 stage 0d).
+//!
+//! NewTOS programs are `ET_DYN` images (see [`super::elf`]). Their absolute
+//! 64-bit data words — pointer tables, GOT entries, `static` pointer
+//! initialisers — are left for the loader in a `DT_RELA` table, one
+//! `R_AARCH64_RELATIVE` entry per word. This module walks the image's
+//! dynamic section, finds that table, validates every entry and writes the
+//! relocated values into the already-streamed segments. It is the
+//! `Pexec`-time relocation EmuTOS performs for a PRG fixup table
+//! (`bdos/kpgmld.c`), done for the AArch64 ELF format; doing it in the kernel
+//! rather than in `crt0` is plan decision E8, so that a `Pexec(3)`-loaded
+//! image is complete before anyone calls into it.
+//!
+//! ## Sources
+//!
+//! * **AAELF64** 2025Q4 (`references/arm-arm/aaelf64.pdf`) §5.7.15 "Dynamic
+//!   relocations" (p. 40/41): `R_AARCH64_RELATIVE` = 1027, operation
+//!   `Delta(S) + A`; "If S is the null symbol (ELF symbol index 0) then the
+//!   adjustment is based on the segment defining the place"; `Delta(S)` for
+//!   the null symbol is "the difference between the static link address of
+//!   P and the execution address of P" (§5.7.3, p. 20); "all dynamic
+//!   relocations require that the place being relocated is an 8-byte aligned
+//!   64-bit data location in ELF64" (p. 40).
+//! * **gABI** (System V ABI draft 2013-06-10, `references/gabi/`):
+//!   `Elf64_Rela` {`r_offset`, `r_info`, `r_addend`} = 24 bytes and
+//!   `ELF64_R_SYM(i) = i >> 32`, `ELF64_R_TYPE(i) = i & 0xffffffff`
+//!   (ch4.reloc, Figure 4-23); `Elf64_Dyn` {`d_tag`, `d_un`} = 16 bytes,
+//!   `DT_NULL` ends the array, `DT_RELA`/`DT_RELASZ`/`DT_RELAENT` = 7/8/9 and
+//!   "If this element is present, the dynamic structure must also have
+//!   DT_RELASZ and DT_RELAENT elements" (ch5.dynamic, Figures 5-9/5-10);
+//!   `DT_TEXTREL` (22) and `DF_TEXTREL` (0x4 in `DT_FLAGS` = 30) announce
+//!   relocations of non-writable segments.
+//! * **SYSVABI64** 2025Q4 (`references/gabi/sysvabi64.pdf`) §9 (p. 23):
+//!   PIEs are `ET_DYN` and mapped like shared objects.
+//!
+//! `DT_RELACOUNT` is **not** used: it is in none of the pinned sources (0a,
+//! V0a H6). The loader walks the full `DT_RELASZ` range and checks the type
+//! of every entry instead.
+//!
+//! ## What is refused (→ `EPLFMT` via `LoadError::Reloc`)
+//!
+//! Anything that would need a dynamic linker or a relocation this loader
+//! does not perform: `DT_NEEDED` (a shared-library dependency), a PLT table
+//! (`DT_JMPREL`, non-zero `DT_PLTRELSZ`), implicit-addend tables (`DT_REL`,
+//! non-zero `DT_RELSZ`), text relocations (`DT_TEXTREL`, `DF_TEXTREL`), every
+//! relocation type other than `R_AARCH64_RELATIVE`, a `RELATIVE` entry
+//! against a symbol, and every entry whose place is unaligned, outside a
+//! writable `PT_LOAD` segment or inside the relocation/dynamic tables
+//! themselves. Silently skipping such an entry would leave an unrelocated
+//! pointer in the program — a crash far away from its cause.
+//!
+//! ## The image view
+//!
+//! Every function takes `image: &[u8]` indexed by **link-time VA**:
+//! `image[v]` is the byte the program was linked to find at VA `v` (the
+//! loader streams `PT_LOAD` segment `s` to `image[s.vaddr..]`). `load_base`
+//! is the execution address of link VA 0, so a byte linked at `v` executes
+//! at `load_base + v` and `Delta = load_base` for every place. Stage 0 maps
+//! the TPA at VA 0, i.e. `load_base = 0`; stage 1 will pass the TPA block
+//! address. Pure byte manipulation, no `unsafe`, host-testable.
+
+use super::elf::{ElfImage, LoadSegment, PF_W};
+
+/// `R_AARCH64_RELATIVE` (AAELF64 §5.7.15, p. 40).
+pub const R_AARCH64_RELATIVE: u32 = 1027;
+
+/// `sizeof(Elf64_Dyn)` — `Elf64_Sxword d_tag` + `Elf64_Xword/Addr d_un`.
+const DYN_ENT_SIZE: u64 = 16;
+/// `sizeof(Elf64_Rela)` — `r_offset`, `r_info`, `r_addend`, 8 bytes each.
+pub const RELA_ENT_SIZE: u64 = 24;
+
+// `d_tag` values, gABI ch5.dynamic Figure 5-10.
+const DT_NULL: i64 = 0;
+const DT_NEEDED: i64 = 1;
+const DT_PLTRELSZ: i64 = 2;
+const DT_RELA: i64 = 7;
+const DT_RELASZ: i64 = 8;
+const DT_RELAENT: i64 = 9;
+const DT_REL: i64 = 17;
+const DT_RELSZ: i64 = 18;
+const DT_TEXTREL: i64 = 22;
+const DT_JMPREL: i64 = 23;
+const DT_FLAGS: i64 = 30;
+/// `DF_TEXTREL` in `DT_FLAGS` (gABI ch5.dynamic, "DT_FLAGS values").
+const DF_TEXTREL: u64 = 0x4;
+
+/// Why an image's dynamic relocations were refused.
+#[derive(Copy, Clone, Debug, Eq, PartialEq)]
+pub enum RelocError {
+    /// The `PT_DYNAMIC` range is not 8-byte aligned, not a whole number of
+    /// `Elf64_Dyn` entries, or not backed by file bytes of a `PT_LOAD`
+    /// segment.
+    DynamicOutOfImage,
+    /// No `DT_NULL` entry inside the `PT_DYNAMIC` range.
+    DynamicUnterminated,
+    /// `DT_NEEDED`: the program depends on a shared object.
+    NeedsSharedObject,
+    /// `DT_JMPREL` or a non-zero `DT_PLTRELSZ`: a PLT relocation table.
+    PltRelocations,
+    /// `DT_REL` or a non-zero `DT_RELSZ`: an implicit-addend table.
+    RelTable,
+    /// `DT_TEXTREL` or `DF_TEXTREL`: relocations of a non-writable segment.
+    TextRelocations,
+    /// `DT_RELA` without `DT_RELASZ`/`DT_RELAENT`, or a size/entsize without
+    /// the table address (gABI: "must also have").
+    IncompleteRela,
+    /// `DT_RELAENT` is not `sizeof(Elf64_Rela)` (24).
+    BadRelaEntSize,
+    /// `DT_RELASZ` is not a multiple of the entry size.
+    BadRelaSize,
+    /// The `DT_RELA` table is unaligned or not backed by file bytes of a
+    /// `PT_LOAD` segment.
+    RelaOutOfImage,
+    /// A relocation type other than `R_AARCH64_RELATIVE`.
+    UnsupportedType(u32),
+    /// An `R_AARCH64_RELATIVE` entry naming a symbol (index ≠ 0). There is
+    /// no symbol table processing; the static linker emits index 0.
+    SymbolNotNull,
+    /// The place (`r_offset`) is not 8-byte aligned (AAELF64 p. 40).
+    PlaceMisaligned,
+    /// The 8-byte place does not lie inside a writable `PT_LOAD` segment.
+    PlaceNotWritable,
+    /// The place overlaps the relocation table or the dynamic array.
+    PlaceInTables,
+    /// `load_base + r_addend` overflows 64 bits.
+    ValueOverflow,
+}
+
+/// The located `DT_RELA` table: link-time VA and size in bytes.
+#[derive(Copy, Clone, Debug, Eq, PartialEq)]
+pub struct RelaTable {
+    /// `DT_RELA` — link-time VA of the first `Elf64_Rela`.
+    pub vaddr: u64,
+    /// `DT_RELASZ` — total size in bytes (a multiple of 24).
+    pub size: u64,
+}
+
+#[inline]
+fn rd_u64(image: &[u8], off: u64) -> Option<u64> {
+    let off = usize::try_from(off).ok()?;
+    let end = off.checked_add(8)?;
+    image
+        .get(off..end)
+        .map(|b| u64::from_le_bytes(b.try_into().unwrap_or([0; 8])))
+}
+
+/// `true` when `[va, va + len)` lies inside the **file-backed** part of a
+/// `PT_LOAD` segment (`[vaddr, vaddr + file_size)`) and inside `image`.
+fn in_file_bytes(segs: &[LoadSegment], image_len: usize, va: u64, len: u64) -> bool {
+    let Some(end) = va.checked_add(len) else {
+        return false;
+    };
+    if end > image_len as u64 {
+        return false;
+    }
+    segs.iter().any(|s| {
+        s.vaddr
+            .checked_add(s.file_size)
+            .is_some_and(|seg_end| va >= s.vaddr && end <= seg_end)
+    })
+}
+
+/// `true` when `[va, va + 8)` lies inside the memory range of a writable
+/// `PT_LOAD` segment (`[vaddr, vaddr + mem_size)`, BSS included).
+fn in_writable_segment(segs: &[LoadSegment], va: u64) -> bool {
+    let Some(end) = va.checked_add(8) else {
+        return false;
+    };
+    segs.iter().any(|s| {
+        (s.flags & PF_W) != 0
+            && s.vaddr
+                .checked_add(s.mem_size)
+                .is_some_and(|seg_end| va >= s.vaddr && end <= seg_end)
+    })
+}
+
+#[inline]
+fn overlaps(a: u64, a_len: u64, b: u64, b_len: u64) -> bool {
+    // Half-open intervals; callers pass ranges already known not to wrap.
+    a < b.saturating_add(b_len) && b < a.saturating_add(a_len)
+}
+
+/// Walk the `PT_DYNAMIC` array of `img` (already streamed into `image`) and
+/// return the `DT_RELA` table, or `None` when the image has no dynamic
+/// section or a dynamic section without relocations.
+pub fn find_rela(image: &[u8], img: &ElfImage) -> Result<Option<RelaTable>, RelocError> {
+    let Some(dynamic) = img.dynamic else {
+        return Ok(None);
+    };
+    let segs = img.segments();
+    if dynamic.vaddr % 8 != 0
+        || dynamic.file_size % DYN_ENT_SIZE != 0
+        || !in_file_bytes(segs, image.len(), dynamic.vaddr, dynamic.file_size)
+    {
+        return Err(RelocError::DynamicOutOfImage);
+    }
+
+    let mut rela: Option<u64> = None;
+    let mut relasz: Option<u64> = None;
+    let mut relaent: Option<u64> = None;
+    let mut terminated = false;
+
+    let count = dynamic.file_size / DYN_ENT_SIZE;
+    for i in 0..count {
+        let at = dynamic.vaddr + i * DYN_ENT_SIZE;
+        // In range: the whole array was checked against `image` above.
+        let tag = rd_u64(image, at).ok_or(RelocError::DynamicOutOfImage)? as i64;
+        let val = rd_u64(image, at + 8).ok_or(RelocError::DynamicOutOfImage)?;
+        match tag {
+            DT_NULL => {
+                terminated = true;
+                break;
+            }
+            DT_NEEDED => return Err(RelocError::NeedsSharedObject),
+            DT_JMPREL => return Err(RelocError::PltRelocations),
+            DT_PLTRELSZ if val != 0 => return Err(RelocError::PltRelocations),
+            DT_REL => return Err(RelocError::RelTable),
+            DT_RELSZ if val != 0 => return Err(RelocError::RelTable),
+            DT_TEXTREL => return Err(RelocError::TextRelocations),
+            DT_FLAGS if val & DF_TEXTREL != 0 => return Err(RelocError::TextRelocations),
+            DT_RELA => rela = Some(val),
+            DT_RELASZ => relasz = Some(val),
+            DT_RELAENT => relaent = Some(val),
+            // Symbol/string/hash tables, init/fini arrays, DT_DEBUG and the
+            // OS-specific tags lld adds (DT_FLAGS_1, DT_RELACOUNT,
+            // DT_GNU_HASH) carry nothing the loader has to act on.
+            _ => {}
+        }
+    }
+    if !terminated {
+        return Err(RelocError::DynamicUnterminated);
+    }
+
+    let (vaddr, size) = match (rela, relasz, relaent) {
+        (None, None, None) => return Ok(None),
+        (Some(v), Some(sz), Some(ent)) => {
+            if ent != RELA_ENT_SIZE {
+                return Err(RelocError::BadRelaEntSize);
+            }
+            (v, sz)
+        }
+        _ => return Err(RelocError::IncompleteRela),
+    };
+    if size % RELA_ENT_SIZE != 0 {
+        return Err(RelocError::BadRelaSize);
+    }
+    if size == 0 {
+        return Ok(None);
+    }
+    if vaddr % 8 != 0 || !in_file_bytes(segs, image.len(), vaddr, size) {
+        return Err(RelocError::RelaOutOfImage);
+    }
+    Ok(Some(RelaTable { vaddr, size }))
+}
+
+/// Apply every entry of `table` to `image`: write `load_base + r_addend` to
+/// the 8-byte place at link VA `r_offset`. Returns the number of entries
+/// applied. Stops at the first invalid entry; the caller discards the image
+/// on error (the loader frees the TPA), so a half-relocated image never runs.
+pub fn apply_rela(
+    image: &mut [u8],
+    img: &ElfImage,
+    table: RelaTable,
+    load_base: u64,
+) -> Result<usize, RelocError> {
+    let segs = img.segments();
+    let dyn_range = img
+        .dynamic
+        .map(|d| (d.vaddr, d.file_size))
+        .unwrap_or((0, 0));
+    let count = table.size / RELA_ENT_SIZE;
+    for i in 0..count {
+        let at = table.vaddr + i * RELA_ENT_SIZE;
+        // In range: `find_rela` checked the whole table against `image`.
+        let r_offset = rd_u64(image, at).ok_or(RelocError::RelaOutOfImage)?;
+        let r_info = rd_u64(image, at + 8).ok_or(RelocError::RelaOutOfImage)?;
+        let r_addend = rd_u64(image, at + 16).ok_or(RelocError::RelaOutOfImage)? as i64;
+
+        let r_type = (r_info & 0xffff_ffff) as u32;
+        let r_sym = r_info >> 32;
+        if r_type != R_AARCH64_RELATIVE {
+            return Err(RelocError::UnsupportedType(r_type));
+        }
+        if r_sym != 0 {
+            return Err(RelocError::SymbolNotNull);
+        }
+        if r_offset % 8 != 0 {
+            return Err(RelocError::PlaceMisaligned);
+        }
+        if !in_writable_segment(segs, r_offset)
+            || r_offset.checked_add(8).is_none_or(|e| e > image.len() as u64)
+        {
+            return Err(RelocError::PlaceNotWritable);
+        }
+        if overlaps(r_offset, 8, table.vaddr, table.size)
+            || overlaps(r_offset, 8, dyn_range.0, dyn_range.1)
+        {
+            return Err(RelocError::PlaceInTables);
+        }
+        // Delta(S) + A with S the null symbol: the execution address of
+        // link VA 0 is `load_base`, so every place moves by `load_base`.
+        let value = load_base
+            .checked_add_signed(r_addend)
+            .ok_or(RelocError::ValueOverflow)?;
+        let p = r_offset as usize;
+        image[p..p + 8].copy_from_slice(&value.to_le_bytes());
+    }
+    Ok(count as usize)
+}
+
+/// [`find_rela`] + [`apply_rela`]: relocate `image` for execution at
+/// `load_base`. Returns the number of relocations applied (0 for an image
+/// without a dynamic section or without relocations).
+pub fn relocate(image: &mut [u8], img: &ElfImage, load_base: u64) -> Result<usize, RelocError> {
+    match find_rela(image, img)? {
+        Some(table) => apply_rela(image, img, table, load_base),
+        None => Ok(0),
+    }
+}
diff --git a/tos-api/tests/loader_pie_reloc.rs b/tos-api/tests/loader_pie_reloc.rs
new file mode 100644
index 0000000..ff2cfcd
--- /dev/null
+++ b/tos-api/tests/loader_pie_reloc.rs
@@ -0,0 +1,505 @@
+//! ARCH03 stage 0d: NewTOS loads position-independent executables (`ET_DYN`)
+//! and applies their `R_AARCH64_RELATIVE` relocations in the kernel.
+//!
+//! Sources the expectations come from:
+//! * AAELF64 2025Q4 §5.2 (p. 13): `e_flags` "shall contain zero";
+//!   §5.7.15 (p. 40/41): `R_AARCH64_RELATIVE` = 1027, `Delta(S) + A`, the
+//!   place is an 8-byte aligned 64-bit data location.
+//! * gABI 2013-06-10 ch4.reloc (`Elf64_Rela`, `ELF64_R_SYM/TYPE`) and
+//!   ch5.dynamic (`Elf64_Dyn`, `DT_RELA/RELASZ/RELAENT` = 7/8/9, "must also
+//!   have", `DT_TEXTREL` = 22, `DT_FLAGS` = 30 / `DF_TEXTREL` = 0x4).
+//! * SYSVABI64 2025Q4 §9: PIEs have `e_type == ET_DYN`.
+//! * Plan E7: `ET_EXEC` is refused once every in-tree program is PIE;
+//!   EmuTOS answers an unloadable program with `EPLFMT` (`bdos/kpgmld.c`).
+//!
+//! The synthetic image mirrors what `rust-lld -pie` produces for an SDK
+//! program (measured in stage 0d): text `PT_LOAD` (R-X) holding the
+//! `.rela.dyn` table, data `PT_LOAD` (RW-) holding `.dynamic` and the
+//! pointer words, a `PT_DYNAMIC` header over `.dynamic`, link base 0x1000.
+
+use tos_api::bdos::process::elf::{self, ParseError};
+use tos_api::bdos::process::loader::LoadError;
+use tos_api::bdos::process::pexec::PexecError;
+use tos_api::bdos::process::reloc::{self, RelocError, R_AARCH64_RELATIVE};
+use tos_types::error::EPLFMT;
+
+const ET_EXEC: u16 = 2;
+const ET_DYN: u16 = 3;
+const EM_AARCH64: u16 = 183;
+const PT_LOAD: u32 = 1;
+const PT_DYNAMIC: u32 = 2;
+const PT_INTERP: u32 = 3;
+const PF_X: u32 = 1;
+const PF_W: u32 = 2;
+const PF_R: u32 = 4;
+
+const DT_NULL: u64 = 0;
+const DT_NEEDED: u64 = 1;
+const DT_PLTRELSZ: u64 = 2;
+const DT_RELA: u64 = 7;
+const DT_RELASZ: u64 = 8;
+const DT_RELAENT: u64 = 9;
+const DT_REL: u64 = 17;
+const DT_TEXTREL: u64 = 22;
+const DT_JMPREL: u64 = 23;
+const DT_FLAGS: u64 = 30;
+const DT_RELACOUNT: u64 = 0x6fff_fff9; // lld emits it; the loader ignores it
+
+const R_AARCH64_ABS64: u32 = 257;
+const R_AARCH64_GLOB_DAT: u32 = 1025;
+const R_AARCH64_IRELATIVE: u32 = 1032;
+
+// Layout (file offset == link VA, as lld lays out an SDK program).
+const TEXT_VA: u64 = 0x1000;
+const TEXT_SZ: u64 = 0x100;
+const RELA_VA: u64 = 0x1040; // inside text
+const DATA_VA: u64 = 0x1100;
+const DYN_VA: u64 = 0x1100; // first thing in data, like .dynamic in newtos.ld
+const DYN_SLOTS: u64 = 8; // 8 × 16 bytes reserved for the dynamic array
+const WORDS_VA: u64 = DYN_VA + DYN_SLOTS * 16; // 0x1180: the pointer words
+const DATA_FILESZ: u64 = 0xC0;
+const DATA_MEMSZ: u64 = 0x140; // 0x80 BSS
+const FILE_LEN: u64 = DATA_VA + DATA_FILESZ;
+/// The TPA view the loader relocates in: index = link VA.
+const VIEW_LEN: usize = 0x2000;
+
+fn put16(b: &mut [u8], o: u64, v: u16) {
+    b[o as usize..o as usize + 2].copy_from_slice(&v.to_le_bytes());
+}
+fn put32(b: &mut [u8], o: u64, v: u32) {
+    b[o as usize..o as usize + 4].copy_from_slice(&v.to_le_bytes());
+}
+fn put64(b: &mut [u8], o: u64, v: u64) {
+    b[o as usize..o as usize + 8].copy_from_slice(&v.to_le_bytes());
+}
+fn get64(b: &[u8], o: u64) -> u64 {
+    u64::from_le_bytes(b[o as usize..o as usize + 8].try_into().unwrap())
+}
+
+/// One `Elf64_Rela`.
+#[derive(Clone, Copy)]
+struct Rela {
+    offset: u64,
+    sym: u32,
+    rtype: u32,
+    addend: i64,
+}
+fn relative(offset: u64, addend: i64) -> Rela {
+    Rela { offset, sym: 0, rtype: R_AARCH64_RELATIVE, addend }
+}
+
+/// Knobs for a synthetic PIE.
+#[derive(Clone)]
+struct Spec {
+    e_type: u16,
+    e_flags: u32,
+    interp: bool,
+    with_dynamic: bool,
+    /// `(tag, value)` pairs written before the terminating `DT_NULL`.
+    dyn_tags: Vec<(u64, u64)>,
+    /// Omit the terminating `DT_NULL` (all slots filled with this tag).
+    unterminated: bool,
+    relas: Vec<Rela>,
+    /// Override for the dynamic header's VA/size.
+    dyn_va: u64,
+    dyn_sz: u64,
+}
+
+impl Spec {
+    /// A well-formed PIE: two RELATIVE words in data.
+    fn good() -> Self {
+        let relas = vec![relative(WORDS_VA, 0x1010), relative(WORDS_VA + 8, 0x1188)];
+        let n = relas.len() as u64;
+        Spec {
+            e_type: ET_DYN,
+            e_flags: 0,
+            interp: false,
+            with_dynamic: true,
+            dyn_tags: vec![
+                (DT_RELA, RELA_VA),
+                (DT_RELASZ, n * 24),
+                (DT_RELAENT, 24),
+                (DT_RELACOUNT, n),
+            ],
+            unterminated: false,
+            relas,
+            dyn_va: DYN_VA,
+            dyn_sz: DYN_SLOTS * 16,
+        }
+    }
+    fn tag(mut self, tag: u64, val: u64) -> Self {
+        if let Some(e) = self.dyn_tags.iter_mut().find(|(t, _)| *t == tag) {
+            e.1 = val;
+        } else {
+            self.dyn_tags.push((tag, val));
+        }
+        self
+    }
+    fn without_tag(mut self, tag: u64) -> Self {
+        self.dyn_tags.retain(|(t, _)| *t != tag);
+        self
+    }
+    fn relas(mut self, relas: Vec<Rela>) -> Self {
+        let n = relas.len() as u64;
+        self.relas = relas;
+        self.tag(DT_RELASZ, n * 24)
+    }
+
+    /// The file bytes.
+    fn file(&self) -> Vec<u8> {
+        let mut b = vec![0u8; FILE_LEN as usize];
+        b[0..4].copy_from_slice(b"\x7fELF");
+        b[4] = 2; // ELFCLASS64
+        b[5] = 1; // ELFDATA2LSB
+        b[6] = 1; // EV_CURRENT
+        put16(&mut b, 16, self.e_type);
+        put16(&mut b, 18, EM_AARCH64);
+        put32(&mut b, 20, 1);
+        put64(&mut b, 24, TEXT_VA); // e_entry
+        put64(&mut b, 32, 64); // e_phoff
+        put32(&mut b, 48, self.e_flags);
+        put16(&mut b, 52, 64); // e_ehsize
+        put16(&mut b, 54, 56); // e_phentsize
+
+        let mut phdrs: Vec<(u32, u32, u64, u64, u64)> = vec![]; // type, flags, off/va, filesz, memsz
+        if self.interp {
+            phdrs.push((PT_INTERP, PF_R, 0x200, 0x10, 0x10));
+        }
+        phdrs.push((PT_LOAD, PF_R | PF_X, TEXT_VA, TEXT_SZ, TEXT_SZ));
+        phdrs.push((PT_LOAD, PF_R | PF_W, DATA_VA, DATA_FILESZ, DATA_MEMSZ));
+        if self.with_dynamic {
+            phdrs.push((PT_DYNAMIC, PF_R | PF_W, self.dyn_va, self.dyn_sz, self.dyn_sz));
+        }
+        put16(&mut b, 56, phdrs.len() as u16);
+        for (i, (t, f, va, fsz, msz)) in phdrs.iter().enumerate() {
+            let p = 64 + i as u64 * 56;
+            put32(&mut b, p, *t);
+            put32(&mut b, p + 4, *f);
+            put64(&mut b, p + 8, *va); // p_offset == p_vaddr
+            put64(&mut b, p + 16, *va);
+            put64(&mut b, p + 24, *va);
+            put64(&mut b, p + 32, *fsz);
+            put64(&mut b, p + 40, *msz);
+            put64(&mut b, p + 48, 0x1000);
+        }
+
+        // text: a recognisable byte pattern, then the rela table.
+        for i in 0..0x40u64 {
+            b[(TEXT_VA + i) as usize] = 0xC0 | (i as u8 & 0x0F);
+        }
+        for (i, r) in self.relas.iter().enumerate() {
+            let p = RELA_VA + i as u64 * 24;
+            if p + 24 > TEXT_VA + TEXT_SZ {
+                break; // tests that need many entries only claim them
+            }
+            put64(&mut b, p, r.offset);
+            put64(&mut b, p + 8, ((r.sym as u64) << 32) | r.rtype as u64);
+            put64(&mut b, p + 16, r.addend as u64);
+        }
+
+        // dynamic array at DYN_VA (only if it lies in the file).
+        if self.dyn_va == DYN_VA {
+            let mut slot = 0u64;
+            for (t, v) in &self.dyn_tags {
+                put64(&mut b, DYN_VA + slot * 16, *t);
+                put64(&mut b, DYN_VA + slot * 16 + 8, *v);
+                slot += 1;
+            }
+            if self.unterminated {
+                while slot < DYN_SLOTS {
+                    put64(&mut b, DYN_VA + slot * 16, DT_RELAENT);
+                    put64(&mut b, DYN_VA + slot * 16 + 8, 24);
+                    slot += 1;
+                }
+            } else {
+                put64(&mut b, DYN_VA + slot * 16, DT_NULL);
+            }
+        }
+        // The pointer words start out as 0, as lld leaves RELA places.
+        b
+    }
+}
+
+/// Parse + stream the segments into a TPA view the way the loader does.
+fn load(spec: &Spec) -> Result<(Vec<u8>, elf::ElfImage), ParseError> {
+    let file = spec.file();
+    let img = elf::parse(&file, file.len() as u64)?;
+    let mut view = vec![0u8; VIEW_LEN];
+    for s in img.segments() {
+        let (o, n) = (s.file_offset as usize, s.file_size as usize);
+        view[s.vaddr as usize..s.vaddr as usize + n].copy_from_slice(&file[o..o + n]);
+    }
+    Ok((view, img))
+}
+
+fn relocate(spec: &Spec, base: u64) -> Result<(Vec<u8>, usize), RelocError> {
+    let (mut view, img) = load(spec).expect("spec must parse");
+    let n = reloc::relocate(&mut view, &img, base)?;
+    Ok((view, n))
+}
+
+// ─── header checks ──────────────────────────────────────────────────────
+
+#[test]
+fn pie_parses_and_records_its_dynamic_header() {
+    let (_, img) = load(&Spec::good()).unwrap();
+    assert_eq!(img.entry_va, TEXT_VA);
+    assert_eq!(img.segments().len(), 2);
+    let d = img.dynamic.expect("PT_DYNAMIC must be recorded");
+    assert_eq!((d.vaddr, d.file_size), (DYN_VA, DYN_SLOTS * 16));
+}
+
+#[test]
+fn et_exec_is_refused_with_eplfmt() {
+    let mut s = Spec::good();
+    s.e_type = ET_EXEC;
+    let file = s.file();
+    let e = elf::parse(&file, file.len() as u64).unwrap_err();
+    assert_eq!(e, ParseError::NotPositionIndependent);
+    assert_eq!(PexecError::LoadFailed(LoadError::Parse(e)).errno(), EPLFMT);
+}
+
+#[test]
+fn other_e_type_is_not_an_executable() {
+    let mut s = Spec::good();
+    s.e_type = 1; // ET_REL
+    let file = s.file();
+    assert_eq!(elf::parse(&file, file.len() as u64).unwrap_err(), ParseError::NotExecutable);
+}
+
+#[test]
+fn nonzero_e_flags_are_refused() {
+    let mut s = Spec::good();
+    s.e_flags = 1;
+    let file = s.file();
+    assert_eq!(elf::parse(&file, file.len() as u64).unwrap_err(), ParseError::BadFlags);
+}
+
+#[test]
+fn interpreter_request_is_refused() {
+    let mut s = Spec::good();
+    s.interp = true;
+    let file = s.file();
+    assert_eq!(elf::parse(&file, file.len() as u64).unwrap_err(), ParseError::HasInterpreter);
+}
+
+// ─── valid relocation ───────────────────────────────────────────────────
+
+/// Bias 0 is stage 0 (TPA at VA 0): the place receives the addend itself —
+/// which lld does NOT store in the place, so a skipped relocation shows.
+#[test]
+fn relative_at_base_zero_writes_the_addend() {
+    let (view, n) = relocate(&Spec::good(), 0).unwrap();
+    assert_eq!(n, 2);
+    assert_eq!(get64(&view, WORDS_VA), 0x1010);
+    assert_eq!(get64(&view, WORDS_VA + 8), 0x1188);
+}
+
+/// Stage 1 will pass the TPA block address: value = base + addend.
+#[test]
+fn relative_adds_the_load_base() {
+    let base = 0x0040_0000;
+    let (view, _) = relocate(&Spec::good(), base).unwrap();
+    assert_eq!(get64(&view, WORDS_VA), base + 0x1010);
+    assert_eq!(get64(&view, WORDS_VA + 8), base + 0x1188);
+}
+
+/// Relocation touches the places and nothing else: text bytes and the
+/// rela table itself are unchanged, the rest of the data is still zero.
+#[test]
+fn relocation_only_writes_the_places() {
+    let (before, img) = load(&Spec::good()).unwrap();
+    let mut after = before.clone();
+    reloc::relocate(&mut after, &img, 0x10_0000).unwrap();
+    for (i, (a, b)) in before.iter().zip(after.iter()).enumerate() {
+        let i = i as u64;
+        let is_place = (WORDS_VA..WORDS_VA + 16).contains(&i);
+        if !is_place {
+            assert_eq!(a, b, "byte at VA 0x{i:x} changed");
+        }
+    }
+}
+
+#[test]
+fn image_without_dynamic_header_needs_no_relocation() {
+    let mut s = Spec::good();
+    s.with_dynamic = false;
+    let (view, n) = relocate(&s, 0x1234_0000).unwrap();
+    assert_eq!(n, 0);
+    assert_eq!(get64(&view, WORDS_VA), 0, "nothing may be written");
+}
+
+#[test]
+fn dynamic_without_rela_needs_no_relocation() {
+    let s = Spec::good()
+        .without_tag(DT_RELA)
+        .without_tag(DT_RELASZ)
+        .without_tag(DT_RELAENT);
+    assert_eq!(relocate(&s, 0).unwrap().1, 0);
+}
+
+/// `DT_RELACOUNT` is not in the pinned sources (0a H6); the loader walks
+/// `DT_RELASZ`. A lying count must not change the result.
+#[test]
+fn relacount_is_ignored() {
+    let s = Spec::good().tag(DT_RELACOUNT, 0);
+    let (view, n) = relocate(&s, 0).unwrap();
+    assert_eq!(n, 2);
+    assert_eq!(get64(&view, WORDS_VA + 8), 0x1188);
+}
+
+/// A place in the BSS tail of the writable segment is a legal place.
+#[test]
+fn place_in_bss_is_writable() {
+    let bss = DATA_VA + DATA_FILESZ; // 0x11C0
+    let s = Spec::good().relas(vec![relative(bss, 0x2000)]);
+    let (view, _) = relocate(&s, 0).unwrap();
+    assert_eq!(get64(&view, bss), 0x2000);
+}
+
+// ─── unsupported types / symbols ────────────────────────────────────────
+
+#[test]
+fn every_other_relocation_type_is_refused() {
+    for t in [R_AARCH64_ABS64, R_AARCH64_GLOB_DAT, R_AARCH64_IRELATIVE, 0, 1026] {
+        let mut r = relative(WORDS_VA, 0x1000);
+        r.rtype = t;
+        let s = Spec::good().relas(vec![relative(WORDS_VA + 8, 0x1000), r]);
+        assert_eq!(relocate(&s, 0).unwrap_err(), RelocError::UnsupportedType(t));
+    }
+    assert_eq!(
+        PexecError::LoadFailed(LoadError::Reloc(RelocError::UnsupportedType(257))).errno(),
+        EPLFMT
+    );
+}
