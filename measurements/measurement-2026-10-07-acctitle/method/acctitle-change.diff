+/// string to the drawer) if the page could not be published.
+fn title_spec(t: ObjTree, idx: usize) -> u64 {
+    if t.kernel_built() {
+        return title_copy_kva(idx);
+    }
+    titles_user_va().map_or(0, |base| base + (idx * ACC_TITLE_LEN) as u64)
