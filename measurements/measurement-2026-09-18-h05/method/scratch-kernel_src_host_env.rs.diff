+        (2900, Step::Mark("B_MOVED")),
+        (3000, Step::Mv(57, 55)),
+        (3200, Step::Dn),
+        (3203, Step::Up),
+        (3208, Step::Dn),
+        (3211, Step::Up),
+        (3600, Step::Mark("C_AUTO_DIR")),
+        (3700, Step::Mv(-12, -127)),
