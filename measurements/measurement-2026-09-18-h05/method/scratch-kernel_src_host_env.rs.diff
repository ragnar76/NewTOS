+// Scripted IKBD byte injector for the H02 audit (QEMU raspi4b has no input
+// path). Feeds mouse packets into `crate::ikbd::feed` on a schedule relative
+// to the first AES pump of the first EL0 program. `Mark` prints a serial
+// marker the QMP screendump driver waits for; `Arm` switches the AES trace on.
+pub mod h02_inject {
+    use core::sync::atomic::{AtomicU32, AtomicUsize, Ordering};
+    static T0: AtomicU32 = AtomicU32::new(0);
+    static NEXT: AtomicUsize = AtomicUsize::new(0);
+    #[derive(Clone, Copy)]
+    pub enum Step { Mv(i8, i8), Dm(i8, i8), Dn, Up, Arm, Mark(&'static str), Pause }
+
+    // generated by gen_script.py from run1.actions
+    const SCRIPT: &[(u32, Step)] = &[
+        (1200, Step::Mv(-127, -127)),
+        (1201, Step::Mv(-127, -127)),
+        (1202, Step::Mv(-127, -127)),
+        (1203, Step::Mv(-127, -127)),
+        (1204, Step::Mv(-127, -127)),
+        (1205, Step::Mv(-127, -127)),
+        (1206, Step::Mv(127, 127)),
+        (1207, Step::Mv(127, 127)),
+        (1208, Step::Mv(46, 46)),
