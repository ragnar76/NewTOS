+static volatile UL ran_in;
+static volatile UL bad_parm;
+
+/* The parent's private word the 'r' child reads (PROT_P: its BSS). */
+static volatile unsigned int secret;
+
+static UL current_pd(void)
+{
+    /* _sysbase (0x4F2) -> OSHEADER, os_run (+0x28) -> the cell holding the
+       running process's PD. Page 0 is the current process's own. */
+    UL sysbase = *(volatile unsigned int *)0x4F2UL;
+    UL run_cell = *(volatile unsigned int *)(sysbase + 0x28);
+    return (UL)*(volatile unsigned int *)run_cell;
+}
+
+static short ud_draw(PARMBLK *pb)
+{
+    calls++;
+    ran_in = current_pd();
+    if ((UL)pb->pb_parm != MAGIC || pb->pb_tree != tree || pb->pb_obj != 1)
+        bad_parm++;
+    return (short)(pb->pb_currstate | CROSSED);
+}
+
+/* ---- output ---- */
+
+static __attribute__((noinline)) void put_hex(UL v)
+{
+    volatile char buf[11];
+    int i;
+    buf[0] = '0';
+    buf[1] = 'x';
+    for (i = 0; i < 8; i++) {
+        unsigned d = (unsigned)(v >> (28 - 4 * i)) & 0xF;
+        buf[2 + i] = (char)(d < 10 ? '0' + d : 'A' + d - 10);
+    }
+    buf[10] = '\0';
+    Cconws((const char *)buf);
+}
+
+static int fails;
+
+static void verdict(char c, const char *what, UL got, UL want)
+{
+    char line[] = "E10USR: case ? ";
+    line[13] = c;
+    Cconws(line);
+    Cconws(what);
+    Cconws(" got=");
+    put_hex(got);
+    Cconws(" want=");
+    put_hex(want);
+    if (got == want) {
+        Cconws(" OK\r\n");
+    } else {
+        Cconws(" WRONG\r\n");
+        fails++;
+    }
+}
+
+static NLONG Pexec(short mode, const char *path, const char *tail, const char *env)
+{
+    register NLONG x8 __asm__("x8") = 0x4B;
+    register NLONG r0 __asm__("x0") = mode;
+    register NLONG r1 __asm__("x1") = (NLONG)path;
+    register NLONG r2 __asm__("x2") = (NLONG)tail;
+    register NLONG r3 __asm__("x3") = (NLONG)env;
+    __asm__ volatile("svc #1" : "+r"(r0) : "r"(x8), "r"(r1), "r"(r2), "r"(r3) : "memory");
+    return r0;
+}
+
+static void make_tail(char *tail, char c, UL addr)
+{
+    static const char hex[] = "0123456789abcdef";
+    int i;
+    tail[0] = 10;
+    tail[1] = c;
+    tail[2] = ' ';
+    for (i = 0; i < 8; i++)
+        tail[3 + i] = hex[(addr >> ((7 - i) * 4)) & 0xF];
+    tail[11] = '\0';
+}
+
+static short dx, dy, dw, dh;
+
+static void repaint_background(void)
+{
+    int i;
+    for (i = 0; i < 4; i++)
+        aes_intin[1 + i] = 0;
+    aes_intin[0] = FMD_FINISH;
+    aes_intin[5] = dx;
+    aes_intin[6] = dy;
+    aes_intin[7] = dw;
+    aes_intin[8] = dh;
+    aes_call(51, 9, 1, 0); /* form_dial */
+}
+
+static void set_newdesk(OBJECT *t)
+{
+    aes_intin[0] = 0;
+    aes_intin[1] = WF_NEWDESK;
+    aes_intin[2] = aes_intin[3] = aes_intin[4] = aes_intin[5] = 0;
+    aes_addrin[0] = (long)t;
+    aes_call(105, 6, 1, 1); /* wind_set, native addr_in[0] form */
+    aes_addrin[0] = 0;
+}
+
+/* Load the child (Pexec 3: we learn its PD), start it with its own memory
+   space (Pexec 6). Returns the exit code; *pd the child's PD. */
+static UL run_kid(char c, UL addr, UL *pd)
+{
+    char tail[12];
+    NLONG p;
+    make_tail(tail, c, addr);
+    p = Pexec(3, "C:\\E10KID.NAP", tail, 0);
+    *pd = (UL)p;
+    if (p <= 0)
+        return (UL)p;
+    return (UL)Pexec(6, 0, (const char *)p, 0);
+}
+
+int main(void)
+{
+    UL me = current_pd();
+    UL before, kid, rc;
+
+    Cconws(STRICT ? "E10USR: start (expecting memprot=strict)\r\n"
+           : E10_MODE == 2 ? "E10USR: start (expecting memprot=off)\r\n"
+                           : "E10USR: start (expecting protection on, default)\r\n");
+    if (aes_call(10, 0, 1, 0) < 0) { /* appl_init */
+        Cconws("E10USR: FAIL (appl_init)\r\n");
+        return 1;
+    }
+    aes_intin[0] = 0;
+    aes_intin[1] = WF_WORKXYWH;
+    aes_call(104, 2, 5, 0); /* wind_get */
+    dx = aes_intout[1];
+    dy = aes_intout[2];
+    dw = aes_intout[3];
+    dh = aes_intout[4];
+    secret = PATTERN;
+
+    tree[0].ob_next = -1;
+    tree[0].ob_head = 1;
+    tree[0].ob_tail = 1;
+    tree[0].ob_type = G_BOX;
+    tree[0].ob_spec = 0x00001143L; /* the AES's own desktop fill */
+    tree[0].ob_x = dx;
+    tree[0].ob_y = dy;
+    tree[0].ob_width = dw;
+    tree[0].ob_height = dh;
+    ublk.ub_code = ud_draw;
+    ublk.ub_parm = (long)MAGIC;
+    tree[1].ob_next = 0;
+    tree[1].ob_head = -1;
+    tree[1].ob_tail = -1;
+    tree[1].ob_type = G_USERDEF;
+    tree[1].ob_flags = LASTOB;
+    tree[1].ob_spec = (long)&ublk;
+    tree[1].ob_x = 40;
+    tree[1].ob_y = 40;
+    tree[1].ob_width = 160;
+    tree[1].ob_height = 96;
+    set_newdesk(tree);
+
+    /* s: our own repaint -- the routine runs in us. */
+    calls = 0;
+    repaint_background();
+    verdict('s', "own repaint: routine ran", calls ? 1 : 0, 1);
+    verdict('s', "  in this process", ran_in, me);
+
+    /* d: the child's repaints -- the routine runs in the child. */
+    before = calls;
+    ran_in = 0;
+    rc = run_kid('d', 0, &kid);
+    Cconws("E10USR: child PD ");
+    put_hex(kid);
+    Cconws(", routine calls during the child ");
+    put_hex(calls - before);
+    Cconws("\r\n");
+    verdict('d', "child exit", rc, 0);
+    verdict('d', "routine ran during the child", calls - before >= 2 ? 1 : 0, 1);
+    verdict('d', "  in the child (os_run)", ran_in, kid);
+    verdict('d', "  pb_parm/pb_tree/pb_obj right", bad_parm, 0);
+
+    /* r: after its repaints the child reads our private word. */
+    rc = run_kid('r', (UL)&secret, &kid);
+    verdict('r', "child reads parent PROT_P after the callouts", rc, STRICT ? CRASH : 0);
+
+    /* We are unharmed. */
+    verdict('.', "own private word intact", secret, PATTERN);
+
+    /* The verdict first, then 4 s with the background still registered
+       (a screendump shows the CROSSED box), then clean up. */
+    Cconws(fails ? "E10USR: FAIL\r\n" : "E10USR: PASS\r\n");
+    {
+        int i;
+        for (i = 0; i < 3; i++) {
+            aes_intin[0] = 4000;
+            aes_intin[1] = 0;
+            aes_call(24, 2, 1, 0); /* evnt_timer */
+        }
+    }
+    Cconws("E10USR: hold over\r\n");
+    set_newdesk(0);
+    repaint_background();
+    aes_call(19, 0, 1, 0); /* appl_exit */
+    return fails;
+}
diff --git a/tos-api/tests/arch03_3c_e10.rs b/tos-api/tests/arch03_3c_e10.rs
new file mode 100644
index 0000000..dc08064
--- /dev/null
+++ b/tos-api/tests/arch03_3c_e10.rs
@@ -0,0 +1,149 @@
+//! ARCH03 stage 3c — E10 (a): a `G_USERDEF` routine of another process runs
+//! in the current one with the owner's rights for the callout
+//! (`aes/object.rs` `ob_user` → `memprot::grant_temp` / `revoke_temp`;
+//! FreeMiNT `prot_temp`, `sys/arch/mprot030.c:775-805`; EmuTOS runs the
+//! routine wherever the draw happens, `aes/gemoblib.c:411-426`).
+//!
+//! The case that needs the grant: `memprot=strict`, a `Pexec(0)` child
+//! compositing its parent's `WF_NEWDESK` background — the child inherited
+//! nothing (E5 strict), so without the grant the parent's `ub_code`, tree and
+//! `ub_parm` would fault. The grant covers the owner's whole memory space
+//! (a `Pexec(4)` thread's blocks too) and ends with the callout.
+
+use std::sync::atomic::Ordering;
+use std::sync::{Mutex, MutexGuard, Once};
+
+use tos_api::bdos::mem::{free_all_owned, traps};
+use tos_api::bdos::process::mmu;
+use tos_api::bdos::process::{self, memprot, PROCESS_TABLE};
+use tos_types::{BasePage, Long, MX_TTRAM};
+
+const ST_START: u64 = 0x0040_0000;
+const ST_LEN: u64 = 10 * 1024 * 1024;
+const TT_START: u64 = 0x0100_0000;
+const TT_LEN: u64 = 64 * 1024 * 1024;
+const ARENA_TABLES: usize = 512;
+
+static LOCK: Mutex<()> = Mutex::new(());
+static SETUP: Once = Once::new();
+
+#[repr(C, align(4096))]
+struct Page([u8; 4096]);
+
+fn lock() -> MutexGuard<'static, ()> {
+    let g = LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    SETUP.call_once(|| {
+        let arena: Vec<Page> = (0..ARENA_TABLES).map(|_| Page([0; 4096])).collect();
+        let arena = Box::leak(arena.into_boxed_slice());
+        // SAFETY: once per binary, before the pools exist.
+        unsafe {
+            memprot::configure(true, false);
+            mmu::set_table_arena(arena.as_mut_ptr() as u64, ARENA_TABLES);
+            tos_api::bdos::mem::init::init(ST_START, ST_LEN, TT_START, TT_LEN).expect("pools");
+            mmu::map_pools().expect("the pools map");
+        }
+    });
+    g
+}
+
+struct Proc {
+    slot: usize,
+    bp: *mut BasePage,
+}
+
+impl Proc {
+    fn new() -> Proc {
+        let slot = process::allocate_slot().expect("a slot");
+        let bp = Box::into_raw(Box::new([0u8; 256])) as *mut BasePage;
+        let p = &PROCESS_TABLE[slot];
+        p.basepage_kva.store(bp, Ordering::Release);
+        // SAFETY: under the lock; the slot is not an installed root.
+        unsafe { mmu::init_slot_tables(slot) }.unwrap();
+        p.l0_pa.store(mmu::l0_pa_for(slot), Ordering::Release);
+        p.set_state(process::State::Running);
+        // SAFETY: under the lock.
+        unsafe { memprot::on_root_built(slot) };
+        Proc { slot, bp }
+    }
+
+    fn pd(&self) -> *mut core::ffi::c_void {
+        process::pd_of(self.slot).cast()
+    }
+
+    fn alloc(&self, n: Long, mode: i16) -> u64 {
+        process::set_current(process::pd_of(self.slot));
+        // SAFETY: under the lock.
+        let a = unsafe { traps::mxalloc(n, mode) };
+        process::set_current(std::ptr::null_mut());
+        assert_ne!(a, 0, "allocation");
+        a as u32 as u64
+    }
+
+    /// `Pterm`'s memory sweep for this process.
+    fn terminate(&self) {
+        // SAFETY: under the lock.
+        unsafe { free_all_owned::free_all_owned(self.pd()) };
+    }
+}
+
+impl Drop for Proc {
+    fn drop(&mut self) {
+        self.terminate();
+        process::free_slot(self.slot);
+        // SAFETY: allocated by `Box::new` in `new`.
+        drop(unsafe { Box::from_raw(self.bp as *mut [u8; 256]) });
+    }
+}
+
+fn access(slot: usize, va: u64) -> Option<u64> {
+    mmu::translate(slot, va).map(|(_, d)| (d >> 6) & 0b11)
+}
+
+const RW: Option<u64> = Some(0b01);
+
+#[test]
+fn strict_child_runs_the_parents_userdef_only_for_the_callout() {
+    let _g = lock();
+    // SAFETY: under the lock; this binary runs strict.
+    unsafe { memprot::configure(true, true) };
+    let parent = Proc::new();
+    let code = parent.alloc(0x2000, MX_TTRAM); // its text + tree + ub_parm
+    let child = Proc::new();
+    // SAFETY: under the lock.
+    unsafe { memprot::on_launch(child.slot, parent.pd().cast()) };
+    assert_eq!(access(child.slot, code), None, "strict: the child inherited nothing");
+
+    // ob_user: foreign owner -> grant, callout, revoke.
+    // SAFETY: under the lock.
+    unsafe { memprot::grant_temp(child.slot, parent.slot) };
+    assert_eq!(access(child.slot, code), RW, "the owner's routine is reachable for the callout");
+    assert_eq!(access(child.slot, code + 0x1000), RW);
+    // SAFETY: under the lock.
+    unsafe { memprot::revoke_temp(child.slot) };
+    assert_eq!(access(child.slot, code), None, "and not after it");
+    // The parent's own rights never changed.
+    assert_eq!(access(parent.slot, code), RW);
+}
+
+#[test]
+fn the_grant_covers_the_owners_whole_space() {
+    let _g = lock();
+    // SAFETY: under the lock; this binary runs strict.
+    unsafe { memprot::configure(true, true) };
+    let owner = Proc::new();
+    let thread = Proc::new();
+    // A `Pexec(4)` thread of the owner (E6): its blocks are the space's.
+    PROCESS_TABLE[thread.slot].space_pd.store(owner.pd().cast(), Ordering::Release);
+    // SAFETY: under the lock.
+    unsafe { memprot::on_launch(thread.slot, owner.pd().cast()) };
+    let by_thread = thread.alloc(0x1000, MX_TTRAM);
+    let host = Proc::new();
+    assert_eq!(access(host.slot, by_thread), None);
+    // SAFETY: under the lock.
+    unsafe { memprot::grant_temp(host.slot, owner.slot) };
+    assert_eq!(access(host.slot, by_thread), RW);
+    // SAFETY: under the lock.
+    unsafe { memprot::revoke_temp(host.slot) };
+    assert_eq!(access(host.slot, by_thread), None);
+    PROCESS_TABLE[thread.slot].space_pd.store(std::ptr::null_mut(), Ordering::Release);
+}
diff --git a/tos-api/tests/arch03_3c_keep.rs b/tos-api/tests/arch03_3c_keep.rs
new file mode 100644
index 0000000..a200965
--- /dev/null
+++ b/tos-api/tests/arch03_3c_keep.rs
@@ -0,0 +1,209 @@
+//! ARCH03 stage 3c — `Mxalloc(…, F_KEEP | mode)`: FreeMiNT's "don't
+//! auto-free this memory" bit (`sys/mint/mem.h:104-105`).
+//!
+//! FreeMiNT semantics, checked against the real pool and ownership table:
+//!
+//! * the bit sets `M_KEEP` on the region (`sys/dosmem.c:131-135`); it is not
+//!   part of the protection mode (`:237-242`);
+//! * when the terminating process holds the **last** link, the region is not
+//!   freed but attached to the root process (`sys/proc_help.c:242-258`) — in
+//!   NewTOS the kernel owner; its protection mode stays;
+//! * a block with a further owner simply loses the dying owner (links > 1);
+//! * once the system holds it, **any** process may `Mfree` it by address
+//!   (`sys/dosmem.c:365-398`); before that only an owner may (E15);
+//! * an owner's own `Mfree` frees it like any block.
+
+use std::sync::atomic::Ordering;
+use std::sync::{Mutex, MutexGuard, Once};
+
+use tos_api::bdos::mem::{free_all_owned, region, traps};
+use tos_api::bdos::process::mmu;
+use tos_api::bdos::process::{self, memprot, PROCESS_TABLE};
+use tos_api::trap::TrapArgs;
+use tos_api::uaccess::Space;
+use tos_types::error::{EIMBA, E_OK};
+use tos_types::{BasePage, Long, ProtMode, F_KEEP, MX_TTRAM};
+
+const ST_START: u64 = 0x0040_0000;
+const ST_LEN: u64 = 10 * 1024 * 1024;
+const TT_START: u64 = 0x0100_0000;
+const TT_LEN: u64 = 64 * 1024 * 1024;
+const ARENA_TABLES: usize = 512;
+
+static LOCK: Mutex<()> = Mutex::new(());
+static SETUP: Once = Once::new();
+
+#[repr(C, align(4096))]
+struct Page([u8; 4096]);
+
+fn lock() -> MutexGuard<'static, ()> {
+    let g = LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    SETUP.call_once(|| {
+        let arena: Vec<Page> = (0..ARENA_TABLES).map(|_| Page([0; 4096])).collect();
+        let arena = Box::leak(arena.into_boxed_slice());
+        // SAFETY: once per binary, before the pools exist.
+        unsafe {
+            memprot::configure(true, false);
+            mmu::set_table_arena(arena.as_mut_ptr() as u64, ARENA_TABLES);
+            tos_api::bdos::mem::init::init(ST_START, ST_LEN, TT_START, TT_LEN).expect("pools");
+            mmu::map_pools().expect("the pools map");
+        }
+    });
+    g
+}
+
+struct Proc {
+    slot: usize,
+    bp: *mut BasePage,
+}
+
+impl Proc {
+    fn new() -> Proc {
+        let slot = process::allocate_slot().expect("a slot");
+        let bp = Box::into_raw(Box::new([0u8; 256])) as *mut BasePage;
+        let p = &PROCESS_TABLE[slot];
+        p.basepage_kva.store(bp, Ordering::Release);
+        // SAFETY: under the lock; the slot is not an installed root.
+        unsafe { mmu::init_slot_tables(slot) }.unwrap();
+        p.l0_pa.store(mmu::l0_pa_for(slot), Ordering::Release);
+        p.set_state(process::State::Running);
+        // SAFETY: under the lock.
+        unsafe { memprot::on_root_built(slot) };
+        Proc { slot, bp }
+    }
+
+    fn pd(&self) -> *mut core::ffi::c_void {
+        process::pd_of(self.slot).cast()
+    }
+
+    fn alloc(&self, n: Long, mode: i16) -> u64 {
+        process::set_current(process::pd_of(self.slot));
+        // SAFETY: under the lock.
+        let a = unsafe { traps::mxalloc(n, mode) };
+        process::set_current(std::ptr::null_mut());
+        assert_ne!(a, 0, "allocation");
+        a as u32 as u64
+    }
+
+    /// GEMDOS `Mfree` as this process (the owner rule of E15 applies).
+    fn mfree(&self, addr: u64) -> Long {
+        process::set_current(process::pd_of(self.slot));
+        let args = TrapArgs { regs: [addr, 0, 0, 0, 0, 0, 0, 0], func: 0x49, svc_imm: 1, space: Space::User };
+        let rc = tos_api::gemdos::memory::mfree(&args);
+        process::set_current(std::ptr::null_mut());
+        rc
+    }
+
+    /// `Pterm`'s memory sweep for this process.
+    fn terminate(&self) {
+        // SAFETY: under the lock.
+        unsafe { free_all_owned::free_all_owned(self.pd()) };
+    }
+}
+
+impl Drop for Proc {
+    fn drop(&mut self) {
+        self.terminate();
+        process::free_slot(self.slot);
+        // SAFETY: allocated by `Box::new` in `new`.
+        drop(unsafe { Box::from_raw(self.bp as *mut [u8; 256]) });
+    }
+}
+
+fn allocated(addr: u64) -> bool {
+    // SAFETY: under the lock (callers hold it).
+    unsafe { traps::is_allocated(addr) }
+}
+
+fn access(slot: usize, va: u64) -> Option<u64> {
+    mmu::translate(slot, va).map(|(_, d)| (d >> 6) & 0b11)
+}
+
+const RW: Option<u64> = Some(0b01);
+
+#[test]
+fn a_kept_block_outlives_its_owner_and_anybody_may_free_it_then() {
+    let _g = lock();
+    let a = Proc::new();
+    let b = Proc::new();
+    let kept = a.alloc(0x1000, MX_TTRAM | F_KEEP);
+    let kept_g = a.alloc(0x1000, MX_TTRAM | F_KEEP | 0x20);
+    let plain = a.alloc(0x1000, MX_TTRAM);
+    // SAFETY: under the lock.
+    unsafe {
+        assert!(region::is_kept(kept as Long) && region::is_kept(kept_g as Long));
+        assert!(!region::is_kept(plain as Long));
+        // F_KEEP is not part of the mode: the PRGFLAGS default / PROT_G.
+        assert_eq!(memprot::mode_of(kept), ProtMode::P);
+        assert_eq!(memprot::mode_of(kept_g), ProtMode::G);
+    }
+    // While its owner lives, only an owner frees it (E15).
+    assert_eq!(b.mfree(kept), EIMBA);
+    assert!(allocated(kept));
+
+    // The owner terminates: the plain block goes, the kept ones stay —
+    // the system holds them, their modes unchanged.
+    a.terminate();
+    assert!(!allocated(plain), "an ordinary block is freed with its owner");
+    assert!(allocated(kept) && allocated(kept_g), "F_KEEP blocks are not");
+    // SAFETY: under the lock.
+    unsafe {
+        assert_eq!(region::links(kept as Long), 1);
+        assert!(region::is_owner(kept as Long, traps::kernel_owner()), "inherited by the system");
+        assert_eq!(memprot::mode_of(kept), ProtMode::P);
+    }
+    // Rights follow the mode: private memory of the system is nobody's,
+    // global memory everybody's.
+    assert_eq!(access(b.slot, kept), None);
+    assert_eq!(access(b.slot, kept_g), RW);
+
+    // Now anybody may free them by address.
+    assert_eq!(b.mfree(kept), E_OK);
+    assert_eq!(b.mfree(kept_g), E_OK);
+    assert!(!allocated(kept) && !allocated(kept_g));
+    // SAFETY: under the lock.
+    assert!(!unsafe { region::is_kept(kept as Long) }, "the flag goes with the block");
+    assert_eq!(b.mfree(kept), EIMBA, "and it is gone");
+}
+
+#[test]
+fn an_owner_frees_a_kept_block_like_any_other() {
+    let _g = lock();
+    let a = Proc::new();
+    let kept = a.alloc(0x1000, MX_TTRAM | F_KEEP);
+    assert_eq!(a.mfree(kept), E_OK);
+    assert!(!allocated(kept));
+    // A later block at the same address is not kept.
+    let again = a.alloc(0x1000, MX_TTRAM);
+    assert_eq!(again, kept, "first fit reuses the pages");
+    // SAFETY: under the lock.
+    assert!(!unsafe { region::is_kept(again as Long) });
+    a.terminate();
+    assert!(!allocated(again));
+}
+
+#[test]
+fn a_kept_block_with_a_further_owner_passes_to_it_first() {
+    let _g = lock();
+    let a = Proc::new();
+    let b = Proc::new();
+    let kept = a.alloc(0x1000, MX_TTRAM | F_KEEP);
+    // SAFETY: under the lock.
+    unsafe { region::attach(kept as Long, b.pd()) }.unwrap();
+    // `a` dies with another link left: the block is simply b's (links > 1,
+    // FreeMiNT only decrements).
+    a.terminate();
+    // SAFETY: under the lock.
+    unsafe {
+        assert!(region::is_owner(kept as Long, b.pd()));
+        assert!(!region::is_owner(kept as Long, traps::kernel_owner()));
+    }
+    // `b` dies as the last owner: now the system inherits it.
+    b.terminate();
+    assert!(allocated(kept));
+    // SAFETY: under the lock.
+    assert!(unsafe { region::is_owner(kept as Long, traps::kernel_owner()) });
+    let c = Proc::new();
+    assert_eq!(c.mfree(kept), E_OK);
+    assert!(!allocated(kept));
+}
diff --git a/tos-api/tests/arch03_3c_table_shortfall.rs b/tos-api/tests/arch03_3c_table_shortfall.rs
new file mode 100644
index 0000000..1bd9177
--- /dev/null
+++ b/tos-api/tests/arch03_3c_table_shortfall.rs
@@ -0,0 +1,151 @@
+//! ARCH03 stage 3c — the page-table arena runs out: no silent degradation.
+//!
+//! A process whose rights differ from everybody else's in a 2-MiB region
+//! needs a private L3 table from the arena (`memprot` copy-on-differ). When
+//! the arena is empty the process keeps the shared, non-owner rights there —
+//! it can lose access, never gain any — and that is **counted** (since boot
+//! and per process) and **reported once per process**
+//! (`memprot::take_shortfall_report`, printed by the kernel at the end of
+//! the trap). The next process in the same slot is reported on its own.
+//!
+//! The arena here is small on purpose (its own test binary).
+
+use std::sync::atomic::Ordering;
+use std::sync::{Mutex, MutexGuard, Once};
+
+use tos_api::bdos::mem::traps;
+use tos_api::bdos::process::mmu;
+use tos_api::bdos::process::{self, memprot, PROCESS_TABLE};
+use tos_types::{BasePage, Long, MX_TTRAM};
+
+const ST_START: u64 = 0x0040_0000;
+const ST_LEN: u64 = 10 * 1024 * 1024;
+const TT_START: u64 = 0x0100_0000;
+const TT_LEN: u64 = 64 * 1024 * 1024;
+/// The shared L3 tables of the two pools (5 + 32 regions) plus a few.
+const ARENA_TABLES: usize = 44;
+
+static LOCK: Mutex<()> = Mutex::new(());
+static SETUP: Once = Once::new();
+
+#[repr(C, align(4096))]
+struct Page([u8; 4096]);
+
+fn lock() -> MutexGuard<'static, ()> {
+    let g = LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    SETUP.call_once(|| {
+        let arena: Vec<Page> = (0..ARENA_TABLES).map(|_| Page([0; 4096])).collect();
+        let arena = Box::leak(arena.into_boxed_slice());
+        // SAFETY: once per binary, before the pools exist.
+        unsafe {
+            memprot::configure(true, false);
+            mmu::set_table_arena(arena.as_mut_ptr() as u64, ARENA_TABLES);
+            tos_api::bdos::mem::init::init(ST_START, ST_LEN, TT_START, TT_LEN).expect("pools");
+            mmu::map_pools().expect("the pools map");
+        }
+    });
+    g
+}
+
+struct Proc {
+    slot: usize,
+    bp: *mut BasePage,
+}
+
+impl Proc {
+    fn new() -> Proc {
+        let slot = process::allocate_slot().expect("a slot");
+        let bp = Box::into_raw(Box::new([0u8; 256])) as *mut BasePage;
+        let p = &PROCESS_TABLE[slot];
+        p.basepage_kva.store(bp, Ordering::Release);
+        // SAFETY: under the lock; the slot is not an installed root.
+        unsafe { mmu::init_slot_tables(slot) }.unwrap();
+        p.l0_pa.store(mmu::l0_pa_for(slot), Ordering::Release);
+        p.set_state(process::State::Running);
+        // SAFETY: under the lock.
+        unsafe { memprot::on_root_built(slot) };
+        Proc { slot, bp }
+    }
+
+    fn alloc(&self, n: Long, mode: i16) -> u64 {
+        process::set_current(process::pd_of(self.slot));
+        // SAFETY: under the lock.
+        let a = unsafe { traps::mxalloc(n, mode) };
+        process::set_current(std::ptr::null_mut());
+        assert_ne!(a, 0, "allocation");
+        a as u32 as u64
+    }
+
+    /// Allocate private 2-MiB blocks (each in regions of its own) until the
+    /// arena has no table left for this process; the blocks that could not
+    /// get one.
+    fn exhaust(&self) -> Vec<u64> {
+        let mut short = Vec::new();
+        for _ in 0..30 {
+            let before = memprot::table_shortfalls_of(self.slot);
+            let b = self.alloc(2 * 1024 * 1024, MX_TTRAM);
+            if memprot::table_shortfalls_of(self.slot) > before {
+                short.push(b);
+                if short.len() >= 2 {
+                    break;
+                }
+            }
+        }
+        short
+    }
+}
+
+impl Drop for Proc {
+    fn drop(&mut self) {
+        // SAFETY: under the lock.
+        unsafe {
+            tos_api::bdos::mem::free_all_owned::free_all_owned(process::pd_of(self.slot).cast())
+        };
+        process::free_slot(self.slot);
+        // SAFETY: allocated by `Box::new` in `new`.
+        drop(unsafe { Box::from_raw(self.bp as *mut [u8; 256]) });
+    }
+}
+
+#[test]
+fn an_exhausted_arena_is_counted_and_reported_once_per_process() {
+    let _g = lock();
+    while memprot::take_shortfall_report().is_some() {}
+    let total_before = memprot::table_shortfalls();
+
+    let a = Proc::new();
+    let short = a.exhaust();
+    assert!(!short.is_empty(), "the small arena runs out");
+    assert!(memprot::table_shortfalls_of(a.slot) >= short.len());
+    assert!(memprot::table_shortfalls() > total_before, "counted since boot");
+
+    // It can lose access, never gain any: its own private block in a region
+    // without a private table is invalid for it (the non-owner pattern).
+    let last = *short.last().unwrap();
+    let pages = (0..2 * 1024 * 1024 / mmu::PAGE_SIZE).map(|i| last + i * mmu::PAGE_SIZE);
+    let lost = pages.filter(|&va| mmu::translate(a.slot, va).is_none()).count();
+    assert!(lost > 0, "a shortfall leaves the owner without access to part of its block");
+
+    // Reported once for this process ...
+    let r = memprot::take_shortfall_report().expect("a report");
+    assert_eq!(r.slot, a.slot);
+    assert_eq!(r.pd, process::pd_of(a.slot) as u64);
+    assert!(r.of_process >= 1);
+    assert_eq!(r.total, memprot::table_shortfalls());
+    assert_eq!(memprot::take_shortfall_report(), None, "once");
+    // ... also after further shortfalls of the same process.
+    let more = a.alloc(2 * 1024 * 1024, MX_TTRAM);
+    let _ = more;
+    assert_eq!(memprot::take_shortfall_report(), None, "once per process");
+
+    // The slot's next process is reported on its own.
+    let slot = a.slot;
+    drop(a);
+    assert_eq!(memprot::table_shortfalls_of(slot), 0, "the per-process count starts afresh");
+    let b = Proc::new();
+    let short_b = b.exhaust();
+    if !short_b.is_empty() {
+        let r = memprot::take_shortfall_report().expect("the next process is reported");
+        assert_eq!(r.slot, b.slot);
+    }
+}
