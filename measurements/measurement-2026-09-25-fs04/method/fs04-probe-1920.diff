@@ -0,0 +1,186 @@
+
+//! FS04-TEMP — the measurement driver (audit scaffolding; NOT product code).
+//!
+//! Runs the copy the ticket describes straight through the desktop's own
+//! `fun_op` — the function a drag-and-drop ends in (`fun_win2win`,
+//! `deskfun.c:985`) — and prints the layer-by-layer distribution afterwards.
+//! Nothing is printed while a copy runs.
+
+use tos_api::fs04probe as fp;
+
+use super::dir::{self, Op, SelEntry};
+use crate::kprintln;
+
+fn tick_us(t: u64) -> u64 {
+    let f = fp::freq();
+    if f == 0 {
+        0
+    } else {
+        t * 1_000_000 / f
+    }
+}
+
+fn entry_for(path: &str) -> Option<SelEntry> {
+    let info = dir::file_exists(path)?;
+    let mut name = [0u8; 14];
+    let b = info.name.as_bytes();
+    let n = b.len().min(13);
+    name[..n].copy_from_slice(&b[..n]);
+    Some(SelEntry {
+        name,
+        is_dir: false,
+        size: info.size,
+        time: info.time,
+        date: info.date,
+    })
+}
+
+static T0: core::sync::atomic::AtomicU64 = core::sync::atomic::AtomicU64::new(0);
+
+/// Zero every counter and start the wall clock (injector MARK `RESET`).
+pub fn mark_reset() {
+    fp::reset();
+    T0.store(fp::now(), core::sync::atomic::Ordering::Relaxed);
+}
+
+/// Print the distribution accumulated since [`mark_reset`] (MARK `REPORT`).
+pub fn mark_report(tag: &str) {
+    let t0 = T0.load(core::sync::atomic::Ordering::Relaxed);
+    report(tag, fp::now().wrapping_sub(t0));
+}
+
+fn report(tag: &str, wall: u64) {
+    kprintln!("[fs04] ===== {} =====", tag);
+    kprintln!(
+        "[fs04] wall {} us  ({} ticks @ {} Hz)",
+        tick_us(wall),
+        wall,
+        fp::freq()
+    );
+    for i in 0..fp::NSLOT {
+        let c = fp::CNT[i].load(core::sync::atomic::Ordering::Relaxed);
+        if c == 0 {
+            continue;
+        }
+        let t = fp::TCK[i].load(core::sync::atomic::Ordering::Relaxed);
+        let mx = fp::MAXT[i].load(core::sync::atomic::Ordering::Relaxed);
+        let mn = fp::MINT[i].load(core::sync::atomic::Ordering::Relaxed);
+        if i == fp::slot::BLK_READ
+            || i == fp::slot::BLK_WRITE
+            || i == fp::slot::FB_CLEAN
+            || i == fp::slot::FB_CLEAN_LINES
+            || i == fp::slot::EMMC_SPIN
+        {
+            kprintln!(
+                "[fs04] {:<18} calls={:<7} amount={:<9} max/call={} min/call={}",
+                fp::NAMES[i],
+                c,
+                t,
+                mx,
+                mn
+            );
+        } else {
+            kprintln!(
+                "[fs04] {:<18} n={:<7} total={:<9}us  avg={:<7}us  max={:<7}us  min={}us",
+                fp::NAMES[i],
+                c,
+                tick_us(t),
+                tick_us(t / c),
+                tick_us(mx),
+                tick_us(mn)
+            );
+        }
+    }
+    kprintln!("[fs04] --- GEMDOS calls (opcode: n, total us, max us) ---");
+    for op in 0..256usize {
+        let c = fp::GCNT[op].load(core::sync::atomic::Ordering::Relaxed);
+        if c == 0 {
+            continue;
+        }
+        let t = fp::GTCK[op].load(core::sync::atomic::Ordering::Relaxed);
+        let mx = fp::GMAX[op].load(core::sync::atomic::Ordering::Relaxed);
+        kprintln!(
+            "[fs04]   0x{:02x}  n={:<6} total={:<9}us  max={}us",
+            op,
+            c,
+            tick_us(t),
+            tick_us(mx)
+        );
+    }
+    kprintln!("[fs04] ===== end {} =====", tag);
+}
+
+fn one_copy(tag: &str, src_dir: &str, file: &str, dst_dir: &str) {
+    let full = {
+        let mut s = alloc::string::String::from(src_dir);
+        s.push_str(file);
+        s
+    };
+    let Some(e) = entry_for(&full) else {
+        kprintln!("[fs04] {}: source {} not found", tag, full);
+        return;
+    };
+    kprintln!("[fs04] {}: {} ({} bytes) -> {}", tag, full, e.size, dst_dir);
+    fp::reset();
+    let t0 = fp::now();
+    let ran = dir::fun_op(Op::Copy, None, src_dir, &[e], Some(dst_dir));
+    let t1 = fp::now();
+    kprintln!("[fs04] {}: fun_op returned {}", tag, ran);
+    report(tag, t1.wrapping_sub(t0));
+}
+
+/// The whole measurement, run once after the desktop is up.
+pub fn run() {
+    kprintln!("[fs04] driver start; CNTFRQ={} Hz", fp::freq());
+    // The copy-confirmation dialog (`g_ccopypref`) would block a headless run
+    // on `form_do`; the user's click is not part of the measured work.
+    let old = super::global::with(|g| {
+        let o = g.g_ccopypref;
+        g.g_ccopypref = false;
+        o
+    })
+    .unwrap_or(true);
+
+    // A: cross-partition, destination empty and never touched before -- the
+    //    exact case in the ticket.
+    one_copy("A-cold-C-to-D", "C:\\", "README.TXT", "D:\\");
+    // B: the same copy again, same partition pair, now warm.
+    one_copy("B-warm-C-to-D", "C:\\", "HELLO.TXT", "D:\\");
+    // C: same-partition copy for comparison (no boundary crossed).
+    one_copy("C-same-part-C-to-C", "C:\\", "CONFIG.TXT", "C:\\SUB\\");
+    // D: another cold partition, to separate first-touch cost from copy cost.
+    one_copy("D-cold-C-to-E", "C:\\", "README.TXT", "E:\\");
+    // E: a 1 MiB file -- 32 full 32-KiB buffers.  The question this answers is
+    //    whether a 32-KiB Fread survives as one transfer down to the device,
+    //    or decomposes into 64 single-sector accesses.
+    one_copy("E-big-1MiB-C-to-D", "C:\\", "BIG1M.BIN", "D:\\");
+    // F: what a full FAT scan costs (Dfree -> count_free_clusters).  Measured
+    //    to see whether it is in the copy path at all, and what it would cost
+    //    if it were.
+    {
+        fp::reset();
+        let t0 = fp::now();
+        let (tot, avail) = super::dosbind::dos_space(4); // 4 = D:
+        let t1 = fp::now();
+        kprintln!("[fs04] F-dfree-D: total={} avail={}", tot, avail);
+        report("F-dfree-D", t1.wrapping_sub(t0));
+    }
+
+    super::global::with(|g| g.g_ccopypref = old);
+
+    // G: what one full desktop redraw costs, and how much cache maintenance
+    //    it issues.  Taken at two framebuffer geometries so the scaling is
+    //    measured rather than assumed.
+    {
+        let (w, h) = super::global::with(|g| (g.g_desk.w, g.g_desk.h)).unwrap_or((0, 0));
+        fp::reset();
+        let t0 = fp::now();
+        for _ in 0..5 {
+            super::redraw::redraw_desktop();
+        }
+        let t1 = fp::now();
+        kprintln!("[fs04] G-redraw-x5 at {}x{}", w, h);
+        report("G-redraw-x5", t1.wrapping_sub(t0));
+    }
+    kprintln!("[fs04] driver done");
+}
