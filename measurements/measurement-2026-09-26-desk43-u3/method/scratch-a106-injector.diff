+        if !el0 && !DESK_UP.load(Ordering::Acquire) {
+            return; // A46: while an EL0 program runs, or once our desktop is up
+        }
+        if ARMED_BY_EL0.load(Ordering::Relaxed) == 0 { ARMED_BY_EL0.store(if el0 { 1 } else { 2 }, Ordering::Relaxed); }
+        let script: &[(u32, Step)] = if ARMED_BY_EL0.load(Ordering::Relaxed) == 1 { SCRIPT_TERA } else { SCRIPT_DESK };
