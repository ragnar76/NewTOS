+/* ------------------------------------------------------------------------ */
+/* The closing report                                                        */
+/*                                                                           */
+/* One line into ball.c's own log saying what the probe decided, because      */
+/* "the form was verified" and "the demo drew something anyway" are the       */
+/* difference between a result worth trusting and one worth checking, and     */
+/* nobody can tell them apart by looking at the screen.                       */
+/* ------------------------------------------------------------------------ */
+static char rbuf[200];
+static int rlen;
+
+static void r_str(const char *s)
+{
+	while (*s && rlen < (int)sizeof(rbuf) - 1)
+		rbuf[rlen++] = *s++;
+	rbuf[rlen] = '\0';
+}
+
+static void r_dec(long v)
+{
+	char t[12];
+	int n = 0;
+
+	if (v < 0) {
+		r_str("-");
+		v = -v;
+	}
+	do {
+		t[n++] = (char)('0' + (int)(v % 10L));
+		v /= 10L;
+	} while (v > 0 && n < (int)sizeof(t));
+	while (n > 0 && rlen < (int)sizeof(rbuf) - 1)
+		rbuf[rlen++] = t[--n];
+	rbuf[rlen] = '\0';
+}
+
+static void write_report(void)
+{
+	long fd;
+
+	rlen = 0;
+	rbuf[0] = '\0';
+	r_str("BALL: NewTOS screen ");
+	r_dec((long)scr_w);
+	r_str("x");
+	r_dec((long)scr_h);
+	r_str("x");
+	r_dec((long)NT_PLANES);
+	r_str(", memory form ");
+	r_str(fmt_verified ? "VERIFIED" : "NOT VERIFIED");
+	r_str(" (fd_wdwidth = pixels/16, one device word per pixel), "
+	      "colour table ");
+	r_str(pal_measured ? "MEASURED through vs_color" : "NOT MEASURED");
+	r_str(", one page over vro_cpyfm -- no XBIOS screen-base call");
+	r_str("\r\n");
+
+	fd = Fopen(NT_REPORT_PATH, 2);		/* read/write		     */
+	if (fd < 0) {
+		fd = Fcreate(NT_REPORT_PATH, 0);
+		if (fd < 0)
+			return;
+	} else if (Fseek(0L, (short)fd, 2) < 0) {	/* SEEK_END	     */
+		(void)Fclose((short)fd);
+		return;
+	}
+	(void)Fwrite((short)fd, (long)rlen, rbuf);
+	(void)Fclose((short)fd);
+}
