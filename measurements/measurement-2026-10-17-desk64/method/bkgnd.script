# bkgnd.script -- DESK64: Set background (ADBKGND) driven through the IKBD injector, 640x480 raspi4b.
# Dialog 304x256 centred below the 19-px menu bar at (168,121) (form_center); object centres from inf.rs adbkgnd_tree at 8x16:
#   BGPAT2 (244,257)  BGCOL2 red (420,257)  BGWIN (420,193)  BGCOL5 cyan (396,273)  BGOK (260,353).
# Cumulative feed-byte counts (for mdrive markers) in brackets.
# Park bottom-left (left/down moves only: never across the menu bar). [18]
200 0xF8 0x80 0x7F 0xF8 0x80 0x7F 0xF8 0x80 0x7F 0xF8 0x80 0x7F 0xF8 0x80 0x7F 0xF8 0x80 0x7F
# Ctrl+B = the #K shortcut of BACKGRND (slot 21) -> inf_backgrounds. [22]
400 0x1D 0x30 0xB0 0x9D
# (0,479) -> BGPAT2 (244,257): +244 = 127+117, -222 = -128-94. [28]
800 0xF8 0x7F 0x80 0xF8 0x75 0xA2
# click. [34]
1000 0xFA 0x00 0x00
1010 0xF8 0x00 0x00
# -> BGCOL2 (420,257): +176 = 127+49. [40]
1400 0xF8 0x7F 0x00 0xF8 0x31 0x00
# click. [46]
1600 0xFA 0x00 0x00
1610 0xF8 0x00 0x00
# -> BGWIN (420,193): -64. [49]
2000 0xF8 0x00 0xC0
# click. [55]
2200 0xFA 0x00 0x00
2210 0xF8 0x00 0x00
# -> BGCOL5 cyan (396,273): -24, +80. [58]
2600 0xF8 0xE8 0x50
# click. [64]
2800 0xFA 0x00 0x00
2810 0xF8 0x00 0x00
# -> BGOK (260,353): -136 = -128-8, +80. [70]
3200 0xF8 0x80 0x00 0xF8 0xF8 0x50
# click. [76]
3400 0xFA 0x00 0x00
3410 0xF8 0x00 0x00
# Window background in a NEW window: (260,353) -> the "Hard disk" icon (37,35): -223 = -128-95, -318 = -128-128-62. [85]
4200 0xF8 0x80 0x80 0xF8 0xA1 0x80 0xF8 0x00 0xC2
