+/*
+ * libtest.c -- LDG milestone M2 acceptance test (TASK/LDG-M2): the five
+ * third-party libraries zView's codecs need -- zlib 1.3.2, libpng 1.6.59,
+ * IJG libjpeg 9f, giflib 6.1.3, libexif 0.6.26 -- built UNMODIFIED as NewTOS
+ * static libraries, exercised with real round trips on bundled test files.
+ *
+ * Every test file is embedded (libtest-data.h, generated by gen-data.py),
+ * written to the current directory and decoded through the same FILE / path
+ * entry points zView's codecs use (png_init_io, jpeg_stdio_src,
+ * DGifOpenFileName, exif_data_new_from_data on the saved APP1 marker), so
+ * mintlib's stdio/open/lseek are exercised too. Each result is reduced to a
+ * CRC-32 (own bitwise implementation, NOT zlib's, so a zlib defect cannot
+ * hide in the checksum) plus a length, and compared with
+ *   - py_refs[]   (libtest-data.h): computed by gen-data.py without the
+ *                 libraries under test (see its header), and/or
+ *   - host_refs[] (libtest-ref.h): the same library sources built for the
+ *                 host, running this very file (make-ref.sh).
+ * A result must match every reference that exists for it, and must have at
+ * least one. Checks that are pure self-consistency (decode == source after a
+ * write round trip, memory decode == file decode, ...) are marked "self".
+ *
+ *   zlib    crc32()/adler32() of an LCG buffer; compress2 -> uncompress round
+ *           trip (+ the compressed stream's CRC vs host); inflate a stream
+ *           made by Python's zlib; gzwrite -> gzread through a file.
+ *   libpng  six PNGs (RGB8 with tEXt, RGBA8 Adam7, palette-4 Adam7 + tRNS,
+ *           gray-16, gray-1, gray+alpha; every filter type on every image)
+ *           decoded to RGBA8 the way pngldg.c reads (expand, strip_16,
+ *           gray_to_rgb, interlace handling, png_read_row); png_get_text;
+ *           an RGB image written with all filters and read back.
+ *   libjpeg baseline 4:2:0, progressive 4:4:4, grayscale, and one with EXIF +
+ *           COM markers, decoded via jpeg_stdio_src (J1 also via
+ *           jpeg_mem_src); a synthetic image encoded via jpeg_stdio_dest and
+ *           decoded back.
+ *   giflib  plain, interlaced + transparency + comment, 2-frame animation,
+ *           read with the record loop of gifldg.c (DGifGetRecordType /
+ *           DGifGetImageDesc / DGifGetLine with the interlace offsets /
+ *           DGifGetExtension[Next]).
+ *   libexif the J4 APP1 marker: tag names + values as jpgldg.c formats them,
+ *           and the embedded thumbnail (exifData->data) decoded with libjpeg.
+ *
+ * Output (target): one "libtest: PASS|FAIL <name> ..." line per check over
+ * Cconws and the verdict "libtest: ALL PASS (N checks)" or "libtest: FAIL (k
+ * of N checks failed)". Host: the same on stdout; with -DLIBTEST_EMIT the
+ * host build prints the host_refs[] table instead (make-ref.sh).
+ *
+ * Build: sdk/examples/libtest/build-libtest.sh (target),
+ *        sdk/examples/libtest/make-ref.sh      (host references).
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <setjmp.h>
+#include <zlib.h>
+#include <png.h>
+#include <jpeglib.h>
+#include <gif_lib.h>
+#include <libexif/exif-data.h>
+#include <libexif/exif-utils.h>
+#ifndef LIBTEST_HOST
+#include <mint/osbind.h>
+#endif
+
+struct ref { const char *name; unsigned long crc; unsigned long len; };
+#include "libtest-data.h"
+#ifndef LIBTEST_EMIT
+#include "libtest-ref.h"
+#endif
+
+/* ---------------------------------------------------------------- output */
+static void
+out(const char *s)
+{
+#ifdef LIBTEST_HOST
+	fputs(s, stdout);
+#else
+	Cconws(s);
+#endif
+}
+
+static unsigned checks, failed;
+
+static void
+verdict(const char *name, int ok, const char *detail)
+{
+	char line[256];
+	checks++;
+	if (!ok)
+		failed++;
+#ifdef LIBTEST_EMIT
+	if (!ok) {
+		snprintf(line, sizeof line, "/* FAIL %s %s */\n", name, detail ? detail : "");
+		out(line);
+	}
+	return;
+#endif
+	snprintf(line, sizeof line, "libtest: %s %s%s%s\r\n", ok ? "PASS" : "FAIL", name,
+	         detail ? " " : "", detail ? detail : "");
+	out(line);
+}
+
+static void
+info(const char *s)
+{
+#ifndef LIBTEST_EMIT
+	out("libtest: info ");
+	out(s);
+	out("\r\n");
+#else
+	(void)s;
+#endif
+}
+
+/* CRC-32 (IEEE 802.3, reflected, poly 0xEDB88320) -- deliberately not zlib's. */
+static unsigned long
+crc32_own(const unsigned char *p, unsigned long n)
+{
+	unsigned long c = 0xFFFFFFFFul;
+	unsigned long i;
+	int k;
+	for (i = 0; i < n; i++) {
+		c ^= p[i];
+		for (k = 0; k < 8; k++)
+			c = (c >> 1) ^ (0xEDB88320ul & (0ul - (c & 1)));
+	}
+	return (c ^ 0xFFFFFFFFul) & 0xFFFFFFFFul;
+}
+
+static const struct ref *
+find_ref(const struct ref *t, const char *name)
+{
+	for (; t && t->name; t++)
+		if (strcmp(t->name, name) == 0)
+			return t;
+	return NULL;
+}
+
+/* result: compare <name>'s CRC/length with every reference that exists.
+ * EMIT (host reference run): print the host_refs[] line, and still check
+ * against the Python reference so a host-side defect cannot become a
+ * reference. */
+static void
+result(const char *name, const unsigned char *p, unsigned long n)
+{
+	unsigned long c = crc32_own(p, n);
+	const struct ref *py = find_ref(py_refs, name);
+	char d[160];
+#ifdef LIBTEST_EMIT
+	const struct ref *h = NULL;
+	snprintf(d, sizeof d, "  { \"%s\", 0x%08lxu, %luu },\n", name, c, n);
+	out(d);
+#else
+	const struct ref *h = find_ref(host_refs, name);
+#endif
+	int ok = (h || py);
+#ifdef LIBTEST_EMIT
+	ok = 1;
+#endif
+	if (h && (h->crc != c || h->len != n)) ok = 0;
+	if (py && (py->crc != c || py->len != n)) ok = 0;
+	snprintf(d, sizeof d, "crc=%08lx len=%lu [%s%s%s]", c, n,
+	         py ? "py" : "", (py && h) ? "+" : "", h ? "host" : "");
+	if (!ok) {
+		if (!h && !py)
+			snprintf(d + strlen(d), sizeof d - strlen(d), " NO REFERENCE");
+		if (py && (py->crc != c || py->len != n))
+			snprintf(d + strlen(d), sizeof d - strlen(d), " want(py) %08lx/%lu", py->crc, py->len);
+		if (h && (h->crc != c || h->len != n))
+			snprintf(d + strlen(d), sizeof d - strlen(d), " want(host) %08lx/%lu", h->crc, h->len);
+	}
+	verdict(name, ok, d);
+}
+
+static void
+self(const char *name, int ok, const char *detail)
+{
+	char n[64];
+	snprintf(n, sizeof n, "%s (self)", name);
+	verdict(n, ok, detail);
+}
+
+static const struct blob *
+blob(const char *name)
+{
+	const struct blob *b;
+	for (b = blobs; b->name; b++)
+		if (strcmp(b->name, name) == 0)
+			return b;
+	return NULL;
+}
+
+/* Write an embedded file to disk as <name>.TMP; returns the file name. */
+static const char *
+put_file(const char *name)
+{
+	static char fn[32];
+	const struct blob *b = blob(name);
+	FILE *f;
+	snprintf(fn, sizeof fn, "LT_%s.TMP", name);
+	if (!b) return NULL;
+	f = fopen(fn, "wb");
+	if (!f) return NULL;
+	if (fwrite(b->p, 1, b->len, f) != b->len) { fclose(f); return NULL; }
+	if (fclose(f) != 0) return NULL;
+	return fn;
+}
+
+static unsigned char *
+slurp(const char *fn, unsigned long *len)
+{
+	FILE *f = fopen(fn, "rb");
+	unsigned char *p = NULL;
+	unsigned long n = 0, cap = 0;
+	size_t r;
+	if (!f) return NULL;
+	for (;;) {
+		if (n == cap) {
+			unsigned char *q;
+			cap = cap ? cap * 2 : 4096;
+			q = realloc(p, cap);
+			if (!q) { free(p); fclose(f); return NULL; }
+			p = q;
+		}
+		r = fread(p + n, 1, cap - n, f);
+		if (r == 0) break;
+		n += r;
+	}
+	fclose(f);
+	*len = n;
+	return p;
+}
+
+/* ------------------------------------------------------------------ zlib */
+static void
+lcg_text(unsigned char *buf, unsigned long n, unsigned long seed)
+{
+	static const char alpha[] = "NewTOS zlib round trip ABCDEFGH\n";   /* 32 */
+	unsigned long x = seed & 0xFFFFFFFFul, i;
+	for (i = 0; i < n; i++) {
+		x = (x * 1103515245ul + 12345ul) & 0xFFFFFFFFul;
+		buf[i] = (unsigned char)alpha[(x >> 16) & 31];
+	}
+}
+
+static void
+test_zlib(void)
+{
+	unsigned char *src = malloc(ZBUF_LEN), *cmp, *back;
+	uLongf clen, blen;
+	unsigned long v;
+	const struct blob *b;
+	int rc;
+	char d[96];
+	gzFile gz;
+
+	snprintf(d, sizeof d, "zlibVersion()=%s ZLIB_VERSION=%s", zlibVersion(), ZLIB_VERSION);
+	info(d);
+	if (!src) { verdict("Z.alloc", 0, NULL); return; }
+	lcg_text(src, ZBUF_LEN, ZBUF_SEED);
+
+	/* crc32 / adler32: reduce the 32-bit value to bytes so result() can
+	 * compare it (the reference stores the value itself as "crc"). */
+	v = crc32(0L, Z_NULL, 0);
+	v = crc32(v, src, ZBUF_LEN);
+	{
+		const struct ref *r = find_ref(py_refs, "Z.crc32");
+		snprintf(d, sizeof d, "crc32()=%08lx want %08lx", v, r ? r->crc : 0ul);
+		verdict("Z.crc32", r && r->crc == v && r->len == ZBUF_LEN, d);
+	}
+	v = adler32(0L, Z_NULL, 0);
+	v = adler32(v, src, ZBUF_LEN);
+	{
+		const struct ref *r = find_ref(py_refs, "Z.adler32");
+		snprintf(d, sizeof d, "adler32()=%08lx want %08lx", v, r ? r->crc : 0ul);
+		verdict("Z.adler32", r && r->crc == v && r->len == ZBUF_LEN, d);
+	}
+
+	/* compress2 -> uncompress */
+	clen = compressBound(ZBUF_LEN);
+	cmp = malloc(clen);
+	back = malloc(ZBUF_LEN);
+	if (!cmp || !back) { verdict("Z.alloc", 0, NULL); free(src); free(cmp); free(back); return; }
+	rc = compress2(cmp, &clen, src, ZBUF_LEN, 6);
+	snprintf(d, sizeof d, "rc=%d %lu -> %lu bytes", rc, (unsigned long)ZBUF_LEN, (unsigned long)clen);
+	self("Z.compress2", rc == Z_OK && clen < ZBUF_LEN * 3 / 4, d);
+	if (rc == Z_OK)
+		result("Z.deflate-stream", cmp, clen);
+	blen = ZBUF_LEN;
+	rc = uncompress(back, &blen, cmp, clen);
+	snprintf(d, sizeof d, "rc=%d len=%lu", rc, (unsigned long)blen);
+	self("Z.uncompress==source", rc == Z_OK && blen == ZBUF_LEN && memcmp(back, src, ZBUF_LEN) == 0, d);
+
+	/* a stream made by another deflate implementation (Python's zlib) */
+	b = blob("ZPY");
+	{
+		uLongf ol = 32768;
+		unsigned char *o = malloc(ol);
+		if (o && b) {
+			rc = uncompress(o, &ol, b->p, b->len);
+			if (rc == Z_OK)
+				result("Z.inflate-py", o, ol);
+			else {
+				snprintf(d, sizeof d, "uncompress rc=%d", rc);
+				verdict("Z.inflate-py", 0, d);
+			}
+		}
+		free(o);
+	}
+
+	/* gz file round trip (open/write/lseek/read through mintlib) */
+	gz = gzopen("LT_Z.GZ", "wb9");
+	rc = gz ? gzwrite(gz, src, ZBUF_LEN) : -1;
+	rc = (rc == (int)ZBUF_LEN) && gz && gzclose(gz) == Z_OK;
+	if (!rc) {
+		verdict("Z.gzwrite", 0, NULL);
+	} else {
+		int n;
+		memset(back, 0, ZBUF_LEN);
+		gz = gzopen("LT_Z.GZ", "rb");
+		n = gz ? gzread(gz, back, ZBUF_LEN) : -1;
+		snprintf(d, sizeof d, "gzread=%d eof=%d", n, gz ? gzeof(gz) : -1);
+		if (gz) gzclose(gz);
+		self("Z.gzwrite->gzread==source", n == (int)ZBUF_LEN && memcmp(back, src, ZBUF_LEN) == 0, d);
+	}
+	remove("LT_Z.GZ");
+	free(src); free(cmp); free(back);
+}
