+static void
+test_png_file(const char *name)
+{
+	char n[32], d[160];
+	const char *fn = put_file(name);
+	FILE *f;
+	png_structp png = NULL;
+	png_infop pi = NULL;
+	unsigned char *img = NULL;
+	png_uint_32 w, h, y;
+	int ct, bd, il, passes, p;
+	png_size_t rb;
+
+	snprintf(n, sizeof n, "%s.rgba", name);
+	if (!fn || !(f = fopen(fn, "rb"))) { verdict(n, 0, "cannot write/open test file"); return; }
+	png = png_create_read_struct(PNG_LIBPNG_VER_STRING, NULL, NULL, png_quiet);
+	pi = png ? png_create_info_struct(png) : NULL;
+	if (!png || !pi) { verdict(n, 0, "create"); fclose(f); return; }
+	if (setjmp(png_jmpbuf(png))) {
+		png_destroy_read_struct(&png, &pi, NULL);
+		free(img); fclose(f); remove(fn);
+		verdict(n, 0, "libpng error (longjmp)");
+		return;
+	}
+	png_init_io(png, f);
+	png_read_info(png, pi);
+	w = png_get_image_width(png, pi);
+	h = png_get_image_height(png, pi);
+	ct = png_get_color_type(png, pi);
+	bd = png_get_bit_depth(png, pi);
+	il = png_get_interlace_type(png, pi);
+	png_set_expand(png);
+	png_set_strip_16(png);
+	png_set_gray_to_rgb(png);
+	if (!(ct & PNG_COLOR_MASK_ALPHA) && !png_get_valid(png, pi, PNG_INFO_tRNS))
+		png_set_add_alpha(png, 0xff, PNG_FILLER_AFTER);
+	passes = png_set_interlace_handling(png);
+	png_read_update_info(png, pi);
+	rb = png_get_rowbytes(png, pi);
+	snprintf(d, sizeof d, "%lux%lu type %d depth %d interlace %d passes %d rowbytes %lu channels %d",
+	         (unsigned long)w, (unsigned long)h, ct, bd, il, passes, (unsigned long)rb,
+	         png_get_channels(png, pi));
+	info(d);
+	if (rb != (png_size_t)w * 4) {
+		png_destroy_read_struct(&png, &pi, NULL); fclose(f); remove(fn);
+		verdict(n, 0, "rowbytes != width*4");
+		return;
+	}
+	img = calloc(h, rb);
+	for (p = 0; p < passes; p++)
+		for (y = 0; y < h; y++)
+			png_read_row(png, img + y * rb, NULL);
+	png_read_end(png, pi);
+	if (strcmp(name, "P1") == 0) {
+		png_textp t = NULL;
+		int nt = png_get_text(png, pi, &t, NULL);
+		int ok = nt == 1 && strcmp(t[0].key, "Comment") == 0 && strcmp(t[0].text, "NewTOS libtest") == 0;
+		snprintf(d, sizeof d, "png_get_text: %d entr%s, \"%s\"=\"%s\"", nt, nt == 1 ? "y" : "ies",
+		         nt > 0 ? t[0].key : "", nt > 0 ? t[0].text : "");
+		self("P1.tEXt", ok, d);
+	}
+	png_destroy_read_struct(&png, &pi, NULL);
+	fclose(f);
+	remove(fn);
+	result(n, img, (unsigned long)h * rb);
+	free(img);
+}
