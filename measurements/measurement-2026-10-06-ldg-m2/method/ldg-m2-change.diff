+static void
+test_png_write(void)
+{
+	const png_uint_32 w = 19, h = 13;
+	unsigned char src[19 * 13 * 3], *back = NULL, *file;
+	png_structp png;
+	png_infop pi;
+	png_uint_32 x, y;
+	unsigned long flen;
+	FILE *f;
+	char d[96];
+	const char *fn = "LT_PW.TMP";
+
+	for (y = 0; y < h; y++)
+		for (x = 0; x < w; x++) {
+			src[(y * w + x) * 3 + 0] = (unsigned char)(x * 13 + y);
+			src[(y * w + x) * 3 + 1] = (unsigned char)(y * 19);
+			src[(y * w + x) * 3 + 2] = (unsigned char)((x * y) ^ 0x5a);
+		}
+	f = fopen(fn, "wb");
+	png = png_create_write_struct(PNG_LIBPNG_VER_STRING, NULL, NULL, png_quiet);
+	pi = png ? png_create_info_struct(png) : NULL;
+	if (!f || !png || !pi) { verdict("PW.write", 0, "create"); if (f) fclose(f); return; }
+	if (setjmp(png_jmpbuf(png))) {
+		png_destroy_write_struct(&png, &pi);
+		fclose(f);
+		verdict("PW.write", 0, "libpng error (longjmp)");
+		return;
+	}
+	png_init_io(png, f);
+	png_set_IHDR(png, pi, w, h, 8, PNG_COLOR_TYPE_RGB, PNG_INTERLACE_NONE,
+	             PNG_COMPRESSION_TYPE_DEFAULT, PNG_FILTER_TYPE_DEFAULT);
+	png_set_filter(png, PNG_FILTER_TYPE_BASE, PNG_ALL_FILTERS);
+	png_write_info(png, pi);
+	for (y = 0; y < h; y++)
+		png_write_row(png, src + y * w * 3);
+	png_write_end(png, pi);
+	png_destroy_write_struct(&png, &pi);
+	fclose(f);
+
+	file = slurp(fn, &flen);
+	if (!file) { verdict("PW.file", 0, "cannot read back"); return; }
+	result("PW.file", file, flen);
+	free(file);
+
+	/* read it back, untransformed RGB8 */
+	f = fopen(fn, "rb");
+	png = png_create_read_struct(PNG_LIBPNG_VER_STRING, NULL, NULL, png_quiet);
+	pi = png ? png_create_info_struct(png) : NULL;
+	if (!f || !png || !pi) { verdict("PW.read", 0, "create"); if (f) fclose(f); return; }
+	if (setjmp(png_jmpbuf(png))) {
+		png_destroy_read_struct(&png, &pi, NULL);
+		fclose(f); free(back);
+		verdict("PW.read", 0, "libpng error (longjmp)");
+		return;
+	}
+	png_init_io(png, f);
+	png_read_info(png, pi);
+	back = malloc(w * h * 3);
+	for (y = 0; y < h; y++)
+		png_read_row(png, back + y * w * 3, NULL);
+	png_read_end(png, pi);
+	png_destroy_read_struct(&png, &pi, NULL);
+	fclose(f);
+	remove(fn);
+	snprintf(d, sizeof d, "%lu-byte PNG", flen);
+	self("PW.write->read==source", memcmp(back, src, sizeof src) == 0, d);
+	free(back);
+}
