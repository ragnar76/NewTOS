+
+/* Decode <fn> (or, with mem != NULL, the memory buffer) the way jpgldg.c
+ * does; returns the pixels, sets *n. */
+static unsigned char *
+jpeg_decode(const char *label, FILE *f, const unsigned char *mem, unsigned long mlen,
+            int keep_markers, unsigned long *n, char *d, size_t dl)
+{
+	struct jpeg_decompress_struct cinfo;
+	struct jerr je;
+	unsigned char *img = NULL;
+	JSAMPROW row;
+	unsigned long stride;
+
+	(void)label;
+	cinfo.err = jpeg_std_error(&je.pub);
+	je.pub.error_exit = j_errjmp;
+	je.pub.emit_message = j_quiet;
+	if (setjmp(je.jb)) {
+		jpeg_destroy_decompress(&cinfo);
+		free(img);
+		snprintf(d, dl, "libjpeg error");
+		return NULL;
+	}
+	jpeg_create_decompress(&cinfo);
+	if (mem)
+		jpeg_mem_src(&cinfo, (unsigned char *)mem, mlen);
+	else
+		jpeg_stdio_src(&cinfo, f);
+	if (keep_markers) {
+		jpeg_save_markers(&cinfo, JPEG_COM, 0xffff);
+		jpeg_save_markers(&cinfo, M_EXIF, 0xffff);
+	}
+	jpeg_read_header(&cinfo, TRUE);
+	if (keep_markers) {
+		jpeg_saved_marker_ptr m;
+		int com = 0;
+		for (m = cinfo.marker_list; m; m = m->next) {
+			if (m->marker == JPEG_COM && m->data_length == 22 &&
+			    memcmp(m->data, "NewTOS libtest comment", 22) == 0)
+				com = 1;
+			if (m->marker == M_EXIF && !exif_app1) {
+				exif_app1 = malloc(m->data_length);
+				if (exif_app1) {
+					memcpy(exif_app1, m->data, m->data_length);
+					exif_app1_len = m->data_length;
+				}
+			}
+		}
+		self("J4.COM-marker", com, NULL);
+	}
+	if (cinfo.num_components == 3 || cinfo.jpeg_color_space == JCS_YCbCr)
+		cinfo.out_color_space = JCS_RGB;
+	jpeg_start_decompress(&cinfo);
+	stride = (unsigned long)cinfo.output_width * cinfo.output_components;
+	img = malloc(stride * cinfo.output_height);
+	while (cinfo.output_scanline < cinfo.output_height) {
+		row = img + cinfo.output_scanline * stride;
+		jpeg_read_scanlines(&cinfo, &row, 1);
+	}
+	snprintf(d, dl, "%ux%u x%d %s%s", cinfo.output_width, cinfo.output_height,
+	         cinfo.output_components, cinfo.progressive_mode ? "progressive" : "baseline",
+	         cinfo.arith_code ? " arith" : "");
+	*n = stride * cinfo.output_height;
+	jpeg_finish_decompress(&cinfo);
+	jpeg_destroy_decompress(&cinfo);
+	return img;
+}
+
+static void
+test_jpeg_file(const char *name, int markers)
+{
+	char n[32], d[96];
+	unsigned long len;
+	unsigned char *img;
+	const char *fn = put_file(name);
+	FILE *f = fn ? fopen(fn, "rb") : NULL;
+
+	snprintf(n, sizeof n, "%s.pixels", name);
+	if (!f) { verdict(n, 0, "cannot write/open test file"); return; }
+	img = jpeg_decode(name, f, NULL, 0, markers, &len, d, sizeof d);
+	fclose(f);
+	remove(fn);
+	if (!img) { verdict(n, 0, d); return; }
+	info(d);
+	result(n, img, len);
+	if (strcmp(name, "J1") == 0) {
+		const struct blob *b = blob("J1");
+		unsigned long l2;
+		unsigned char *m = jpeg_decode("J1mem", NULL, b->p, b->len, 0, &l2, d, sizeof d);
+		self("J1.mem_src==stdio_src", m && l2 == len && memcmp(m, img, len) == 0, d);
+		free(m);
+	}
+	free(img);
+}
+
+static void
+test_jpeg_encode(void)
+{
+	struct jpeg_compress_struct cinfo;
+	struct jerr je;
+	const int w = 40, h = 24;
+	unsigned char src[40 * 24 * 3], *file, *img;
+	JSAMPROW row;
+	FILE *f;
+	unsigned long flen, len;
+	int x, y;
+	char d[96];
+	const char *fn = "LT_JE.TMP";
+
+	for (y = 0; y < h; y++)
+		for (x = 0; x < w; x++) {
+			src[(y * w + x) * 3 + 0] = (unsigned char)(x * 6);
+			src[(y * w + x) * 3 + 1] = (unsigned char)(255 - y * 10);
+			src[(y * w + x) * 3 + 2] = (unsigned char)(((x / 8 + y / 8) & 1) ? 200 : 40);
+		}
+	f = fopen(fn, "wb");
+	if (!f) { verdict("JE.file", 0, "cannot create"); return; }
+	cinfo.err = jpeg_std_error(&je.pub);
+	je.pub.error_exit = j_errjmp;
+	je.pub.emit_message = j_quiet;
+	if (setjmp(je.jb)) {
+		jpeg_destroy_compress(&cinfo);
+		fclose(f);
+		verdict("JE.file", 0, "libjpeg error");
+		return;
+	}
+	jpeg_create_compress(&cinfo);
+	jpeg_stdio_dest(&cinfo, f);
+	cinfo.image_width = w;
+	cinfo.image_height = h;
+	cinfo.input_components = 3;
+	cinfo.in_color_space = JCS_RGB;
+	jpeg_set_defaults(&cinfo);
+	jpeg_set_quality(&cinfo, 90, TRUE);
+	jpeg_start_compress(&cinfo, TRUE);
+	while (cinfo.next_scanline < cinfo.image_height) {
+		row = src + cinfo.next_scanline * w * 3;
+		jpeg_write_scanlines(&cinfo, &row, 1);
+	}
+	jpeg_finish_compress(&cinfo);
+	jpeg_destroy_compress(&cinfo);
+	fclose(f);
+
+	file = slurp(fn, &flen);
+	if (!file) { verdict("JE.file", 0, "cannot read back"); return; }
+	result("JE.file", file, flen);
+	free(file);
+	f = fopen(fn, "rb");
+	img = f ? jpeg_decode("JE", f, NULL, 0, 0, &len, d, sizeof d) : NULL;
+	if (f) fclose(f);
+	remove(fn);
+	if (!img) { verdict("JE.pixels", 0, d); return; }
+	result("JE.pixels", img, len);
+	{
+		/* lossy: just a sanity bound on the error */
+		unsigned long i, maxd = 0;
+		for (i = 0; i < len && i < sizeof src; i++) {
+			int e = (int)img[i] - (int)src[i];
+			if (e < 0) e = -e;
+			if ((unsigned long)e > maxd) maxd = e;
+		}
+		snprintf(d, sizeof d, "max |decoded-source| = %lu (bound 64)", maxd);
+		self("JE.decode~source", len == sizeof src && maxd <= 64, d);
+	}
+	free(img);
+}
+
+static void
+test_jpeg(void)
+{
+	char d[64];
+	snprintf(d, sizeof d, "JPEG_LIB_VERSION=%d (%d%c)", JPEG_LIB_VERSION,
+	         JPEG_LIB_VERSION_MAJOR, 'a' + JPEG_LIB_VERSION_MINOR - 1);
+	info(d);
+	test_jpeg_file("J1", 0);
+	test_jpeg_file("J2", 0);
+	test_jpeg_file("J3", 0);
+	test_jpeg_file("J4", 1);
+	test_jpeg_encode();
+}
+
+/* ---------------------------------------------------------------- libexif */
+static void
+test_exif(void)
+{
+	ExifData *ed;
+	int i, l, make_ok = 0;
+	char value[1024 + 256];
+	char *text;
+	size_t tl = 0, cap = 8192;
+	char d[128];
+
+	if (!exif_app1) { verdict("E.app1", 0, "J4 had no APP1 marker"); return; }
+	ed = exif_data_new_from_data(exif_app1, exif_app1_len);
+	if (!ed) { verdict("E.parse", 0, "exif_data_new_from_data == NULL"); return; }
+	text = malloc(cap);
+	text[0] = 0;
+	/* jpgldg.c:379-405, verbatim in substance */
+	for (i = 0; i < EXIF_IFD_COUNT; i++) {
+		ExifContent *content = ed->ifd[i];
+		for (l = 0; l < (int)content->count; l++) {
+			ExifEntry *e = content->entries[l];
+			size_t len;
+			sprintf(value, "%s", exif_tag_get_name(e->tag));
+			strcat(value, ": ");
+			len = strlen(value);
+			exif_entry_get_value(e, &value[len], sizeof(value) - len);
+			if (strcmp(value, "Make: NewTOS") == 0)
+				make_ok = 1;
+			len = strlen(value);
+			if (tl + len + 2 < cap) {
+				memcpy(text + tl, value, len);
+				tl += len;
+				text[tl++] = '\n';
+				text[tl] = 0;
+			}
+			info(value);
+		}
+	}
+	snprintf(d, sizeof d, "\"Make: NewTOS\" %s", make_ok ? "found" : "MISSING");
+	self("E.Make", make_ok, d);
+	result("E.text", (unsigned char *)text, tl);
+	free(text);
+
+	/* the thumbnail: exifData->data, decoded like decompress_thumbnail_image */
+	if (!ed->data || !ed->size) {
+		verdict("E.thumb", 0, "no thumbnail");
+	} else {
+		unsigned long n;
+		unsigned char *img;
+		result("E.thumb", ed->data, ed->size);
+		img = jpeg_decode("thumb", NULL, ed->data, ed->size, 0, &n, d, sizeof d);
+		if (!img)
+			verdict("E.thumb.pixels", 0, d);
+		else
+			result("E.thumb.pixels", img, n);
+		free(img);
+	}
+	exif_data_unref(ed);
+	free(exif_app1);
+	exif_app1 = NULL;
+}
+
+/* ---------------------------------------------------------------- giflib */
+static void
+test_gif_file(const char *name, int want_images, int want_interlace, const char *want_comment)
+{
+	static const int off[] = { 0, 4, 2, 1 }, jmp[] = { 8, 8, 4, 2 };
+	char n[32], d[160];
+	const char *fn = put_file(name);
+	GifFileType *gif;
+	GifRecordType rec;
+	int err = 0, images = 0, ext_gce = 0, comment_ok = want_comment ? 0 : 1, il = -1;
+	unsigned char *first = NULL;
+	unsigned long first_len = 0;
+	ColorMapObject *gct;
+
+	snprintf(n, sizeof n, "%s.index", name);
+	if (!fn) { verdict(n, 0, "cannot write test file"); return; }
+	gif = DGifOpenFileName(fn, &err);
+	if (!gif) {
+		snprintf(d, sizeof d, "DGifOpenFileName error %d (%s)", err, GifErrorString(err));
+		verdict(n, 0, d); remove(fn); return;
+	}
+	gct = gif->SColorMap;
+	do {
+		if (DGifGetRecordType(gif, &rec) == GIF_ERROR) break;
+		if (rec == IMAGE_DESC_RECORD_TYPE) {
+			int W, H, row, col, i, j;
+			unsigned char *buf;
+			if (DGifGetImageDesc(gif) == GIF_ERROR) break;
+			W = gif->Image.Width; H = gif->Image.Height;
+			row = gif->Image.Top; col = gif->Image.Left;
+			buf = calloc((size_t)W * H, 1);
+			if (!buf) break;
+			if (images == 0) il = gif->Image.Interlace ? 1 : 0;
+			if (gif->Image.Interlace) {
+				for (i = 0; i < 4; i++)
+					for (j = off[i]; j < H; j += jmp[i])
+						if (DGifGetLine(gif, buf + (size_t)j * W, W) != GIF_OK) goto bad;
+			} else {
+				for (j = 0; j < H; j++)
+					if (DGifGetLine(gif, buf + (size_t)j * W, W) != GIF_OK) goto bad;
+			}
+			(void)row; (void)col;
+			if (images == 0) { first = buf; first_len = (unsigned long)W * H; }
+			else free(buf);
+			images++;
+			continue;
+bad:
+			free(buf);
+			break;
+		} else if (rec == EXTENSION_RECORD_TYPE) {
+			int code;
+			GifByteType *block;
+			if (DGifGetExtension(gif, &code, &block) == GIF_ERROR) break;
+			if (code == GRAPHICS_EXT_FUNC_CODE) ext_gce++;
+			if (code == COMMENT_EXT_FUNC_CODE && want_comment && block &&
+			    block[0] == strlen(want_comment) &&
+			    memcmp(block + 1, want_comment, block[0]) == 0)
+				comment_ok = 1;
+			while (block) {
+				if (DGifGetExtensionNext(gif, &block) == GIF_ERROR) { block = NULL; break; }
+			}
+		}
+	} while (rec != TERMINATE_RECORD_TYPE);
+	snprintf(d, sizeof d, "images %d (want %d), interlace %d (want %d), GCE %d, comment %s, last error %d",
+	         images, want_images, il, want_interlace, ext_gce,
+	         want_comment ? (comment_ok ? "ok" : "MISSING") : "-", gif->Error);
+	self(name, rec == TERMINATE_RECORD_TYPE && images == want_images && il == want_interlace &&
+	     comment_ok, d);
+	if (first)
+		result(n, first, first_len);
+	else
+		verdict(n, 0, "no image decoded");
+	snprintf(n, sizeof n, "%s.gct", name);
+	if (gct) {
+		unsigned char cm[256 * 3];
+		int i;
+		for (i = 0; i < gct->ColorCount && i < 256; i++) {
+			cm[i * 3 + 0] = gct->Colors[i].Red;
+			cm[i * 3 + 1] = gct->Colors[i].Green;
+			cm[i * 3 + 2] = gct->Colors[i].Blue;
+		}
+		result(n, cm, (unsigned long)i * 3);
+	} else {
+		verdict(n, 0, "no global colour table");
+	}
+	DGifCloseFile(gif, &err);
+	free(first);
+	remove(fn);
+}
+
+static void
+test_gif(void)
+{
+	char d[64];
+	snprintf(d, sizeof d, "GIFLIB %d.%d.%d", GIFLIB_MAJOR, GIFLIB_MINOR, GIFLIB_RELEASE);
+	info(d);
+	test_gif_file("G1", 1, 0, NULL);
+	test_gif_file("G2", 1, 1, "NewTOS gif");
+	test_gif_file("G3", 2, 0, NULL);
+}
+
+int
+main(void)
+{
+	char d[64];
+#ifdef LIBTEST_EMIT
+	out("/* libtest-ref.h -- GENERATED by make-ref.sh (TASK/LDG-M2). Do not edit.\n"
+	    " * Results of libtest.c built for the HOST against the same pinned library\n"
+	    " * sources; the target build must reproduce them bit for bit. */\n"
+	    "static const struct ref host_refs[] = {\n");
+#else
+	out("libtest: start (zlib, libpng, libjpeg, giflib, libexif)\r\n");
+#endif
+	test_zlib();
+	test_png();
+	test_jpeg();
+	test_exif();
+	test_gif();
+#ifdef LIBTEST_EMIT
+	out("  { 0, 0, 0 }\n};\n");
+	snprintf(d, sizeof d, "/* %u results, %u failures while generating */\n", checks, failed);
+	out(d);
+	return failed != 0;
+#else
+	if (failed == 0)
+		snprintf(d, sizeof d, "libtest: ALL PASS (%u checks)\r\n", checks);
+	else
+		snprintf(d, sizeof d, "libtest: FAIL (%u of %u checks failed)\r\n", failed, checks);
+	out(d);
+	return failed != 0;
+#endif
+}
