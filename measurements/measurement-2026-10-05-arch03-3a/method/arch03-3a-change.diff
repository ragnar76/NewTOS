+/// `PROT_G` — and anything above `PROT_MAX_MODE` private (`:217-221`).
+pub const fn prot_from_prgflags(prgflags: u32) -> ProtMode {
+    ProtMode::from_prot((prgflags & F_PROTMODE as u32) >> F_PROTSHIFT)
+}
+
+/// The protection mode an `Mxalloc(size, mode)` asks for, FreeMiNT
+/// `m_xalloc` (`sys/dosmem.c:209-221`): the nibble `(mode & F_PROTMODE) >>
+/// F_PROTSHIFT`; `0` takes the caller's PRGFLAGS mode
+/// ([`prot_from_prgflags`]), anything else is **one more** than the
+/// `PROT_*` value it means (`--protmode`, `mem.h:118`), and a result above
+/// `PROT_MAX_MODE` is private. Bit `0x08` and the `F_KEEP`/`F_ALLOCZERO`
+/// bits are not part of the mode.
+pub const fn prot_from_mxalloc(mode: i16, prgflags: u32) -> ProtMode {
+    let nibble = ((mode as u16 as u32) & F_PROTMODE as u32) >> F_PROTSHIFT;
+    if nibble == 0 {
+        prot_from_prgflags(prgflags)
+    } else {
+        ProtMode::from_prot(nibble - 1)
+    }
+}
+
+#[cfg(test)]
+mod prot_tests {
+    use super::*;
+
+    #[test]
+    fn prgflags_nibble_is_the_prot_value_itself() {
+        assert_eq!(prot_from_prgflags(F_PROT_P as u32), ProtMode::P);
+        assert_eq!(prot_from_prgflags(F_PROT_G as u32), ProtMode::G);
+        assert_eq!(prot_from_prgflags(F_PROT_S as u32), ProtMode::S);
+        assert_eq!(prot_from_prgflags(F_PROT_PR as u32), ProtMode::Pr);
+        assert_eq!(prot_from_prgflags(F_PROT_I as u32), ProtMode::I);
+        // Other PRGFLAGS bits do not matter (PF_STANDARD = 7, TT-RAM bits,
+        // the F_MINALT nibble at 28..31).
+        assert_eq!(prot_from_prgflags(0x1000_0017), ProtMode::G);
+        // Above PROT_MAX_MODE → private (dosmem.c:217-221).
+        assert_eq!(prot_from_prgflags(0x50), ProtMode::P);
+        assert_eq!(prot_from_prgflags(0xF0), ProtMode::P);
+    }
+
+    #[test]
+    fn mxalloc_nibble_is_one_more_than_the_prot_value() {
+        // mem.h:118 "when users call Mxalloc, they add 0x10".
+        assert_eq!(prot_from_mxalloc(0x10, 0), ProtMode::P);
+        assert_eq!(prot_from_mxalloc(0x20, 0), ProtMode::G);
+        assert_eq!(prot_from_mxalloc(0x30, 0), ProtMode::S);
+        assert_eq!(prot_from_mxalloc(0x40, 0), ProtMode::Pr);
+        assert_eq!(prot_from_mxalloc(0x50, 0), ProtMode::I);
+        // The same bits mean something else in PRGFLAGS: 0x10 there is G.
+        assert_ne!(prot_from_mxalloc(0x10, 0), prot_from_prgflags(0x10));
+    }
+
+    #[test]
+    fn mxalloc_nibble_zero_takes_the_callers_prgflags() {
+        assert_eq!(prot_from_mxalloc(0x00, F_PROT_G as u32), ProtMode::G);
+        assert_eq!(prot_from_mxalloc(MX_TTRAM, F_PROT_PR as u32), ProtMode::Pr);
+        assert_eq!(prot_from_mxalloc(MX_PREFTTRAM, 0x0000_0007), ProtMode::P);
+    }
+
+    #[test]
+    fn mxalloc_other_bits_and_out_of_range() {
+        // LDG's `Mxalloc(size, 3 + 8 + 32)` (ldgutil.c): nibble 0x20 → PROT_G;
+        // the TT-RAM-preferred low bits and 0x08 are not the mode.
+        assert_eq!(prot_from_mxalloc(3 + 8 + 32, 0), ProtMode::G);
+        // F_KEEP (0x4000) does not change the mode.
+        assert_eq!(prot_from_mxalloc(0x4000 | 0x20, 0), ProtMode::G);
+        // 0x60..0xF0 → PROT_* 5..14 → private.
+        assert_eq!(prot_from_mxalloc(0x60, F_PROT_G as u32), ProtMode::P);
+        assert_eq!(prot_from_mxalloc(0xF0, F_PROT_G as u32), ProtMode::P);
+    }
+}
diff --git a/sdk/examples/uacc3a.c b/sdk/examples/uacc3a.c
new file mode 100644
index 0000000..991c2fc
--- /dev/null
+++ b/sdk/examples/uacc3a.c
@@ -0,0 +1,93 @@
+/*
+ * uacc3a.c -- parent driver for the ARCH03 stage-3a bad-pointer probe.
+ *
+ * Starts C:\UAKID.NAP once per case with Pexec(PE_LOADGO) (an EL0 parent, so
+ * every child's end resumes an EL0 program) and checks the exit code:
+ * 0x0000FFFF for every bad-pointer case (EmuTOS: bus error in the trap ->
+ * dopanic -> Pterm(-1) of the caller), 0 for the closing clean case '.'.
+ * Cases marked [disk] in uakid.c need a C: drive; on a machine without one
+ * (QEMU virt) they are skipped. One key per crash case answers the crash
+ * prompt. Prints one line per case and "UACC3A: PASS"/"UACC3A: FAIL".
+ *
+ * The case list is UACC3A_CASES (compile-time), default: all of uakid.c.
+ *
+ * Build: sdk/build.sh sdk/examples/uacc3a.c <out>/UACC3A.NAP
+ */
+#include <newtos.h>
+
+#ifndef UACC3A_CASES
+#define UACC3A_CASES "congwrWdftksmbPTKAIGFVCMEX."
+#endif
+static const char disk_cases[] = "rWdftb";
+
+static NLONG Pexec(short mode, const char *path, const char *tail, const char *env)
+{
+    register NLONG x8 __asm__("x8") = 0x4B;
+    register NLONG r0 __asm__("x0") = mode;
+    register NLONG r1 __asm__("x1") = (NLONG)path;
+    register NLONG r2 __asm__("x2") = (NLONG)tail;
+    register NLONG r3 __asm__("x3") = (NLONG)env;
+    __asm__ volatile("svc #1" : "+r"(r0) : "r"(x8), "r"(r1), "r"(r2), "r"(r3) : "memory");
+    return r0;
+}
+
+static __attribute__((noinline)) void put_hex(unsigned long v)
+{
+    volatile char buf[19];
+    int i;
+    buf[0] = '0';
+    buf[1] = 'x';
+    for (i = 0; i < 16; i++) {
+        unsigned d = (unsigned)(v >> (60 - 4 * i)) & 0xF;
+        buf[2 + i] = (char)(d < 10 ? '0' + d : 'A' + d - 10);
+    }
+    buf[18] = '\0';
+    Cconws((const char *)buf);
+}
+
+static int is_disk_case(char c)
+{
+    const char *p;
+    for (p = disk_cases; *p; p++)
+        if (*p == c)
+            return 1;
+    return 0;
+}
+
+int main(void)
+{
+    static const char cases[] = UACC3A_CASES;
+    static char dta[44];
+    char tail[3];
+    char line[] = "UACC3A: case ? rc=";
+    int i, fails = 0, has_disk;
+
+    gemdos1(0x1A, (NLONG)dta);
+    has_disk = gemdos2(0x4E, (NLONG)"C:\\UAKID.NAP", 0x37) == 0;
+    Cconws(has_disk ? "UACC3A: start (C: present)\r\n" : "UACC3A: start (no C:)\r\n");
+    for (i = 0; cases[i]; i++) {
+        unsigned long want = cases[i] == '.' ? 0 : 0xFFFF;
+        NLONG rc;
+
+        line[13] = cases[i];
+        if (!has_disk && is_disk_case(cases[i])) {
+            Cconws(line);
+            Cconws("skipped (no disk)\r\n");
+            continue;
+        }
+        tail[0] = 1;
+        tail[1] = cases[i];
+        tail[2] = '\0';
+        rc = Pexec(0, "C:\\UAKID.NAP", tail, 0);
+        Cconws(line);
+        put_hex((unsigned long)rc);
+        if ((unsigned long)rc == want) {
+            Cconws(" OK\r\n");
+        } else {
+            Cconws(" WRONG\r\n");
+            fails++;
+        }
+    }
+    Cconws(fails ? "UACC3A: FAIL\r\n" : "UACC3A: PASS\r\n");
+    return 0;
+}
diff --git a/sdk/examples/uakid.c b/sdk/examples/uakid.c
new file mode 100644
index 0000000..26e2576
--- /dev/null
+++ b/sdk/examples/uakid.c
@@ -0,0 +1,235 @@
+/*
+ * uakid.c -- hands the kernel ONE bad user pointer on purpose (ARCH03 3a).
+ *
+ * The first character of the command tail selects the system call and the
+ * argument that carries the bad address 0xDEAD0000 (unmapped in every
+ * process: not page 0, not a pool, not a publication). Every case expects
+ * the EmuTOS answer to a bus error inside a system call
+ * (docs/api/bios/_exception-crash.md §5): the crash report, a key wait, then
+ * Pterm(-1) of THIS program -- the parent's Pexec returns 0x0000FFFF -- and
+ * the machine keeps running. The line "UAKID: survived" must never appear.
+ *
+ *   GEMDOS (sub-step 2)                          BIOS/XBIOS (sub-step 3)
+ *   c  Cconws(BAD)  (stage 0c pilot)             k  Cconrs(BAD)
+ *   o  Fopen(BAD)
+ *   n  Frename(0, "C:\UAKID.NAP", BAD)           s  Ssystem(S_GETCOOKIE, 0, BAD)
+ *   w  Fwrite(1 = console, 5, BAD)               m  Getmpb(BAD)
+ *   g  Dgetpath(BAD, 0)                          P  Setpalette(BAD)
+ *   r  Fread(file, 16, BAD)            [disk]    T  Protobt(BAD, 0x01000000, 2, 0)
+ *   W  Fwrite(new file, 16, BAD)       [disk]    K  Keytbl(BAD, -1, -1)
+ *   d  Fsetdta(BAD) + Fsfirst("C:\*.*") [disk]   b  Rwabs(0, BAD, 1, 0, C:, 0) [disk]
+ *   f  Dfree(BAD, 0)                   [disk]
+ *   t  Fdatime(BAD, file, 0)           [disk]
+ *
+ *   AES / VDI (sub-step 4/5)
+ *   A  AES trap, parameter block pointer BAD
+ *   I  AES graf_mouse(ARROW) with intin = BAD
+ *   G  appl_init, then AES call with global = BAD
+ *   F  appl_init, then appl_find(BAD name)
+ *   V  VDI trap, parameter block pointer BAD
+ *   C  VDI vq_extnd with contrl = BAD
+ *   M  appl_init/graf_handle/v_opnvwk, vro_cpyfm screen -> MFDB at BAD
+ *   E  appl_init, objc_edit(ED_CHAR) on a tree whose te_ptext is BAD
+ *   X  appl_init, menu_text(own tree, 1, BAD)
+ *
+ *   o-k  clean exit (case '.')
+ *
+ * Build: sdk/build.sh sdk/examples/uakid.c <out>/UAKID.NAP
+ */
+#include <newtos.h>
+
+#define BAD 0xDEAD0000UL
+#define P_CMDLIN 0x80
+
+typedef unsigned long UL;
+
+static UL sys(int trap, UL fn, UL a0, UL a1, UL a2, UL a3, UL a4, UL a5)
+{
+    register UL x8 __asm__("x8") = fn;
+    register UL r0 __asm__("x0") = a0;
+    register UL r1 __asm__("x1") = a1;
+    register UL r2 __asm__("x2") = a2;
+    register UL r3 __asm__("x3") = a3;
+    register UL r4 __asm__("x4") = a4;
+    register UL r5 __asm__("x5") = a5;
+    switch (trap) {
+    case 1:
+        __asm__ volatile("svc #1" : "+r"(r0) : "r"(x8), "r"(r1), "r"(r2), "r"(r3), "r"(r4), "r"(r5) : "memory");
+        break;
+    case 2:
+        __asm__ volatile("svc #2" : "+r"(r0) : "r"(x8), "r"(r1), "r"(r2), "r"(r3), "r"(r4), "r"(r5) : "memory");
+        break;
+    case 13:
+        __asm__ volatile("svc #13" : "+r"(r0) : "r"(x8), "r"(r1), "r"(r2), "r"(r3), "r"(r4), "r"(r5) : "memory");
+        break;
+    default:
+        __asm__ volatile("svc #14" : "+r"(r0) : "r"(x8), "r"(r1), "r"(r2), "r"(r3), "r"(r4), "r"(r5) : "memory");
+        break;
+    }
+    return r0;
+}
+#define G(fn, a, b, c) sys(1, (fn), (UL)(a), (UL)(b), (UL)(c), 0, 0, 0)
+#define B(fn, a, b, c, d, e, f) sys(13, (fn), (UL)(a), (UL)(b), (UL)(c), (UL)(d), (UL)(e), (UL)(f))
+#define X(fn, a, b, c, d) sys(14, (fn), (UL)(a), (UL)(b), (UL)(c), (UL)(d), 0, 0)
+
+static const unsigned char *own_basepage(void)
+{
+    UL sysbase = *(volatile unsigned int *)0x4F2UL;
+    UL run_cell = *(volatile unsigned int *)(sysbase + 0x28);
+    return (const unsigned char *)(UL)*(volatile unsigned int *)run_cell;
+}
+
+/* ---- AES / VDI (LP64: 8-byte pointers, 8-byte addrin slots) ------------- */
+static short control[16], global[16], intin[16], intout[16];
+static UL addrin[8], addrout[8];
+static struct { void *c, *g, *ii, *io, *ai, *ao; } aespb = {
+    control, global, intin, intout, addrin, addrout };
+static short contrl[16], vintin[32], ptsin[32], vintout[64], ptsout[32];
+static struct { void *c, *ii, *pi, *io, *po; } vdipb = {
+    contrl, vintin, ptsin, vintout, ptsout };
+
+static void aes(int op, int nin, int nout, int nain, int naout)
+{
+    control[0] = op; control[1] = nin; control[2] = nout;
+    control[3] = nain; control[4] = naout;
+    sys(2, 0, 200, (UL)&aespb, 0, 0, 0, 0);
+}
+static void vdi(int op, int npts, int nint, int handle)
+{
+    contrl[0] = op; contrl[1] = npts; contrl[3] = nint; contrl[6] = handle;
+    sys(2, 0, 115, (UL)&vdipb, 0, 0, 0, 0);
+}
+static void appl_init(void) { aes(10, 0, 1, 0, 0); }
+
+/* OBJECT (LP64, 32 bytes) and TEDINFO (LP64) for case 'E'. */
+struct obj { short next, head, tail, type, flags, state; int pad; UL spec; short x, y, w, h; };
+struct ted { UL ptext, ptmplt, pvalid; short font, fontid, just, color, fontsize, thick, txtlen, tmplen; };
+static struct ted ted = { BAD, (UL)"____", (UL)"XXXX", 3, 0, 0, 0x1180, 0, 0, 5, 5 };
+static struct obj tree[2] = {
+    { -1, 1, 1, 20 /* G_BOX */, 0, 0, 0, 0x1100, 0, 0, 100, 40 },
+    { 0, -1, -1, 29 /* G_FTEXT */, 0x20 /* LASTOB */ | 0x08 /* EDITABLE */, 0, 0, 0, 8, 8, 64, 16 },
+};
+static struct obj menu[3] = {
+    { -1, 1, 2, 25 /* G_IBOX */, 0, 0, 0, 0, 0, 0, 100, 40 },
+    { 2, -1, -1, 28 /* G_STRING */, 0, 0, 0, 0, 0, 0, 80, 16 },
+    { 0, -1, -1, 28 /* G_STRING */, 0x20, 0, 0, 0, 0, 16, 80, 16 },
+};
+
+int main(void)
+{
+    const unsigned char *tail = own_basepage() + P_CMDLIN;
+    char c = tail[0] ? (char)tail[1] : '.';
+    char line[] = "UAKID: case ? starting\r\n";
+    long h;
+
+    line[12] = c;
+    Cconws(line);
+
+    switch (c) {
+    /* ---- GEMDOS ---------------------------------------------------- */
+    case 'c': G(0x09, BAD, 0, 0); break; /* Cconws, the 0c pilot */
+    case 'o': G(0x3D, BAD, 0, 0); break;
+    case 'n': G(0x56, 0, "C:\\UAKID.NAP", BAD); break;
+    case 'w': G(0x40, 1, 5, BAD); break;
+    case 'g': G(0x47, BAD, 0, 0); break;
+    case 'r':
+        h = (long)G(0x3D, "C:\\UAKID.NAP", 0, 0);
+        if (h < 0) { Cconws("UAKID: no file\r\n"); return 3; }
+        G(0x3F, h, 16, BAD);
+        break;
+    case 'W':
+        h = (long)G(0x3C, "C:\\UAKID.TMP", 0, 0);
+        if (h < 0) { Cconws("UAKID: no create\r\n"); return 3; }
+        G(0x40, h, 16, BAD);
+        break;
+    case 'd':
+        G(0x1A, BAD, 0, 0);
+        G(0x4E, "C:\\*.*", 0x37, 0);
+        break;
+    case 'f': G(0x36, BAD, 0, 0); break;
+    case 't':
+        h = (long)G(0x3D, "C:\\UAKID.NAP", 0, 0);
+        if (h < 0) { Cconws("UAKID: no file\r\n"); return 3; }
+        G(0x57, BAD, h, 0);
+        break;
+    /* ---- BIOS / XBIOS / Ssystem / Cconrs ---------------------------- */
+    case 'k': G(0x0A, BAD, 0, 0); break;
+    case 's': G(0x154, 8, 0, BAD); break; /* tag 0: the jar capacity, always found */
+    case 'm': B(0x00, BAD, 0, 0, 0, 0, 0); break;
+    case 'b': B(0x04, 0, BAD, 1, 0, 2, 0); break;
+    case 'P': X(0x06, BAD, 0, 0, 0); break;
+    case 'T': X(0x12, BAD, 0x01000000UL, 2, 0); break;
+    case 'K': X(0x10, BAD, -1L, -1L, 0); break;
+    /* ---- AES / VDI --------------------------------------------------- */
+    case 'A': sys(2, 0, 200, BAD, 0, 0, 0, 0); break;
+    case 'I':
+        aespb.ii = (void *)BAD;
+        intin[0] = 0;
+        aes(78, 1, 1, 1, 0); /* graf_mouse(ARROW) */
+        break;
+    case 'G':
+        appl_init();
+        aespb.g = (void *)BAD;
+        aes(10, 0, 1, 0, 0); /* appl_init writes global[] */
+        break;
+    case 'F':
+        appl_init();
+        addrin[0] = BAD;
+        aes(13, 0, 1, 1, 0); /* appl_find(name) */
+        break;
+    case 'V': sys(2, 0, 115, BAD, 0, 0, 0, 0); break;
+    case 'C':
+        vdipb.c = (void *)BAD;
+        sys(2, 0, 115, (UL)&vdipb, 0, 0, 0, 0);
+        break;
+    case 'M': {
+        static struct { UL addr; short w, h, wdw, std, planes, r1, r2, r3; } src, dst;
+        short handle;
+        int i;
+        appl_init();
+        aes(77, 0, 5, 0, 0); /* graf_handle */
+        handle = intout[0];
+        for (i = 0; i < 10; i++) vintin[i] = 1;
+        vintin[10] = 2;
+        vdi(100, 0, 11, handle); /* v_opnvwk */
+        handle = contrl[6];
+        src.addr = 0;
+        /* 16 x 16 pixels, one WORD of width per plane row, device planes */
+        dst.addr = BAD; dst.w = 16; dst.h = 16; dst.wdw = 1; dst.std = 0;
+        vintin[0] = 1;
+        vdi(102, 0, 1, handle); /* vq_extnd(1): intout[4] = planes */
+        dst.planes = vintout[4];
+        vintin[0] = 3; /* S_ONLY */
+        ptsin[0] = 0; ptsin[1] = 0; ptsin[2] = 15; ptsin[3] = 15;
+        ptsin[4] = 0; ptsin[5] = 0; ptsin[6] = 15; ptsin[7] = 15;
+        *(UL *)&contrl[7] = (UL)&src;   /* N_PTRINTS = 4 (LP64) */
+        *(UL *)&contrl[11] = (UL)&dst;
+        vdi(109, 4, 1, handle); /* vro_cpyfm */
+        break;
+    }
+    case 'E':
+        appl_init();
+        tree[1].spec = (UL)&ted;
+        addrin[0] = (UL)tree;
+        intin[0] = 1; intin[1] = 'A'; intin[2] = 0; intin[3] = 2; /* ED_CHAR */
+        aes(46, 4, 2, 1, 0); /* objc_edit */
+        break;
+    case 'X':
+        appl_init();
+        menu[1].spec = (UL)" Item ";
+        menu[2].spec = (UL)" Two ";
+        addrin[0] = (UL)menu;
+        addrin[1] = BAD;
+        intin[0] = 1;
+        aes(34, 1, 1, 2, 0); /* menu_text */
+        break;
+    case '.':
+        Cconws("UAKID: clean exit\r\n");
+        return 0;
+    default:
+        Cconws("UAKID: unknown case\r\n");
+        return 2;
+    }
+    Cconws("UAKID: survived -- FAIL\r\n");
+    return 1;
+}
diff --git a/tos-api/tests/arch03_3a_caller_space.rs b/tos-api/tests/arch03_3a_caller_space.rs
new file mode 100644
index 0000000..e6ea82d
--- /dev/null
+++ b/tos-api/tests/arch03_3a_caller_space.rs
@@ -0,0 +1,167 @@
+//! ARCH03 stage 3a: the GEMDOS file surface reads and writes its pointer
+//! arguments in the **caller's space** (`TrapArgs::space`) — an EL0 program's
+//! through the fault-safe `tos_api::uaccess` routines, an in-kernel caller's
+//! (the built-in desktop's `svc` from EL1, the AES fiber) as kernel addresses.
+//!
+//! On the host both spaces are plain host-memory accesses, so what can be
+//! asserted here is that the conversion from raw dereferences to the
+//! space-aware copies changed no result: every call gives the same return
+//! value and the same bytes whether it is issued as `User` or as `Kernel`.
+//! The fault side (a bad pointer ends the calling program) needs the MMU and
+//! is driven in QEMU (`measurements/measurement-2026-10-05-arch03-3a`, probe
+//! UACC3A).
+
+mod fatvol;
+
+use fatvol::*;
+use tos_api::uaccess::Space;
+
+const FDATIME: u16 = 0x57;
+const DFREE: u16 = 0x36;
+const FRENAME: u16 = 0x56;
+const FATTRIB: u16 = 0x43;
+const DSETPATH: u16 = 0x3B;
+
+fn both<T: PartialEq + std::fmt::Debug>(mut f: impl FnMut(Space) -> T) {
+    let k = f(Space::Kernel);
+    let u = f(Space::User);
+    assert_eq!(k, u, "User and Kernel space must give the same result");
+}
+
+#[test]
+fn fopen_fread_same_in_both_spaces() {
+    let (_g, _host) = fs();
+    both(|sp| {
+        let path = cpath("C:\\HELLO.TXT");
+        let h = call_in(sp, FOPEN, [path.as_ptr() as u64, 0, 0, 0, 0, 0, 0, 0]);
+        assert!(h >= 0, "Fopen ({sp:?}) -> {h}");
+        let mut buf = [0xEEu8; 8];
+        let n = call_in(sp, FREAD, [h as u64, 8, buf.as_mut_ptr() as u64, 0, 0, 0, 0, 0]);
+        assert_eq!(call_in(sp, FCLOSE, [h as u64, 0, 0, 0, 0, 0, 0, 0]), E_OK);
+        (n, buf)
+    });
+}
+
+#[test]
+fn fwrite_then_fread_round_trip_in_user_space() {
+    let (_g, _host) = fs();
+    let path = cpath("C:\\U3A.TXT");
+    let h = call_in(Space::User, FCREATE, [path.as_ptr() as u64, 0, 0, 0, 0, 0, 0, 0]);
+    assert!(h >= 0, "Fcreate -> {h}");
+    // Longer than a sector and not a multiple of 8: exercises the partial
+    // sector path and the byte tail of the copy routine.
+    let data: Vec<u8> = (0..1301u32).map(|i| (i * 7 + 3) as u8).collect();
+    let n = call_in(Space::User, FWRITE, [h as u64, data.len() as u64, data.as_ptr() as u64, 0, 0, 0, 0, 0]);
+    assert_eq!(n, data.len() as i32);
+    assert_eq!(call_in(Space::User, FCLOSE, [h as u64, 0, 0, 0, 0, 0, 0, 0]), E_OK);
+
+    let h = call_in(Space::User, FOPEN, [path.as_ptr() as u64, 0, 0, 0, 0, 0, 0, 0]);
+    assert!(h >= 0);
+    let mut back = vec![0u8; data.len() + 16];
+    let n = call_in(Space::User, FREAD, [h as u64, back.len() as u64, back.as_mut_ptr() as u64, 0, 0, 0, 0, 0]);
+    assert_eq!(n, data.len() as i32, "Fread stops at EOF");
+    assert_eq!(&back[..data.len()], &data[..]);
+    assert!(back[data.len()..].iter().all(|&b| b == 0), "nothing written past the count");
+    assert_eq!(call_in(Space::User, FCLOSE, [h as u64, 0, 0, 0, 0, 0, 0, 0]), E_OK);
+    assert_eq!(call_in(Space::User, FDELETE, [path.as_ptr() as u64, 0, 0, 0, 0, 0, 0, 0]), E_OK);
+}
+
+#[test]
+fn fdatime_get_same_in_both_spaces() {
+    let (_g, _host) = fs();
+    both(|sp| {
+        let path = cpath("C:\\HELLO.TXT");
+        let h = call_in(sp, FOPEN, [path.as_ptr() as u64, 0, 0, 0, 0, 0, 0, 0]);
+        assert!(h >= 0);
+        let mut stamp = [0u8; 4];
+        let rc = call_in(sp, FDATIME, [stamp.as_mut_ptr() as u64, h as u64, 0, 0, 0, 0, 0, 0]);
+        let _ = call_in(sp, FCLOSE, [h as u64, 0, 0, 0, 0, 0, 0, 0]);
+        (rc, stamp)
+    });
+}
+
+#[test]
+fn fdatime_set_reads_the_callers_stamp() {
+    let (_g, _host) = fs();
+    let path = cpath("C:\\HELLO.TXT");
+    let h = call_in(Space::User, FOPEN, [path.as_ptr() as u64, 2, 0, 0, 0, 0, 0, 0]);
+    assert!(h >= 0);
+    let mut old = [0u8; 4];
+    assert_eq!(call_in(Space::User, FDATIME, [old.as_mut_ptr() as u64, h as u64, 0, 0, 0, 0, 0, 0]), E_OK);
+    let new = [0x21u8, 0x43, 0x65, 0x07];
+    assert_eq!(call_in(Space::User, FDATIME, [new.as_ptr() as u64, h as u64, 1, 0, 0, 0, 0, 0]), E_OK);
+    let mut got = [0u8; 4];
+    assert_eq!(call_in(Space::User, FDATIME, [got.as_mut_ptr() as u64, h as u64, 0, 0, 0, 0, 0, 0]), E_OK);
+    assert_eq!(got, new);
+    assert_eq!(call_in(Space::User, FDATIME, [old.as_ptr() as u64, h as u64, 1, 0, 0, 0, 0, 0]), E_OK);
+    let _ = call_in(Space::User, FCLOSE, [h as u64, 0, 0, 0, 0, 0, 0, 0]);
+}
+
+#[test]
+fn dfree_and_dgetpath_same_in_both_spaces() {
+    let (_g, _host) = fs();
+    both(|sp| {
+        let mut info = [0u8; 16];
+        let rc = call_in(sp, DFREE, [info.as_mut_ptr() as u64, 3, 0, 0, 0, 0, 0, 0]);
+        let sub = cpath("C:\\SUB");
+        assert_eq!(call_in(sp, DSETPATH, [sub.as_ptr() as u64, 0, 0, 0, 0, 0, 0, 0]), E_OK);
+        let mut p = [0xAAu8; 32];
+        let rc2 = call_in(sp, DGETPATH, [p.as_mut_ptr() as u64, 3, 0, 0, 0, 0, 0, 0]);
+        let root = cpath("C:\\");
+        assert_eq!(call_in(sp, DSETPATH, [root.as_ptr() as u64, 0, 0, 0, 0, 0, 0, 0]), E_OK);
+        (rc, info, rc2, p)
+    });
+}
+
+#[test]
+fn dgetpath_writes_path_and_terminator() {
+    let (_g, _host) = fs();
+    let sub = cpath("C:\\SUB");
+    assert_eq!(call_in(Space::User, DSETPATH, [sub.as_ptr() as u64, 0, 0, 0, 0, 0, 0, 0]), E_OK);
+    let mut p = [0xAAu8; 16];
+    assert_eq!(call_in(Space::User, DGETPATH, [p.as_mut_ptr() as u64, 3, 0, 0, 0, 0, 0, 0]), E_OK);
+    assert_eq!(&p[..5], b"\\SUB\0");
+    assert_eq!(p[5], 0xAA, "nothing past the terminator");
+    let root = cpath("C:\\");
+    assert_eq!(call_in(Space::User, DSETPATH, [root.as_ptr() as u64, 0, 0, 0, 0, 0, 0, 0]), E_OK);
+}
+
+#[test]
+fn fsfirst_fills_the_same_dta_in_both_spaces() {
+    let (_g, _host) = fs();
+    both(|sp| {
+        let mut dta = [0u8; 44];
+        // The process-less caller's DTA cell (`find::KERNEL_DTA`).
+        assert_eq!(call_in(sp, FSETDTA, [dta.as_mut_ptr() as u64, 0, 0, 0, 0, 0, 0, 0]), E_OK);
+        let pat = cpath("C:\\*.*");
+        let rc = call_in(sp, FSFIRST, [pat.as_ptr() as u64, FA_ANY, 0, 0, 0, 0, 0, 0]);
+        let first = dta;
+        let rc2 = call_in(sp, FSNEXT, [0; 8]);
+        (rc, first, rc2, dta)
+    });
+}
+
+#[test]
+fn frename_and_fattrib_take_their_paths_in_the_callers_space() {
+    let (_g, _host) = fs();
+    let a = cpath("C:\\HELLO.TXT");
+    let b = cpath("C:\\HELLO2.TXT");
+    assert_eq!(call_in(Space::User, FRENAME, [0, a.as_ptr() as u64, b.as_ptr() as u64, 0, 0, 0, 0, 0]), E_OK);
+    assert!(call_in(Space::User, FATTRIB, [b.as_ptr() as u64, 0, 0, 0, 0, 0, 0, 0]) >= 0);
+    assert_eq!(call_in(Space::User, FATTRIB, [a.as_ptr() as u64, 0, 0, 0, 0, 0, 0, 0]), EFILNF);
+    assert_eq!(call_in(Space::Kernel, FRENAME, [0, b.as_ptr() as u64, a.as_ptr() as u64, 0, 0, 0, 0, 0]), E_OK);
+}
+
+#[test]
+fn a_path_is_read_up_to_128_bytes_and_a_null_path_is_refused() {
+    let (_g, _host) = fs();
+    // Null pointer: the call's own error code, as before (`path_arg` → None).
+    assert_eq!(call_in(Space::User, FOPEN, [0, 0, 0, 0, 0, 0, 0, 0]), EFILNF);
+    assert_eq!(call_in(Space::User, FCREATE, [0, 0, 0, 0, 0, 0, 0, 0]), EPTHNF);
+    // "C:\HELLO.TXT" followed by 200 bytes of junk without a NUL inside the
+    // first 128: the reader stops at 128 bytes and does not run on.
+    let mut long = b"C:\\HELLO.TXT".to_vec();
+    long.extend(std::iter::repeat_n(b'X', 200));
+    let rc = call_in(Space::User, FOPEN, [long.as_ptr() as u64, 0, 0, 0, 0, 0, 0, 0]);
+    assert!(rc < 0, "a 128-byte name that is not HELLO.TXT does not open it: {rc}");
+}
diff --git a/tos-api/tests/arch03_3a_gem_space.rs b/tos-api/tests/arch03_3a_gem_space.rs
new file mode 100644
index 0000000..8d8dece
--- /dev/null
+++ b/tos-api/tests/arch03_3a_gem_space.rs
@@ -0,0 +1,103 @@
+//! ARCH03 stage 3a: the GEM trap reads and writes the caller's AES / VDI
+//! parameter blocks in the caller's space (`aes::dispatch_in`,
+//! `vdi::dispatch_in` with `uaccess::Space`). On the host both spaces are
+//! plain host-memory accesses, so these tests pin that the conversion changed
+//! no result: the same call through `Space::User` and through the kernel
+//! entry (`dispatch`, `Space::Kernel`) leaves the same words behind. The
+//! fault side (a bad block or array pointer ends the calling program) needs
+//! the MMU and is driven in QEMU (probe UACC3A, cases A I G F V C M E X).
+
+use std::sync::Mutex;
+
+use tos_api::bdos::process::Abi;
+use tos_api::uaccess::Space;
+
+/// The AES and VDI keep global state; one call at a time.
+static LOCK: Mutex<()> = Mutex::new(());
+
+/// One AES call with a fresh block → (`int_out`, `global`).
+fn aes(space: Option<Space>, control: [i16; 5], intin: [i16; 4], addrin: [u64; 2]) -> ([i16; 8], [i16; 16]) {
+    let mut control = control;
+    let mut global = [0x55i16; 16];
+    let mut intin = intin;
+    let mut intout = [0x77i16; 8];
+    let mut addrin = addrin;
+    let mut addrout = [0u64; 2];
+    let raw = [
+        control.as_mut_ptr() as u64,
+        global.as_mut_ptr() as u64,
+        intin.as_mut_ptr() as u64,
+        intout.as_mut_ptr() as u64,
+        addrin.as_mut_ptr() as u64,
+        addrout.as_mut_ptr() as u64,
+    ];
+    // SAFETY: a well-formed LP64 parameter block, alive for the call.
+    unsafe {
+        match space {
+            Some(sp) => tos_api::aes::dispatch_in(raw.as_ptr() as u64, Abi::Lp64, sp),
+            None => tos_api::aes::dispatch(raw.as_ptr() as u64, Abi::Lp64),
+        }
+    };
+    (intout, global)
+}
+
+#[test]
+fn appl_init_fills_the_same_aesglobal_in_both_spaces() {
+    let _g = LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let k = aes(None, [10, 0, 1, 0, 0], [0; 4], [0; 2]);
+    let u = aes(Some(Space::User), [10, 0, 1, 0, 0], [0; 4], [0; 2]);
+    assert_eq!(k, u);
+    // ap_version was written (0x0340) and the words past index 12 were not.
+    assert_eq!(u.1[0], 0x0340);
+    assert_eq!(u.1[13], 0x55);
+    // Exactly OUT_LEN = 1 word reached the caller's int_out.
+    assert_eq!(u.0[1], 0x77);
+}
+
+#[test]
+fn appl_find_reads_the_name_in_the_callers_space() {
+    let _g = LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let name = *b"SCRENMGR";
+    let ctl = [13, 0, 1, 1, 0];
+    let k = aes(None, ctl, [0; 4], [name.as_ptr() as u64, 0]);
+    let u = aes(Some(Space::User), ctl, [0; 4], [name.as_ptr() as u64, 0]);
+    assert_eq!(k.0, u.0);
+    assert_eq!(u.0[0], 1, "the Screen Manager's pid");
+    // A null name: -1, nothing read.
+    let n = aes(Some(Space::User), ctl, [0; 4], [0, 0]);
+    assert_eq!(n.0[0], -1);
+}
+
+#[test]
+fn out_len_zero_writes_nothing_in_user_space() {
+    let _g = LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    // appl_yield (17) with OUT_LEN = 0: not even RET_CODE is copied back.
+    let u = aes(Some(Space::User), [17, 0, 0, 0, 0], [0; 4], [0; 2]);
+    assert_eq!(u.0, [0x77; 8]);
+}
+
+#[test]
+fn vdi_block_and_contrl_go_through_the_callers_space() {
+    let _g = LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    for space in [Space::User, Space::Kernel] {
+        let mut contrl = [102i16, 0, 9, 1, 9, 0, 1, 0, 0, 0, 0, 0];
+        let mut intin = [0i16; 4];
+        let mut ptsin = [0i16; 4];
+        let mut intout = [0i16; 64];
+        let mut ptsout = [0i16; 16];
+        let raw = [
+            contrl.as_mut_ptr() as u64,
+            intin.as_mut_ptr() as u64,
+            ptsin.as_mut_ptr() as u64,
+            intout.as_mut_ptr() as u64,
+            ptsout.as_mut_ptr() as u64,
+        ];
+        // SAFETY: a well-formed LP64 VDI parameter block, alive for the call.
+        let r = unsafe { tos_api::vdi::dispatch_in(raw.as_ptr() as u64, Abi::Lp64, space) };
+        // Hostless: no raster backend, so the VDI is inert after it has set
+        // the default output counts — CONTRL[2] and CONTRL[4] — to 0.
+        assert_eq!(r, 0, "{space:?}");
+        assert_eq!((contrl[2], contrl[4]), (0, 0), "{space:?}");
+        assert_eq!(contrl[0], 102, "{space:?}");
+    }
+}
