+/// [`Space::kptr`] for a user range.
+fn user_kptr(va: u64, len: u64, write: bool) -> Result<u64, UserFault> {
+    const PAGE: u64 = 0x1000;
+    let probe = |a: u64| if write { probe_user_write(a) } else { get_user_u8(a).map(|_| ()) };
