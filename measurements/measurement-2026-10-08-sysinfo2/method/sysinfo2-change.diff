+/* Write `len` bytes as file `name` (created or truncated). 0 or an error. */
+static long write_file(const char *name, const char *buf, int len)
+{
+    long h = Fcreate(name, 0);
+    long w, c;
+    if (h < 0)
+        return h;
+    w = Fwrite(h, len, buf);
+    c = Fclose(h);
+    if (w < 0)
+        return w;
+    if (w != len)
+        return -1;  /* ERROR: short write (disk full) */
+    return c < 0 ? c : 0;
+}
