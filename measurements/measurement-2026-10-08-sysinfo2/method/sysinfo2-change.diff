+        aes_intin[0] = MU_KEYBD | MU_BUTTON | MU_M1;
+        aes_intin[1] = 1;      /* one click      */
+        aes_intin[2] = 1;      /* left button    */
+        aes_intin[3] = 1;      /* ... down       */
+        aes_intin[4] = m1out;
+        aes_intin[5] = m1x; aes_intin[6] = m1y;
+        aes_intin[7] = m1w; aes_intin[8] = m1h;
