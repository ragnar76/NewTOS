+fn prgflags_patch(bytes: &mut [u8], v: u32) -> Result<u32, String> {
+    let (old, at) = prgflags_locate(bytes)?;
+    bytes[at..at + 4].copy_from_slice(&v.to_le_bytes());
+    Ok(old)
