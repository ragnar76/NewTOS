+ * below that move a pointer into or out of such a field get an explicit
+ * cast through __UINTPTR_TYPE__ (user addresses are below 2 GiB, plan I2).
+ * Everything else -- tfork's Pexec(5) + Pexec(104/4) sequence, __waitval,
+ * __waittime -- is mintlib's code unchanged. tfork's `arg` travels in the
+ * 32-bit p_dlen as in mintlib; vfork passes an address below 2 GiB there.
+ *
+ * tfork(function, argument): starts a new thread of execution running
+ * in the same address space. The new thread gets its own 4K stack,
+ * and starts at the address in "function" with "argument" on the stack,
+ * i.e. as though the main program had a call like "function(argument)".
+ * The main program continues executing, with tfork returning the process
+ * i.d. of the child.
+ * (if MiNT is not active, then the child runs to completion
+ *  and the return value is the child's exit status; vfork() relies on
+ *  this behavior)
+ *
+ * Note that parent and child share the same memory; this could cause
+ * problems with some library calls, notably malloc().
+ */
+
+#include <compiler.h>
+#include <mint/osbind.h>
+#include <mint/basepage.h>
+#include <signal.h>
+#include <time.h>
+#include <unistd.h>
+#include <signal.h>
+#include <errno.h>
+#include <support.h>
+#include "lib.h"
+
+#define THREAD_STACKSIZE 4096L
+
+
+/* this is used by wait() and wait3() to retrieve the child's exit code */
+long __waitval = -ENOENT;
+
+/* and this is used to retrieve the child's time */
+long __waittime = 0;
+
+/*
+ * This function must not be compiled without optimization,
+ * because we change the stack, and the BASEPAGE parameter
+ * is not accessible afterwards.
+ */
+#pragma GCC optimize "-Os"
+#pragma GCC optimize "-fomit-frame-pointer"
+
+static void __CDECL startup(BASEPAGE *b)
+{
+	int (*func)(long);
+	long arg;
+	BASEPAGE *parent;
+
+	parent = (BASEPAGE *)(__UINTPTR_TYPE__)b->p_parent;
+	_setstack((char *)(__UINTPTR_TYPE__)b->p_hitpa);
+	func = (int (*)(long))(__UINTPTR_TYPE__)b->p_dbase;
+	arg = b->p_dlen;
+
+	/* If this is a thread, it doesn't need
+	 * own copy of the environment, right?
+	 */
+	Mfree(b->p_env);
+	b->p_env = parent->p_env;
+
+	/* copy from parents basepage for debuggers... */
+	b->p_tbase = parent->p_tbase;
+	b->p_tlen = parent->p_tlen;
+	b->p_dbase = parent->p_dbase;
+	b->p_dlen = parent->p_dlen;
+	b->p_bbase = parent->p_bbase;
+	b->p_blen = parent->p_blen;
+
+	Pterm((*func)(arg));
+	__builtin_unreachable();
+}
+
+/* use long instead of int so vfork works OK with -mshort */
+long
+tfork(int (*func)(long), long arg)
+{
+	BASEPAGE *b;
+	long pid;
+	long savpending, savmask;
+	sighandler_t savhandler[NSIG];
+	long now;
+	int i;
+	long stacksize = THREAD_STACKSIZE;
+
+	b = (BASEPAGE *)Pexec(PE_CBASEPAGE, 0L, "", 0L);
+	if ((long)b <= 0)
+		return (long)b;
+	(void)Mshrink(b, stacksize + sizeof(*b));
+	b->p_tbase = (__UINT32_TYPE__)(__UINTPTR_TYPE__)startup;
+	b->p_dbase = (__UINT32_TYPE__)(__UINTPTR_TYPE__)func;
+	b->p_dlen = arg;
+	b->p_blen = stacksize;
+	b->p_hitpa = (__UINT32_TYPE__)(__UINTPTR_TYPE__)(((char *)b) + stacksize + sizeof(*b));
+
+	pid = Pexec(PE_ASYNC_GO, 0L, b, 0L);
+	if (pid == -ENOSYS)
+	{
+		/* save the signal masks and signal handlers,
+		 * the child may change them
+		 */
+		savpending = _sigpending;
+		_sigpending = 0;
+		savmask = _sigmask;
+		_sigmask = 0;
+		for (i = 0; i < NSIG; i++)
+			savhandler[i] = _sig_handler[i];
+
+		now = _clock();
+		pid = Pexec(PE_GO, 0L, b, 0L);
+
+		/* restore signal stuff */
+		for (i = 0; i < NSIG; i++)
+			_sig_handler[i] = savhandler[i];
+		_sigmask = savmask;
+		_sigpending = savpending;
+		if (pid >= 0)
+		{
+			long retval = pid;
+
+			/* see the TOS algorithm for getpid() */
+			pid = ((long)b) >> 8;
+			__waitval = (pid << 16) | retval;
+			raise(SIGCHLD);
+			__waittime = _clock() - now;
+			_childtime += __waittime;
+			/* child already terminated, but memory of basepage & env is still owned by us */
+			(void)Mfree(b->p_env);	/* free the memory */
+			(void)Mfree(b);
+		}
+	}
+	if (pid < 0)
+	{
+		(void)Mfree(b->p_env);	/* free the memory */
+		(void)Mfree(b);
+	}
+	/* memory of basepage & env is now owned by child */
+	return pid;
+}
diff --git a/tos-api/src/bdos/mem/region.rs b/tos-api/src/bdos/mem/region.rs
new file mode 100644
index 0000000..02015e6
--- /dev/null
+++ b/tos-api/src/bdos/mem/region.rs
@@ -0,0 +1,364 @@
+//! Blocks with several owners — FreeMiNT's region links on top of EmuTOS'
+//! `m_own` (ARCH03 stage 2d, plan Frage 6 / §3.4, decision E15).
+//!
+//! Spec: `docs/api/gemdos/memory/49-mfree.md` § "several owners, and only an
+//! owner frees"; `docs/api/gemdos/process/4b-pexec.md` (NewTOS notes, 2d).
+//!
+//! ## Model
+//!
+//! FreeMiNT gives a memory region a `links` count; every process (memory
+//! space) that has the region attached holds one link, `Mfree` detaches the
+//! caller, and the region goes back to the pool when `links` reaches 0
+//! (`sys/memory.c:512-660` `attach_region`/`detach_region`,
+//! `sys/dosmem.c:330-398` `sys_m_free`). EmuTOS has one owner per block, the
+//! `m_own` tag, which decides what `Pterm` frees (`bdos/proc.c:92-101`).
+//!
+//! NewTOS keeps `m_own` as the **first** owner — the EmuTOS tag, unchanged
+//! for every block that has one owner, which is every block but a few — and
+//! records the **further** owners of a block here, keyed by its start
+//! address. A block's links are `1 + its further owners`. Owners are PD
+//! pointers (or the kernel / TSR sentinels), the same cookies `m_own` holds.
+//!
+//! Today further owners come only from `Pexec` 4/6 (the started child
+//! attaches to its basepage and environment, FreeMiNT `sys/k_exec.c:518-520`),
+//! so the table is small; it is a fixed array (no allocator under the BDOS).
+//!
+//! ## Invariants
+//!
+//! * An entry names an allocated block; whoever frees a block forgets its
+//!   entry ([`forget`] — every free path in `traps` and the sweeps here).
+//!   A fresh allocation clears a stale one as well (`traps::mxalloc`).
+//! * An owner appears at most once per block (as `m_own` or in the entry).
+//! * Callers hold the BDOS giant lock.
+
+use core::cell::UnsafeCell;
+use core::ffi::c_void;
+use core::ptr;
+
+use tos_types::{Long, MD};
+
+use super::init::{is_initialised, pmd, pmdalt};
+use super::traps;
+
+/// Blocks that can have further owners at the same time. Each running
+/// `Pexec` 4/6 child needs two (basepage, environment); 16 processes at most.
+pub const MAX_SHARED_BLOCKS: usize = 64;
+
+/// Further owners per block (besides `m_own`).
+pub const MAX_FURTHER_OWNERS: usize = 4;
+
+#[derive(Copy, Clone)]
+struct Entry {
+    /// Block start (`m_start`); `0` = unused entry.
+    loc: Long,
+    /// Further owners; `null` = unused place.
+    owners: [*mut c_void; MAX_FURTHER_OWNERS],
+}
+
+const EMPTY: Entry = Entry {
+    loc: 0,
+    owners: [ptr::null_mut(); MAX_FURTHER_OWNERS],
+};
+
+struct Table(UnsafeCell<[Entry; MAX_SHARED_BLOCKS]>);
+// SAFETY: accessed only under the BDOS giant lock (single CPU, trap path).
+unsafe impl Sync for Table {}
+static TABLE: Table = Table(UnsafeCell::new([EMPTY; MAX_SHARED_BLOCKS]));
+
+/// # Safety
+///
+/// BDOS giant lock held; no other borrow of the table alive.
+unsafe fn table() -> &'static mut [Entry; MAX_SHARED_BLOCKS] {
+    // SAFETY: caller contract.
+    unsafe { &mut *TABLE.0.get() }
+}
+
+/// Why an ownership operation was refused.
+#[derive(Copy, Clone, Debug, Eq, PartialEq)]
+pub enum RegionError {
+    /// `addr` starts no allocated block.
+    NoBlock,
+    /// The caller is not an owner of the block.
+    NotOwner,
+    /// No room to record another owner ([`MAX_SHARED_BLOCKS`] /
+    /// [`MAX_FURTHER_OWNERS`]).
+    Full,
+}
+
+/// What dropping an owner did to the block.
+#[derive(Copy, Clone, Debug, Eq, PartialEq)]
+pub enum Detached {
+    /// It was the last owner: the block is back in the pool.
+    Freed,
+    /// Another owner still holds the block.
+    Kept,
+}
+
+/// The allocated block starting at `addr` (its MD), on either pool.
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+unsafe fn block(addr: Long) -> Option<*mut MD> {
+    if addr == 0 || !is_initialised() {
+        return None;
+    }
+    for mp in [pmd(), pmdalt()] {
+        // SAFETY: lock held; read-only list walk.
+        let mut m = unsafe { (*mp).mp_mal };
+        while !m.is_null() {
+            // SAFETY: list invariant.
+            unsafe {
+                if (*m).m_start == addr {
+                    return Some(m);
+                }
+                m = (*m).m_link;
+            }
+        }
+    }
+    None
+}
+
+fn entry_of(t: &mut [Entry; MAX_SHARED_BLOCKS], addr: Long) -> Option<&mut Entry> {
+    t.iter_mut().find(|e| e.loc == addr && addr != 0)
+}
+
+/// Is `who` an owner of the block at `addr` (`m_own` or a further owner)?
+/// `false` for an address that starts no block.
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn is_owner(addr: Long, who: *mut c_void) -> bool {
+    if who.is_null() {
+        return false;
+    }
+    // SAFETY: lock held.
+    let Some(m) = (unsafe { block(addr) }) else {
+        return false;
+    };
+    // SAFETY: `m` is on `mp_mal`.
+    if unsafe { (*m).m_own } == who {
+        return true;
+    }
+    // SAFETY: lock held.
+    let t = unsafe { table() };
+    entry_of(t, addr).is_some_and(|e| e.owners.contains(&who))
+}
+
+/// Make `who` an owner of the block at `addr` — FreeMiNT `attach_region`.
+/// Nothing to do if it is one already.
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn attach(addr: Long, who: *mut c_void) -> Result<(), RegionError> {
+    // SAFETY: lock held.
+    let m = unsafe { block(addr) }.ok_or(RegionError::NoBlock)?;
+    // SAFETY: `m` is on `mp_mal`.
+    if who.is_null() || unsafe { (*m).m_own } == who {
+        return Ok(());
+    }
+    // SAFETY: lock held.
+    let t = unsafe { table() };
+    if entry_of(t, addr).is_none() {
+        let free = t.iter_mut().find(|e| e.loc == 0).ok_or(RegionError::Full)?;
+        *free = Entry { loc: addr, ..EMPTY };
+    }
+    let e = entry_of(t, addr).ok_or(RegionError::Full)?;
+    if e.owners.contains(&who) {
+        return Ok(());
+    }
+    let place = e.owners.iter_mut().find(|o| o.is_null()).ok_or(RegionError::Full)?;
+    *place = who;
+    Ok(())
+}
+
+/// Drop `who` from the block at `addr` — FreeMiNT `detach_region`: if it was
+/// the last owner the block is freed ([`Detached::Freed`]); if it held the
+/// EmuTOS tag and another owner is left, that owner takes the tag.
+///
+/// # Errors
+///
+/// [`RegionError::NoBlock`] / [`RegionError::NotOwner`]; nothing changes.
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn detach(addr: Long, who: *mut c_void) -> Result<Detached, RegionError> {
+    // SAFETY: lock held.
+    let m = unsafe { block(addr) }.ok_or(RegionError::NoBlock)?;
+    // SAFETY: lock held.
+    let t = unsafe { table() };
+    let further = entry_of(t, addr);
+    // A further owner: drop its place.
+    if let Some(e) = further {
+        if let Some(o) = e.owners.iter_mut().find(|o| **o == who && !who.is_null()) {
+            *o = ptr::null_mut();
+            if e.owners.iter().all(|o| o.is_null()) {
+                *e = EMPTY;
+            }
+            return Ok(Detached::Kept);
+        }
+    }
+    // SAFETY: `m` is on `mp_mal`.
+    if who.is_null() || unsafe { (*m).m_own } != who {
+        return Err(RegionError::NotOwner);
+    }
+    // The tag holder: pass the tag on, or free the block.
+    if let Some(e) = entry_of(t, addr) {
+        if let Some(o) = e.owners.iter_mut().find(|o| !o.is_null()) {
+            // SAFETY: `m` is on `mp_mal`.
+            unsafe { (*m).m_own = *o };
+            *o = ptr::null_mut();
+            if e.owners.iter().all(|o| o.is_null()) {
+                *e = EMPTY;
+            }
+            return Ok(Detached::Kept);
+        }
+    }
+    // SAFETY: lock held; `addr` starts an allocated block.
+    let _ = unsafe { traps::mfree(addr) };
+    Ok(Detached::Freed)
+}
+
+/// Hand the block at `addr` from `from` to `to`: `to` becomes an owner and
+/// `from` stops being one — FreeMiNT's `Pexec` 6 (`attach_region(child)`,
+/// then `mkfree` → `detach_region(parent)`, `sys/k_exec.c:518-520,586-590`),
+/// EmuTOS' `set_owner(p, p)` (`bdos/proc.c:238-242`). A block `from` does not
+/// own only gains `to`.
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn hand_over(addr: Long, from: *mut c_void, to: *mut c_void) -> Result<(), RegionError> {
+    // SAFETY: lock held.
+    unsafe { attach(addr, to)? };
+    // SAFETY: lock held. `to` holds a link now, so this never frees.
+    match unsafe { detach(addr, from) } {
+        Ok(_) | Err(RegionError::NotOwner) => Ok(()),
+        Err(e) => Err(e),
+    }
+}
+
+/// The block at `addr` was freed (by any path): forget its further owners.
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn forget(addr: Long) {
+    // SAFETY: lock held.
+    let t = unsafe { table() };
+    if let Some(e) = entry_of(t, addr) {
+        *e = EMPTY;
+    }
+}
+
+/// `Pterm`: drop `who` from every block it owns — freeing what nobody else
+/// owns, passing the EmuTOS tag on where somebody does. Returns the number
+/// of blocks freed. With one owner per block this is EmuTOS'
+/// `free_all_owned` (`bdos/proc.c:92-101`) exactly.
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn detach_all(who: *mut c_void) -> usize {
+    if who.is_null() || !is_initialised() {
+        return 0;
+    }
+    // Its further-owner places first: they never free anything.
+    // SAFETY: lock held.
+    for e in unsafe { table() }.iter_mut().filter(|e| e.loc != 0) {
+        for o in e.owners.iter_mut().filter(|o| **o == who) {
+            *o = ptr::null_mut();
+        }
+        if e.owners.iter().all(|o| o.is_null()) {
+            *e = EMPTY;
+        }
+    }
+    // Then every block it holds the tag of.
+    let mut freed = 0;
+    for mp in [pmd(), pmdalt()] {
+        // SAFETY: lock held; `next` is read before `detach` may free `m`
+        // (freeing only touches the free list, `free_all_owned` module docs).
+        let mut m = unsafe { (*mp).mp_mal };
+        while !m.is_null() {
+            // SAFETY: list invariant.
+            let (next, start, own) = unsafe { ((*m).m_link, (*m).m_start, (*m).m_own) };
+            if own == who {
+                // SAFETY: lock held; `start` starts a block `who` owns.
+                if let Ok(Detached::Freed) = unsafe { detach(start, who) } {
+                    freed += 1;
+                }
+            }
+            m = next;
+        }
+    }
+    freed
+}
+
+/// `Ptermres`: every link `who` holds passes to the TSR holder
+/// ([`traps::tsr_owner`]) — its blocks stay allocated and owned (FreeMiNT
+/// keeps the TSR's regions attached in `TSR_Q`, `sys/k_exit.c:307-336`).
+/// Returns the number of blocks whose EmuTOS tag it held.
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn keep_resident(who: *mut c_void) -> usize {
+    if who.is_null() || !is_initialised() {
+        return 0;
+    }
+    let tsr = traps::tsr_owner();
+    // SAFETY: lock held.
+    for e in unsafe { table() }.iter_mut().filter(|e| e.loc != 0) {
+        let had_tsr = e.owners.contains(&tsr);
+        for o in e.owners.iter_mut().filter(|o| **o == who) {
+            *o = if had_tsr { ptr::null_mut() } else { tsr };
+        }
+        if e.owners.iter().all(|o| o.is_null()) {
+            *e = EMPTY;
+        }
+    }
+    let mut kept = 0;
+    for mp in [pmd(), pmdalt()] {
+        // SAFETY: lock held.
+        let mut m = unsafe { (*mp).mp_mal };
+        while !m.is_null() {
+            // SAFETY: list invariant.
+            unsafe {
+                if (*m).m_own == who {
+                    (*m).m_own = tsr;
+                    kept += 1;
+                    // The TSR holder may already be a further owner: one link.
+                    if let Some(e) = entry_of(table(), (*m).m_start) {
+                        for o in e.owners.iter_mut().filter(|o| **o == tsr) {
+                            *o = ptr::null_mut();
+                        }
+                        if e.owners.iter().all(|o| o.is_null()) {
+                            *e = EMPTY;
+                        }
+                    }
+                }
+                m = (*m).m_link;
+            }
+        }
+    }
+    kept
+}
+
+/// Number of owners of the block at `addr` (FreeMiNT's `links`): `0` if it
+/// starts no block. For tests and diagnostics.
+///
+/// # Safety
+///
+/// BDOS giant lock held.
+pub unsafe fn links(addr: Long) -> usize {
+    // SAFETY: lock held.
+    if unsafe { block(addr) }.is_none() {
+        return 0;
+    }
+    // SAFETY: lock held.
+    let t = unsafe { table() };
+    1 + entry_of(t, addr).map_or(0, |e| e.owners.iter().filter(|o| !o.is_null()).count())
+}
diff --git a/tos-api/tests/arch03_pexec_567_ptermres.rs b/tos-api/tests/arch03_pexec_567_ptermres.rs
new file mode 100644
index 0000000..d3e840c
--- /dev/null
+++ b/tos-api/tests/arch03_pexec_567_ptermres.rs
@@ -0,0 +1,225 @@
+//! ARCH03 stage 2b/2c on the host: the parts of `Pexec` 4/5/6/7 and
+//! `Ptermres` that are bookkeeping, not memory copies.
+//!
+//! Sources: EmuTOS `bdos/proc.c` — `xexec` modes 5/6/7 (`:210-248`), the
+//! unknown-mode default (`:252-253`), `proc_go` starting at `p_tbase` on a
+//! stack at `p_hitpa` (`:544,548`), `set_owner(p, p); set_owner(p->p_env, p)`
+//! for mode 6 (`:238-242`); `xtermres` (`:624-634`) — the blocks survive. The
+//! TSR holder owning them on the allocated list is FreeMiNT's `TSR_Q`
+//! (`sys/k_exit.c:307-336`, plan §3.8). Spec: `docs/api/gemdos/process/
+//! 4b-pexec.md`, `31-ptermres.md` (NewTOS notes).
+//!
+//! The pools are bookkeeping only (their addresses are never dereferenced);
+//! a basepage the code under test reads is a host buffer, as in
+//! `arch03_shared_space.rs`.
+
+use std::sync::atomic::Ordering;
+use std::sync::{Mutex, MutexGuard, Once};
+
+use tos_api::bdos::mem::free_all_owned::reserve_all_owned;
+use tos_api::bdos::mem::{init, traps};
+use tos_api::bdos::process::loader::EnvSpec;
+use tos_api::bdos::process::pexec::{self, PexecError};
+use tos_api::bdos::process::{self, Disposition, State, PROCESS_TABLE};
+use tos_types::error::{EIMBA, EINVFN};
+use tos_types::{BasePage, MD, MX_STRAM, MX_TTRAM};
+
+
+const ST_START: u64 = 0x0040_0000;
+const ST_LEN: u64 = 10 * 1024 * 1024;
+const TT_START: u64 = 0x0100_0000;
+const TT_LEN: u64 = 64 * 1024 * 1024;
+
+static LOCK: Mutex<()> = Mutex::new(());
+static SETUP: Once = Once::new();
+
+fn lock() -> MutexGuard<'static, ()> {
+    let g = LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    SETUP.call_once(|| {
+        // SAFETY: once per binary, before any allocation.
+        unsafe { init::init(ST_START, ST_LEN, TT_START, TT_LEN) }.expect("the test pools");
+    });
+    g
+}
+
+/// The MD of the allocated block at `addr`, if any.
+fn md_of(addr: i32) -> Option<*mut MD> {
+    for mp in [init::pmd(), init::pmdalt()] {
+        // SAFETY: under the lock; read-only walk.
+        let mut m = unsafe { (*mp).mp_mal };
+        while !m.is_null() {
+            // SAFETY: list invariant.
+            unsafe {
+                if (*m).m_start == addr {
+                    return Some(m);
+                }
+                m = (*m).m_link;
+            }
+        }
+    }
+    None
+}
+
+fn owner_of(addr: i32) -> *mut core::ffi::c_void {
+    // SAFETY: under the lock.
+    unsafe { (*md_of(addr).expect("allocated")).m_own }
+}
+
+/// A slot in the "loaded, not started" state with a host basepage, as
+/// `Pexec` 3 or 5 leaves it.
+struct Unstarted {
+    slot: usize,
+    bp: *mut BasePage,
+}
+impl Unstarted {
+    fn new(entry_va: u64, fill: impl FnOnce(&mut BasePage)) -> Self {
+        let slot = process::allocate_slot().expect("a slot");
+        let bp = Box::into_raw(Box::new([0u8; 256])) as *mut BasePage;
+        // SAFETY: a fresh, exclusively owned 256-byte, 4-aligned buffer.
+        fill(unsafe { &mut *bp });
+        let p = &PROCESS_TABLE[slot];
+        p.basepage_kva.store(bp, Ordering::Release);
+        p.entry_va.store(entry_va, Ordering::Release);
+        p.sp_el0.store(if entry_va != 0 { 0x0123_0000 } else { 0 }, Ordering::Release);
+        Unstarted { slot, bp }
+    }
+    fn pd(&self) -> u64 {
+        self.bp as u64
+    }
+}
+impl Drop for Unstarted {
+    fn drop(&mut self) {
+        process::free_slot(self.slot);
+        // SAFETY: the slot no longer names the box.
+        drop(unsafe { Box::from_raw(self.bp as *mut [u8; 256]) });
+    }
+}
+
+#[test]
+fn an_unknown_mode_is_einvfn_and_5_6_7_are_known() {
+    let _g = lock();
+    // SAFETY: under the lock.
+    let e = unsafe { pexec::dispatch(8, &[], 0, 0, &[], EnvSpec::None) }.unwrap_err();
+    assert_eq!(e, PexecError::UnknownMode);
+    assert_eq!(e.errno(), EINVFN);
+    for m in [1u16, 2, 50, 100, 104, 106, 200] {
+        // SAFETY: under the lock.
+        let e = unsafe { pexec::dispatch(m, &[], 0, 0, &[], EnvSpec::None) }.unwrap_err();
+        assert_eq!(e, PexecError::UnknownMode, "mode {m}");
+    }
+    assert_eq!((pexec::PE_BASEPAGE, pexec::PE_GOTHENFREE, pexec::PE_BASEPAGEFLAGS), (5, 6, 7));
+}
+
+#[test]
+fn go_takes_only_an_unstarted_pd() {
+    let _g = lock();
+    let u = Unstarted::new(0, |bp| bp.p_tbase = 0x0123_4000);
+    for then_free in [false, true] {
+        // SAFETY: under the lock.
+        let e = unsafe { pexec::go(u.pd() + 0x100, then_free) }.unwrap_err();
+        assert_eq!(e.errno(), EIMBA, "not a PD");
+        // SAFETY: under the lock.
+        let e = unsafe { pexec::go(0, then_free) }.unwrap_err();
+        assert_eq!(e.errno(), EIMBA, "null");
+    }
+    // A slot that is running (or in the run-set) is not "unstarted".
+    PROCESS_TABLE[u.slot].set_state(State::Running);
+    // SAFETY: under the lock.
+    assert_eq!(unsafe { pexec::go(u.pd(), false) }.unwrap_err(), PexecError::BadHandle);
+    PROCESS_TABLE[u.slot].set_state(State::Loaded);
+}
+
+#[test]
+fn a_basepage_without_an_image_starts_at_p_tbase_on_p_hitpa() {
+    let mut b = [0u8; 256];
+    // SAFETY: a 256-byte, 4-aligned-enough local buffer read as a BasePage.
+    let bp = unsafe { &mut *(b.as_mut_ptr() as *mut BasePage) };
+    bp.p_tbase = 0x0123_4560;
+    bp.p_hitpa = 0x0040_1107;
+    assert_eq!(
+        pexec::start_of(0, bp),
+        (0x0123_4560, 0x0040_1100),
+        "proc_go: retaddr = p_tbase, stack at p_hitpa (16-aligned)"
+    );
+}
+
+#[test]
+fn a_loaded_program_keeps_its_elf_entry_and_takes_the_stack_at_p_hitpa() {
+    let mut b = [0u8; 256];
+    // SAFETY: as above.
+    let bp = unsafe { &mut *(b.as_mut_ptr() as *mut BasePage) };
+    bp.p_tbase = 0x0200_0fc0;
+    bp.p_hitpa = 0x0240_0000;
+    // The ELF entry, but the stack where p_hitpa is now: the shell idiom
+    // lowers it after Mshrink, and proc_go builds the stack there (:544).
+    assert_eq!(pexec::start_of(0x0200_1000, bp), (0x0200_1000, 0x0240_0000));
+    bp.p_hitpa = 0x0204_3008;
+    assert_eq!(pexec::start_of(0x0200_1000, bp), (0x0200_1000, 0x0204_3000));
+}
+
+#[test]
+fn go_refuses_a_pd_its_caller_does_not_own() {
+    let _g = lock();
+    // The host basepage is no pool block, so nobody owns it (E15): refused
+    // although the slot is waiting to be started.
+    let u = Unstarted::new(0, |bp| bp.p_tbase = 0x0123_4000);
+    for then_free in [false, true] {
+        // SAFETY: under the lock.
+        let e = unsafe { pexec::go(u.pd(), then_free) }.unwrap_err();
+        assert_eq!(e, PexecError::BadHandle);
+        assert_eq!(e.errno(), EIMBA);
+    }
+}
+
+#[test]
+fn ptermres_keeps_every_owned_block_allocated_under_the_tsr_holder() {
+    let _g = lock();
+    let tsr = 0x7ff0_0000usize as *mut core::ffi::c_void; // a PD cookie
+    let other = 0x7fe0_0000usize as *mut core::ffi::c_void;
+    // SAFETY: under the lock.
+    let (a, b, c) = unsafe {
+        (traps::mxalloc(256, MX_STRAM), traps::mxalloc(4096, MX_TTRAM), traps::mxalloc(32, MX_STRAM))
+    };
+    // SAFETY: under the lock.
+    unsafe {
+        traps::set_owner(a, tsr);
+        traps::set_owner(b, tsr);
+        traps::set_owner(c, other);
+    }
+    // SAFETY: under the lock.
+    assert_eq!(unsafe { reserve_all_owned(tsr) }, 2);
+    for blk in [a, b] {
+        assert!(traps::is_resident(owner_of(blk)), "0x{blk:x} kept by the TSR holder");
+        // SAFETY: under the lock.
+        assert!(unsafe { traps::is_allocated(blk as u64) }, "still allocated");
+    }
+    assert_eq!(owner_of(c), other, "someone else's block is untouched");
+    // A later Pterm of the same PD finds nothing to free.
+    // SAFETY: under the lock.
+    assert_eq!(unsafe { tos_api::bdos::mem::free_all_owned::free_all_owned(tsr) }, 0);
+    assert!(!traps::is_resident(traps::current_owner()));
+    // SAFETY: under the lock.
+    unsafe {
+        traps::mfree(a);
+        traps::mfree(b);
+        traps::mfree(c);
+    }
+}
+
+#[test]
+fn a_terminate_disposition_carries_ptermres_blkln() {
+    for (rc, reserve) in [
+        (0, None),
+        (0xFFFF, None),
+        (0x31, Some(0)),
+        (0x31, Some(0x2A40)),
+        (7, Some(-1)),
+        (0xFFFF, Some(i32::MAX)),
+        (1, Some(i32::MIN)),
+    ] {
+        let d = Disposition::Terminate { rc, reserve };
+        assert_eq!(Disposition::decode(d.encode()), d, "rc {rc} reserve {reserve:?}");
+    }
+    assert_eq!(Disposition::decode(0), Disposition::Resume);
+    assert_eq!(Disposition::decode(Disposition::UserdefReturn.encode()), Disposition::UserdefReturn);
+}
diff --git a/tos-api/tests/arch03_region_owners.rs b/tos-api/tests/arch03_region_owners.rs
new file mode 100644
index 0000000..92c0a2a
--- /dev/null
+++ b/tos-api/tests/arch03_region_owners.rs
@@ -0,0 +1,312 @@
+//! ARCH03 stage 2d (plan Frage 6 / §3.4, decision E15): a block can have
+//! several owners, and only an owner frees it.
+//!
+//! Sources: FreeMiNT `sys/memory.c:512-660` (`attach_region` increments a
+//! region's `links`, `detach_region` decrements it and frees the region at
+//! 0), `sys/dosmem.c:330-455` (`Mfree`/`Mshrink` find only the caller's
+//! regions, `EFAULT` = −40 otherwise), `sys/k_exec.c:518-520,586-590` (the
+//! started child attaches to basepage and environment; mode 6 detaches the
+//! parent), `sys/k_exit.c:307-336` (a TSR keeps its regions). EmuTOS
+//! `bdos/proc.c:92-101` (`free_all_owned` by `m_own`) is the one-owner case.
+//! Spec: `docs/api/gemdos/memory/49-mfree.md` § "several owners".
+//!
+//! The pools are bookkeeping only (addresses never dereferenced); a process
+//! that calls GEMDOS is a host basepage in a claimed slot, as in
+//! `arch03_shared_space.rs`.
+
+use std::sync::atomic::Ordering;
+use std::sync::{Mutex, MutexGuard, Once};
+
+use tos_api::bdos::mem::free_all_owned::{free_all_owned, reserve_all_owned};
+use tos_api::bdos::mem::region::{self, Detached, RegionError, MAX_FURTHER_OWNERS};
+use tos_api::bdos::mem::{init, traps};
+use tos_api::bdos::process::{self, PROCESS_TABLE};
+use tos_api::trap::TrapArgs;
+use tos_types::error::{EIMBA, E_OK};
+use tos_types::{BasePage, Long, MD, MX_STRAM, MX_TTRAM};
+
+static LOCK: Mutex<()> = Mutex::new(());
+static SETUP: Once = Once::new();
+
+fn lock() -> MutexGuard<'static, ()> {
+    let g = LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    SETUP.call_once(|| {
+        // SAFETY: once per binary, before any allocation.
+        unsafe { init::init(0x0040_0000, 10 << 20, 0x0100_0000, 64 << 20) }.expect("pools");
+    });
+    g
+}
+
+type Who = *mut core::ffi::c_void;
+const A: Who = 0x7a00_0000usize as Who;
+const B: Who = 0x7b00_0000usize as Who;
+const C: Who = 0x7c00_0000usize as Who;
+
+fn alloc(owner: Who) -> Long {
+    // SAFETY: under the lock.
+    unsafe {
+        let a = traps::mxalloc(256, MX_STRAM);
+        assert_ne!(a, 0);
+        traps::set_owner(a, owner);
+        a
+    }
+}
+
+fn m_own(addr: Long) -> Option<Who> {
+    for mp in [init::pmd(), init::pmdalt()] {
+        // SAFETY: under the lock; read-only walk.
+        let mut m: *mut MD = unsafe { (*mp).mp_mal };
+        while !m.is_null() {
+            // SAFETY: list invariant.
+            unsafe {
+                if (*m).m_start == addr {
+                    return Some((*m).m_own);
+                }
+                m = (*m).m_link;
+            }
+        }
+    }
+    None
+}
+
+#[test]
+fn one_owner_frees_like_emutos_and_a_stranger_cannot() {
+    let _g = lock();
+    let x = alloc(A);
+    // SAFETY: under the lock (all `region` calls below).
+    unsafe {
+        assert_eq!(region::links(x), 1);
+        assert!(region::is_owner(x, A) && !region::is_owner(x, B));
+        assert_eq!(region::detach(x, B), Err(RegionError::NotOwner));
+        assert_eq!(m_own(x), Some(A), "untouched");
+        assert_eq!(region::detach(x, A), Ok(Detached::Freed));
+        assert_eq!(m_own(x), None, "back in the pool");
+        assert_eq!(region::detach(x, A), Err(RegionError::NoBlock));
+    }
+}
+
+#[test]
+fn a_second_owner_keeps_the_block_alive_and_takes_the_tag() {
+    let _g = lock();
+    let x = alloc(A);
+    // SAFETY: under the lock.
+    unsafe {
+        assert_eq!(region::attach(x, B), Ok(()));
+        assert_eq!(region::attach(x, B), Ok(()), "attaching twice is one link");
+        assert_eq!(region::attach(x, A), Ok(()), "the tag holder is an owner already");
+        assert_eq!(region::links(x), 2);
+        // The tag holder leaves: B takes the EmuTOS tag, nothing is freed.
+        assert_eq!(region::detach(x, A), Ok(Detached::Kept));
+        assert_eq!(m_own(x), Some(B));
+        assert_eq!(region::links(x), 1);
+        assert!(!region::is_owner(x, A));
+        assert_eq!(region::detach(x, B), Ok(Detached::Freed));
+    }
+}
+
+#[test]
+fn a_further_owner_leaving_frees_nothing() {
+    let _g = lock();
+    let x = alloc(A);
+    // SAFETY: under the lock.
+    unsafe {
+        region::attach(x, B).unwrap();
+        assert_eq!(region::detach(x, B), Ok(Detached::Kept));
+        assert_eq!((m_own(x), region::links(x)), (Some(A), 1));
+        assert_eq!(region::detach(x, A), Ok(Detached::Freed));
+    }
+}
+
+#[test]
+fn hand_over_is_pexec_6() {
+    let _g = lock();
+    let x = alloc(A);
+    // SAFETY: under the lock.
+    unsafe {
+        region::hand_over(x, A, B).unwrap();
+        assert_eq!((m_own(x), region::links(x)), (Some(B), 1), "set_owner(p, p)");
+        // From someone who did not own it: the child only gains it.
+        region::hand_over(x, C, A).unwrap();
+        assert_eq!(region::links(x), 2);
+        region::detach(x, A).unwrap();
+        assert_eq!(region::detach(x, B), Ok(Detached::Freed));
+    }
+}
+
+#[test]
+fn pterm_drops_the_process_everywhere_and_frees_only_its_own() {
+    let _g = lock();
+    let parents = alloc(A); // the child's TPA, say: the parent owns it
+    let childs = alloc(B); // the child's Malloc
+    // SAFETY: under the lock.
+    unsafe {
+        region::attach(parents, B).unwrap(); // Pexec 4 attached the child
+        assert_eq!(free_all_owned(B), 1, "only its own block is freed");
+        assert_eq!(m_own(childs), None);
+        assert_eq!((m_own(parents), region::links(parents)), (Some(A), 1), "the parent keeps its");
+        // And when the child held the tag of a shared block, the tag moves.
+        let shared = alloc(B);
+        region::attach(shared, A).unwrap();
+        assert_eq!(free_all_owned(B), 0);
+        assert_eq!((m_own(shared), region::links(shared)), (Some(A), 1));
+        assert_eq!(free_all_owned(A), 2);
+        assert_eq!(m_own(parents), None);
+    }
+}
+
+#[test]
+fn ptermres_hands_every_link_to_the_tsr_holder() {
+    let _g = lock();
+    let own = alloc(A);
+    let shared = alloc(C);
+    // SAFETY: under the lock.
+    unsafe {
+        region::attach(shared, A).unwrap();
+        assert_eq!(reserve_all_owned(A), 1);
+        let tsr = traps::tsr_owner();
+        assert_eq!(m_own(own), Some(tsr));
+        assert!(region::is_owner(shared, tsr), "the TSR keeps its link to a shared block");
+        assert_eq!(region::links(shared), 2);
+        assert!(!region::is_owner(own, A) && !region::is_owner(shared, A));
+        // Nothing of A is left to free.
+        assert_eq!(free_all_owned(A), 0);
+        // C lets go: the TSR holder keeps the shared block alive.
+        assert_eq!(region::detach(shared, C), Ok(Detached::Kept));
+        assert_eq!(m_own(shared), Some(tsr));
+        traps::mfree(own);
+        traps::mfree(shared);
+    }
+}
+
+#[test]
+fn a_freed_block_forgets_its_owners_and_a_new_one_starts_alone() {
+    let _g = lock();
+    let x = alloc(A);
+    // SAFETY: under the lock.
+    unsafe {
+        region::attach(x, B).unwrap();
+        // A kernel-internal free (no owner check) forgets the further owner.
+        assert_eq!(traps::mfree(x), E_OK);
+        let y = traps::mxalloc(256, MX_STRAM);
+        assert_eq!(y, x, "first fit hands out the same address again");
+        assert_eq!(region::links(y), 1);
+        assert!(!region::is_owner(y, B));
+        traps::mfree(y);
+    }
+}
+
+#[test]
+fn owners_per_block_are_bounded() {
+    let _g = lock();
+    let x = alloc(A);
+    // SAFETY: under the lock.
+    unsafe {
+        for i in 0..MAX_FURTHER_OWNERS {
+            region::attach(x, (0x7100_0000 + i * 0x1000) as Who).unwrap();
+        }
+        assert_eq!(region::attach(x, C), Err(RegionError::Full));
+        assert_eq!(region::links(x), 1 + MAX_FURTHER_OWNERS);
+        traps::mfree(x);
+    }
+}
+
+// ── at the GEMDOS interface ────────────────────────────────────────────
+
+struct Proc {
+    slot: usize,
+    bp: *mut BasePage,
+}
+impl Proc {
+    fn new() -> Proc {
+        let slot = process::allocate_slot().expect("a slot");
+        let bp = Box::into_raw(Box::new([0u8; 256])) as *mut BasePage;
+        PROCESS_TABLE[slot].basepage_kva.store(bp, Ordering::Release);
+        Proc { slot, bp }
+    }
+    fn run(&self) {
+        process::set_current(process::pd_of(self.slot));
+    }
+    fn pd(&self) -> Who {
+        process::pd_of(self.slot).cast()
+    }
+}
+impl Drop for Proc {
+    fn drop(&mut self) {
+        process::set_current(std::ptr::null_mut());
+        process::free_slot(self.slot);
+        // SAFETY: the slot no longer names the box.
+        drop(unsafe { Box::from_raw(self.bp as *mut [u8; 256]) });
+    }
+}
+
+fn gemdos(func: u64, a: [u64; 3]) -> Long {
+    let args = TrapArgs { regs: [a[0], a[1], a[2], 0, 0, 0, 0, 0], func, svc_imm: 1 };
+    match func {
+        0x44 => tos_api::gemdos::memory::mxalloc(&args),
+        0x49 => tos_api::gemdos::memory::mfree(&args),
+        0x4A => tos_api::gemdos::memory::mshrink(&args),
+        _ => unreachable!(),
+    }
+}
+
+#[test]
+fn mfree_and_mshrink_only_for_an_owner() {
+    let _g = lock();
+    let p = Proc::new();
+    let q = Proc::new();
+    p.run();
+    let blk = gemdos(0x44, [4096, MX_TTRAM as u64, 0]);
+    assert_eq!(m_own(blk), Some(p.pd()));
+    q.run();
+    assert_eq!(gemdos(0x49, [blk as u64, 0, 0]), EIMBA, "Mfree of another's block (E15)");
+    assert_eq!(gemdos(0x4A, [0, blk as u64, 64]), EIMBA, "Mshrink of another's block");
+    assert_eq!(gemdos(0x4A, [0, blk as u64, 0]), EIMBA, "Mshrink(0) follows Mfree");
+    assert_eq!(m_own(blk), Some(p.pd()), "untouched");
+    // A shared block: q attached (a Pexec 4 child) — q's Mfree drops q only.
+    // SAFETY: under the lock.
+    unsafe { region::attach(blk, q.pd()).unwrap() };
+    assert_eq!(gemdos(0x4A, [0, blk as u64, 2048]), E_OK, "an owner shrinks");
+    assert_eq!(gemdos(0x49, [blk as u64, 0, 0]), E_OK);
+    assert_eq!(m_own(blk), Some(p.pd()), "still p's");
+    assert_eq!(gemdos(0x49, [blk as u64, 0, 0]), EIMBA, "q is no owner any more");
+    p.run();
+    assert_eq!(gemdos(0x49, [blk as u64, 0, 0]), E_OK);
+    assert_eq!(m_own(blk), None, "freed with its last owner");
+    assert_eq!(gemdos(0x49, [blk as u64, 0, 0]), EIMBA, "double free");
+}
+
+#[test]
+fn a_pexec_4_child_owns_what_its_caller_owns() {
+    let _g = lock();
+    let p = Proc::new();
+    let t = Proc::new();
+    p.run();
+    let blk = gemdos(0x44, [512, MX_STRAM as u64, 0]);
+    // t runs in p's memory space (plan E6, FreeMiNT FORK_SHAREVM).
+    PROCESS_TABLE[t.slot].space_pd.store(p.pd().cast(), Ordering::Release);
+    t.run();
+    assert_eq!(gemdos(0x4A, [0, blk as u64, 256]), E_OK, "the thread may shrink it");
+    assert_eq!(gemdos(0x49, [blk as u64, 0, 0]), E_OK, "and free it");
+    assert_eq!(m_own(blk), None);
+    // Without the shared space it may not.
+    p.run();
+    let blk2 = gemdos(0x44, [512, MX_STRAM as u64, 0]);
+    PROCESS_TABLE[t.slot].space_pd.store(std::ptr::null_mut(), Ordering::Release);
+    t.run();
+    assert_eq!(gemdos(0x49, [blk2 as u64, 0, 0]), EIMBA);
+    p.run();
+    assert_eq!(gemdos(0x49, [blk2 as u64, 0, 0]), E_OK);
+}
+
+#[test]
+fn resident_memory_is_nobodys_to_free() {
+    let _g = lock();
+    let p = Proc::new();
+    p.run();
+    let blk = gemdos(0x44, [128, MX_STRAM as u64, 0]);
+    // SAFETY: under the lock.
+    unsafe { reserve_all_owned(p.pd()) };
+    assert_eq!(gemdos(0x49, [blk as u64, 0, 0]), EIMBA, "a TSR's memory (EmuTOS: on no list)");
+    // SAFETY: under the lock; clean up for the other tests.
+    unsafe { traps::mfree(blk) };
+}
diff --git a/tos-api/tests/loader_prgflags.rs b/tos-api/tests/loader_prgflags.rs
new file mode 100644
index 0000000..5c9c84d
--- /dev/null
+++ b/tos-api/tests/loader_prgflags.rs
@@ -0,0 +1,206 @@
+//! ARCH03 stage 2a (plan E8b, user decision 2026-10-05): a NewTOS program
+//! carries its `PRGFLAGS` in an ELF note — owner `"NewTOS"`, type 1, one
+//! `u32` — instead of the `h01_flags` word of a `0x601A` PRG header.
+//!
+//! Sources the expectations come from:
+//! * the format definition, `docs/api/gemdos/process/4b-pexec.md` (NewTOS
+//!   notes, "`PRGFLAGS` of a NewTOS program"): 4-byte `namesz`/`descsz`/
+//!   `type` words, name and desc padded to the `PT_NOTE` alignment (4, or 8
+//!   for `p_align` 8) — the layout `rust-lld`/`llvm-readelf` use;
+//! * gABI ch5.pheader "Note Section" (`PT_NOTE` = 4; entries of other owners
+//!   are someone else's business);
+//! * EmuTOS `bdos/proc.c:283,292,313,425`: the flags choose the pool of the
+//!   environment and the TPA (`PF_TTRAMLOAD` → `MX_PREFTTRAM`, else
+//!   `MX_STRAM`) and become `p_flags`; an unloadable program is `EPLFMT`.
+
+use tos_api::bdos::process::elf::{self, ParseError, MAX_NOTE_BYTES, MAX_NOTE_SEGMENTS};
+use tos_api::bdos::process::loader::{self, LoadError};
+use tos_api::bdos::process::pexec::PexecError;
+use tos_types::error::EPLFMT;
+use tos_types::{MX_PREFTTRAM, MX_STRAM, PF_STANDARD, PF_TTRAMLOAD, PF_TTRAMMEM};
+
+const PT_LOAD: u32 = 1;
+const PT_NOTE: u32 = 4;
+
+/// One note entry: owner name (without the NUL), type, descriptor, padded
+/// to `align`.
+fn entry(name: &[u8], ntype: u32, desc: &[u8], align: usize) -> Vec<u8> {
+    let mut v = Vec::new();
+    let namesz = if name.is_empty() { 0 } else { name.len() + 1 };
+    v.extend_from_slice(&(namesz as u32).to_le_bytes());
+    v.extend_from_slice(&(desc.len() as u32).to_le_bytes());
+    v.extend_from_slice(&ntype.to_le_bytes());
+    v.extend_from_slice(name);
+    if namesz != 0 {
+        v.push(0);
+    }
+    while v.len() % align != 0 {
+        v.push(0);
+    }
+    v.extend_from_slice(desc);
+    while v.len() % align != 0 {
+        v.push(0);
+    }
+    v
+}
+
+fn prgflags_entry(v: u32, align: usize) -> Vec<u8> {
+    entry(b"NewTOS", 1, &v.to_le_bytes(), align)
+}
+
+#[test]
+fn the_sdk_note_reads_back_its_value_and_place() {
+    let n = prgflags_entry(0x1234_0007, 4);
+    assert_eq!(n.len(), 24, "12-byte header + \"NewTOS\\0\" padded to 8 + u32");
+    assert_eq!(elf::find_prgflags_note(&n, 4), Ok(Some((0x1234_0007, 20))));
+    // p_align 0 and 1 mean "no constraint": the same 4-byte layout.
+    assert_eq!(elf::find_prgflags_note(&n, 0), Ok(Some((0x1234_0007, 20))));
+    assert_eq!(elf::find_prgflags_note(&n, 1), Ok(Some((0x1234_0007, 20))));
+}
+
+#[test]
+fn an_eight_aligned_note_segment_pads_to_eight() {
+    let n = prgflags_entry(PF_TTRAMLOAD, 8);
+    assert_eq!(n.len(), 32, "header 12 + name padded to 24 + desc padded to 32");
+    assert_eq!(elf::find_prgflags_note(&n, 8), Ok(Some((PF_TTRAMLOAD, 24))));
+}
+
+#[test]
+fn notes_of_other_owners_and_types_are_skipped() {
+    let mut n = entry(b"GNU", 3, &[0xAB; 20], 4); // a build-id
+    n.extend(entry(b"NewTOS", 2, &[1, 2, 3, 4, 5, 6], 4)); // a future NewTOS type
+    n.extend(entry(b"", 7, &[], 4)); // nameless, empty
+    let at = n.len() + 20;
+    n.extend(prgflags_entry(5, 4));
+    assert_eq!(elf::find_prgflags_note(&n, 4), Ok(Some((5, at))));
+    // Without our entry: nothing found, nothing wrong.
+    let only_gnu = entry(b"GNU", 3, &[0; 20], 4);
+    assert_eq!(elf::find_prgflags_note(&only_gnu, 4), Ok(None));
+    assert_eq!(elf::find_prgflags_note(&[], 4), Ok(None));
+    // "NewTOSX" is somebody else.
+    assert_eq!(elf::find_prgflags_note(&entry(b"NewTOSX", 1, &[0; 4], 4), 4), Ok(None));
+}
+
+#[test]
+fn a_malformed_prgflags_note_is_refused() {
+    // Descriptor not exactly one u32.
+    assert_eq!(elf::find_prgflags_note(&entry(b"NewTOS", 1, &[0; 8], 4), 4), Err(ParseError::BadNote));
+    assert_eq!(elf::find_prgflags_note(&entry(b"NewTOS", 1, &[], 4), 4), Err(ParseError::BadNote));
+    // Twice.
+    let mut two = prgflags_entry(1, 4);
+    two.extend(prgflags_entry(2, 4));
+    assert_eq!(elf::find_prgflags_note(&two, 4), Err(ParseError::BadNote));
+    // Running past the segment: truncated desc, truncated header.
+    let n = prgflags_entry(7, 4);
+    assert_eq!(elf::find_prgflags_note(&n[..22], 4), Err(ParseError::BadNote));
+    assert_eq!(elf::find_prgflags_note(&n[..8], 4), Err(ParseError::BadNote));
+    // A huge namesz must not wrap.
+    let mut wild = n.clone();
+    wild[0..4].copy_from_slice(&u32::MAX.to_le_bytes());
+    assert_eq!(elf::find_prgflags_note(&wild, 4), Err(ParseError::BadNote));
+    // Alignments other than 0/1/4/8.
+    assert_eq!(elf::find_prgflags_note(&n, 2), Err(ParseError::BadNote));
+    assert_eq!(elf::find_prgflags_note(&n, 16), Err(ParseError::BadNote));
+}
+
+// ── whole images: parse records PT_NOTE, prgflags_of reads it ──────────
+
+const NOTE_OFF: u64 = 0x1040;
+
+/// A minimal ET_DYN image: one PT_LOAD (text, file offset == VA 0x1000,
+/// 0x100 bytes) with `notes` placed at 0x1040, plus `extra_phdrs`
+/// `(type, offset, filesz, align)`.
+fn image(notes: &[u8], note_phdrs: &[(u32, u64, u64, u64)]) -> Vec<u8> {
+    let phnum = 1 + note_phdrs.len();
+    let mut b = vec![0u8; 0x1100];
+    b[0..4].copy_from_slice(b"\x7fELF");
+    b[4] = 2; // ELFCLASS64
+    b[5] = 1; // little endian
+    b[6] = 1; // EV_CURRENT
+    b[16..18].copy_from_slice(&3u16.to_le_bytes()); // ET_DYN
+    b[18..20].copy_from_slice(&183u16.to_le_bytes()); // EM_AARCH64
+    b[20..24].copy_from_slice(&1u32.to_le_bytes());
+    b[24..32].copy_from_slice(&0x1000u64.to_le_bytes()); // e_entry
+    b[32..40].copy_from_slice(&64u64.to_le_bytes()); // e_phoff
+    b[52..54].copy_from_slice(&64u16.to_le_bytes()); // e_ehsize
+    b[54..56].copy_from_slice(&56u16.to_le_bytes()); // e_phentsize
+    b[56..58].copy_from_slice(&(phnum as u16).to_le_bytes());
+    let ph = |b: &mut Vec<u8>, i: usize, t: u32, flags: u32, off: u64, va: u64, fsz: u64, msz: u64, al: u64| {
+        let o = 64 + i * 56;
+        b[o..o + 4].copy_from_slice(&t.to_le_bytes());
+        b[o + 4..o + 8].copy_from_slice(&flags.to_le_bytes());
+        b[o + 8..o + 16].copy_from_slice(&off.to_le_bytes());
+        b[o + 16..o + 24].copy_from_slice(&va.to_le_bytes());
+        b[o + 32..o + 40].copy_from_slice(&fsz.to_le_bytes());
+        b[o + 40..o + 48].copy_from_slice(&msz.to_le_bytes());
+        b[o + 48..o + 56].copy_from_slice(&al.to_le_bytes());
+    };
+    ph(&mut b, 0, PT_LOAD, 5, 0x1000, 0x1000, 0x100, 0x100, 0x1000);
+    for (i, &(t, off, sz, al)) in note_phdrs.iter().enumerate() {
+        ph(&mut b, i + 1, t, 4, off, off, sz, sz, al);
+    }
+    b[NOTE_OFF as usize..NOTE_OFF as usize + notes.len()].copy_from_slice(notes);
+    b
+}
+
+fn flags_of(blob: &[u8]) -> Result<Option<u32>, ParseError> {
+    let img = elf::parse(blob, blob.len() as u64)?;
+    elf::prgflags_of(&img, |s| blob.get(s.file_offset as usize..(s.file_offset + s.file_size) as usize))
+}
+
+#[test]
+fn parse_records_the_note_segment_and_its_value_is_found() {
+    let n = prgflags_entry(PF_TTRAMMEM, 4);
+    let blob = image(&n, &[(PT_NOTE, NOTE_OFF, n.len() as u64, 4)]);
+    let img = elf::parse(&blob, blob.len() as u64).unwrap();
+    assert_eq!(img.notes().len(), 1);
+    assert_eq!(img.notes()[0].file_offset, NOTE_OFF);
+    assert_eq!(img.notes()[0].file_size, 24);
+    assert_eq!(img.segments().len(), 1, "a PT_NOTE is not a load segment");
+    assert_eq!(flags_of(&blob), Ok(Some(PF_TTRAMMEM)));
+}
+
+#[test]
+fn no_note_means_no_value_and_the_loader_takes_pf_standard() {
+    let blob = image(&[], &[]);
+    assert_eq!(flags_of(&blob), Ok(None));
+    // The loader's default (`loader.rs` step 1c) is the value every program
+    // had before E8b.
+    assert_eq!(PF_STANDARD, 7);
+}
+
+#[test]
+fn a_prgflags_note_in_two_segments_is_refused() {
+    let n = prgflags_entry(1, 4);
+    let blob = image(&n, &[(PT_NOTE, NOTE_OFF, 24, 4), (PT_NOTE, NOTE_OFF, 24, 4)]);
+    assert_eq!(flags_of(&blob), Err(ParseError::BadNote));
+}
+
+#[test]
+fn note_segments_outside_the_file_too_big_or_too_many_are_refused() {
+    let n = prgflags_entry(1, 4);
+    let past = image(&n, &[(PT_NOTE, 0x10F0, 0x20, 4)]);
+    assert_eq!(elf::parse(&past, past.len() as u64).err(), Some(ParseError::BadNoteSegment));
+    let big = image(&n, &[(PT_NOTE, 0, MAX_NOTE_BYTES + 4, 4)]);
+    let mut big = big;
+    big.resize(0x2000, 0);
+    assert_eq!(elf::parse(&big, big.len() as u64).err(), Some(ParseError::BadNoteSegment));
+    let many: Vec<_> = (0..=MAX_NOTE_SEGMENTS).map(|_| (PT_NOTE, NOTE_OFF, 24, 4)).collect();
+    let many = image(&n, &many);
+    assert_eq!(elf::parse(&many, many.len() as u64).err(), Some(ParseError::BadNoteSegment));
+}
+
+#[test]
+fn a_bad_note_is_an_unloadable_program() {
+    for e in [ParseError::BadNote, ParseError::BadNoteSegment] {
+        assert_eq!(PexecError::LoadFailed(LoadError::Parse(e)).errno(), EPLFMT);
+    }
+}
+
+#[test]
+fn the_flags_choose_the_pool_like_emutos_alloc_env_and_alloc_tpa() {
+    assert_eq!(loader::pool_mode(PF_STANDARD), MX_PREFTTRAM);
+    assert_eq!(loader::pool_mode(PF_TTRAMLOAD), MX_PREFTTRAM);
+    assert_eq!(loader::pool_mode(0), MX_STRAM);
+    assert_eq!(loader::pool_mode(PF_TTRAMMEM | 1), MX_STRAM, "TT-RAM Malloc alone does not move the TPA");
+}
