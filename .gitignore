# Build artifacts
/target
**/*.rs.bk
Cargo.lock.bak

# Build output
/build
*.img
*.elf
*.bin

# Editor/OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Local overrides (not committed)
.cargo/config.local.toml

# External reference material (acquired per contributor; copyright)
# `references/README.md` is the only file in this tree that is committed.
# EmuTOS upstream checkout lives at references/emutos/ (separate git repo,
# never modified by NewTOS). All gitignored except this README.
/references/*
!/references/README.md

# User-program build dirs (each programs/* is its own workspace)
programs/*/target/

# graphify knowledge-graph output (generated, rebuild with `graphify update .`)
graphify-out/

# Local SD-card backup (RPi firmware + game ROM) — not for the public repo
sd-card-backup-*/

# Local app/tool sources — the basis for a native NewTOS toolchain
# (compiler + tools). Kept out of the OS repo; see Task #76.
/Applications/
