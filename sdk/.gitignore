# NewTOS native C toolchain — tracking policy.
#
# Each ported library (libc = mintlib, gemlib, cflib) vendors its PRISTINE source
# as a tarball; build-*.sh extracts it and overlays our edits (overlay/). The
# extracted tree, object files, and archive are build artifacts and are NOT
# tracked — the tarball + overlay/ + build script + tests ARE. A clone builds
# with no external network.

# Extracted source trees + build artifacts (regenerable via build-*.sh).
/libc/mintlib/
/libc/build/
/libc/libc.a
# ILP32 sibling artifacts (ADR-020 Stage 2; regenerable via build-libc-ilp32.sh).
/libc/mintlib-ilp32/
/libc/build-ilp32/
/libc/libc-ilp32.a
/gemlib/gemlib-0.44.0/
/gemlib/build/
/gemlib/gemlib.a
/cflib/cflib-21/
/cflib/build/
/cflib/cflib.a
# ILP32 sibling artifacts (ADR-020 Stage 3; regenerable via build-*-ilp32.sh).
/gemlib/gemlib-0.44.0-ilp32/
/gemlib/build-ilp32/
/gemlib/gemlib-ilp32.a
/cflib/cflib-21-ilp32/
/cflib/build-ilp32/
/cflib/cflib-ilp32.a
**/*.o
*.NCP
*.NAP

# App source trees under /apps/ stay vendored (big; third-party — QED compiles
# UNMODIFIED). Build scripts + tests directly in /apps/ ARE tracked. Our own LP64
# overlay edits live OUTSIDE the vendored (embedded-git) app trees, under
# sdk/overlays/<app>/, so they are tracked normally.
/apps/*/

# macOS junk that FAT round-trips create.
.DS_Store
._*
.Spotlight-V100
.fseventsd
.Trashes
