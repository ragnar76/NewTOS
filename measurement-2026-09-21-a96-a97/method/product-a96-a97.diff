+/// The stride of an OBJECT record at `abi` width.
+#[inline]
+pub(crate) fn record_stride(abi: Abi) -> u64 {
+    match abi {
+        Abi::Lp64 => 32,
+        Abi::Ilp32 => 24,
+    }
+}
