+    tree: u64,
+    /// `ml_havebox` (`deskdir.c:60`) — a dialog box is currently displayed, so
+    /// the next one redraws in place instead of reserving its own area.
+    havebox: bool,
+    /// `G.g_covwrpref`, read once at [`dir_op`] entry: the box is modal, so it
