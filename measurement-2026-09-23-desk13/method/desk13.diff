-    // `fmt_date` keeps NewTOS's dash separator here (see `inf::fmt_date`);
-    // `fmt_time` writes a fixed 7-character field, the trailing two characters
-    // being `am`/`pm` or, in 24-hour mode, the two blanks the trim below drops.
+    // `format_fnode` calls the same two formatters (`deskinf.c:289,293`), and
+    // passes neither a separator nor a format of its own: both come out of
+    // `fmt_date`'s own `DATEFORM_SEP`/`_IDT` rule. `fmt_time` writes a fixed
+    // 7-character field, the trailing two characters being `am`/`pm` or, in
+    // 24-hour mode, the two blanks the trim below drops.
     let mut dbuf = [b' '; 11];
-    let dn = super::inf::fmt_date(f.f_date, false, b'-', datefmt, &mut dbuf);
+    let dn = super::inf::fmt_date(f.f_date, false, datefmt, idt, &mut dbuf);
     put(out, 27, &dbuf[..dn]);
     let mut tbuf = [b' '; 8];
-    let tn = super::inf::fmt_time(f.f_time, timefmt, &mut tbuf);
+    let tn = super::inf::fmt_time(f.f_time, timefmt, idt, &mut tbuf);
     put(out, 37, &tbuf[..tn]);
 
     // NUL-terminate after the last used column, trimming trailing spaces.

=== new file: tos-api/tests/gemdos_ssystem_idt_cookie.rs ===
diff --git a/tos-api/tests/gemdos_ssystem_idt_cookie.rs b/tos-api/tests/gemdos_ssystem_idt_cookie.rs
new file mode 100644
index 0000000..e93ff25
--- /dev/null
+++ b/tos-api/tests/gemdos_ssystem_idt_cookie.rs
@@ -0,0 +1,129 @@
+//! **DESK13** — the route the desktop takes to the `_IDT` cookie, pinned at
+//! the GEMDOS trap boundary.
+//!
+//! EmuTOS's desktop reads `_IDT` with `Supexec((LONG)get_idt_cookie)`
+//! (`references/emutos/desk/desksupp.c:219`), because on m68k the jar is only
+//! reachable through the pointer at `$5A0`, in supervisor-only low memory. That
+//! is an m68k *mechanism*, and `docs/COMPATIBILITY.md` puts mechanisms on the
+//! free side of the line. NewTOS has neither the need nor the call: XBIOS
+//! `Supexec` (0x26) is an open ADR (`docs/api/xbios/26-supexec.md`, "NewTOS
+//! status: decision deferred"), and the cookie-jar spec already names the
+//! replacement — "There is no `Supexec` in the kernel … the low-memory area an
+//! app wants is already in its own address space"
+//! (`docs/api/bios/_cookie-jar.md` §Status 2026-09-14).
+//!
+//! So `kernel/src/desk/dosbind.rs::dos_getcookie` issues
+//! `Ssystem(S_GETCOOKIE, tag, 0)` over `svc #1` — the same trap the desktop
+//! uses for every other system service (DESK10). This test drives exactly that
+//! call through `tos_api::gemdos::dispatch`, and asserts the two things the
+//! desktop's date/time formatting now rests on:
+//!
+//! 1. the call answers with the cookie **value in `x0`** when `arg2` is 0
+//!    (the desktop cannot use the pointer form: `s_getcookie` stores through an
+//!    unprivileged `sttr`, which faults on a kernel address); and
+//! 2. the seeded `_IDT` is `0x0000112F` — `docs/api/bios/_cookie-jar.md:137`,
+//!    `tos-api/src/cookie.rs` `seed_defaults` — i.e. **24-hour, day-before-
+//!    month, `/` separator**.
+//!
+//! Point 2 is the ground truth behind DESK13's date decision: `_IDT` says DMY
+//! and `/`, and the desktop's text view used to print MDY with a dash. The
+//! resolution rule now lives in exactly one place
+//! (`kernel/src/desk/model.rs`'s `DateFmt::rendered`/`TimeFmt::rendered`), and
+//! it reads the word this test pins.
+
+use std::sync::{Mutex, Once};
+
+use tos_api::host::Host;
+use tos_api::trap::{TrapArgs, TrapClass};
+
+/// The cookie jar is a process-wide static; keep the cases in this binary from
+/// racing each other on it.
+static JAR: Mutex<()> = Mutex::new(());
+
+/// The GEMDOS dispatcher refuses every call with `EUNDEV` until a host is
+/// installed (`tos-api/src/gemdos/mod.rs:137-141`). `Ssystem`'s cookie
+/// subfunctions touch nothing else of it, so the smallest possible one will do:
+/// `console_write_byte` is the trait's only required method.
+struct NullHost;
+
+impl Host for NullHost {
+    fn console_write_byte(&self, _byte: u8) {}
+}
+
+static HOST: Once = Once::new();
+
+/// Install [`NullHost`] once and seed the boot cookie set, as
+/// `kernel/src/lib.rs` does.
+fn rig() {
+    HOST.call_once(|| {
+        let slot: &'static &'static dyn Host = Box::leak(Box::new(&NullHost as &'static dyn Host));
+        tos_api::host::install_host(slot);
+    });
+    tos_api::cookie::seed_defaults(0x0000_0100);
+}
+
+/// `Ssystem` — GEMDOS 0x154 (`docs/api/gemdos/154-ssystem.md`).
+const SSYSTEM: u16 = 0x154;
+/// `S_GETCOOKIE` — `Ssystem` subfunction 8 (FreeMiNT `sys/mint/ssystem.h`).
+const S_GETCOOKIE: u64 = 8;
+
+/// `'_IDT'` big-endian, as `tos_api::cookie::IDT` registers it.
+const IDT_TAG: u32 = u32::from_be_bytes(*b"_IDT");
+/// A tag that is deliberately not in the jar.
+const ABSENT_TAG: u32 = u32::from_be_bytes(*b"ZZZZ");
+
+/// FreeMiNT `EERROR` — `S_GETCOOKIE`'s answer for a tag that is not present
+/// (`sys/cookie.c:508-509`, `tos-api/src/gemdos/ssystem.rs`).
+const ERROR: i32 = -1;
+
+// `_IDT` bit layout (`references/emutos/include/biosdefs.h:161-173`).
+const IDT_24H: u32 = 0x1000;
+const IDT_TMASK: u32 = 0x1000;
+const IDT_BIT_DM: u32 = 0x100;
+const IDT_DMASK: u32 = 0x300;
+const IDT_SMASK: u32 = 0xFF;
+
+/// Issue a GEMDOS call the way `desk::dosbind::dos_trap` does: function id
+/// separate, arguments in `x0..`.
+fn gemdos(func: u16, a0: u64, a1: u64, a2: u64) -> i32 {
+    let args = TrapArgs {
+        regs: [a0, a1, a2, 0, 0, 0, 0, 0],
+        func: func as u64,
+        svc_imm: TrapClass::Gemdos as u16,
+    };
+    tos_api::gemdos::dispatch(&args)
+}
+
+/// `dos_getcookie(tag)` — the desktop's own wrapper, reproduced here so the
+/// test exercises the shape the kernel really sends.
+fn dos_getcookie(tag: u32) -> Option<u32> {
+    let rc = gemdos(SSYSTEM, S_GETCOOKIE, tag as i32 as i64 as u64, 0);
+    (rc >= 0).then_some(rc as u32)
+}
+
+#[test]
+fn the_desktop_reads_idt_through_ssystem_and_gets_the_seeded_word() {
+    let _lock = JAR.lock().unwrap_or_else(|e| e.into_inner());
+    rig();
+
+    let idt = dos_getcookie(IDT_TAG).expect("_IDT is seeded at boot");
+    assert_eq!(idt, 0x0000_112F, "docs/api/bios/_cookie-jar.md:137");
+
+    // The three fields the desktop's `Default` buttons defer to.
+    assert_eq!(idt & IDT_TMASK, IDT_24H, "_IDT says 24-hour");
+    assert_eq!(idt & IDT_DMASK, IDT_BIT_DM, "_IDT says day before month (DDMMYY)");
+    assert_eq!((idt & IDT_SMASK) as u8, b'/', "_IDT's separator is '/'");
+}
+
+#[test]
+fn a_tag_that_is_not_in_the_jar_answers_error_not_a_value() {
+    let _lock = JAR.lock().unwrap_or_else(|e| e.into_inner());
+    rig();
+
+    assert_eq!(
+        gemdos(SSYSTEM, S_GETCOOKIE, ABSENT_TAG as i32 as i64 as u64, 0),
+        ERROR,
+        "a missing tag is EERROR, which `dos_getcookie` turns into None"
+    );
+    assert_eq!(dos_getcookie(ABSENT_TAG), None);
+}
=== new file: tos-api/tests/aes_desk_dialog_exit_buttons.rs ===
diff --git a/tos-api/tests/aes_desk_dialog_exit_buttons.rs b/tos-api/tests/aes_desk_dialog_exit_buttons.rs
new file mode 100644
index 0000000..6e008b0
--- /dev/null
+++ b/tos-api/tests/aes_desk_dialog_exit_buttons.rs
@@ -0,0 +1,187 @@
+//! **DESK13** — the AES property the two new file-operation dialogs read their
+//! answer from: after `form_do` ends, **exactly the pressed `EXIT` button
+//! carries `SELECTED`**.
+//!
+//! Neither of EmuTOS's two `deskdir.c` dialogs uses `form_do`'s return value:
+//!
+//! * `dir_op` asks `more = (tree[CDOK].ob_state & SELECTED) ? TRUE : FALSE;`
+//!   (`references/emutos/desk/deskdir.c:963`) — "did the user press OK, or
+//!   Cancel?";
+//! * `do_namecon` asks `ob = inf_gindex(tree, CAOK, 3) + CAOK;`
+//!   (`deskdir.c:121`) — "which of OK / Skip / Stop?", by scanning the three
+//!   exit buttons for the selected one.
+//!
+//! That is a stronger requirement than "`form_do` returned the object": it
+//! means the AES must leave the state of a three-button exit run unambiguous.
+//! If two were selected, `inf_gindex` would return the first — and a *Skip*
+//! read as an *OK* overwrites a file the user asked to keep. If none were,
+//! `inf_gindex` returns `-1` and `CAOK - 1` is the editable name field.
+//!
+//! `kernel/src/desk/dir.rs` reproduces both reads, so both shapes are pinned
+//! here, driven through the real dispatcher with `form_button` (AES 56) — the
+//! same entry `form_do`'s inner loop uses for a click.
+//!
+//! The sibling test `aes_desk_prefs_radio.rs` covers the *radio* groups of
+//! `ADSETPRE`; this one covers the *exit* runs of `ADCPYDEL`/`ADCPALER`, which
+//! are plain `SELECTABLE | EXIT` buttons with no `RBUTTON` and therefore no
+//! sibling-deselect machinery behind them at all.
+
+#![allow(dead_code)]
+
+#[path = "aes_reference/harness.rs"]
+mod harness;
+
+use harness::{context, host_only, Pb, AES_LOCK};
+use tos_api::aes::object::Object;
+use tos_api::host::Host;
+
+const OP_FORM_BUTTON: i16 = 56;
+
+// obdefs.h
+const G_BOX: u16 = 20;
+const G_BUTTON: u16 = 26;
+const SELECTABLE: u16 = 0x0001;
+const DEFAULT: u16 = 0x0002;
+const EXIT: u16 = 0x0004;
+const LASTOB: u16 = 0x0020;
+const SELECTED: u16 = 0x0001;
+
+const NIL: i16 = -1;
+
+/// Opaque dialog-box colour word, as `kernel/src/desk/inf.rs` uses.
+const BOX_SPEC: u64 = (1 << 16) | 0x1100;
+
+static LBL: &[u8] = b" x \0";
+
+fn mk(ty: u16, fl: u16, spec: u64, x: i16, y: i16, w: i16, h: i16, next: i16, head: i16, tail: i16) -> Object {
+    Object {
+        ob_next: next,
+        ob_head: head,
+        ob_tail: tail,
+        ob_type: ty,
+        ob_flags: fl,
+        ob_state: 0,
+        ob_spec: spec,
+        ob_x: x,
+        ob_y: y,
+        ob_width: w,
+        ob_height: h,
+    }
+}
+
+fn exit_btn(x: i16, next: i16, first: bool, last: bool) -> Object {
+    let fl = SELECTABLE | EXIT | if first { DEFAULT } else { 0 } | if last { LASTOB } else { 0 };
+    mk(G_BUTTON, fl, LBL.as_ptr() as u64, x, 60, 90, 28, next, NIL, NIL)
+}
+
+/// `ADCPYDEL`'s shape, reduced to what the read needs: a root with `CDOK` and
+/// `CDCNCL` under it (`desk_rsc.c:1224-1234`).
+const CDOK: usize = 1;
+
+fn cpydel() -> Vec<Object> {
+    vec![
+        mk(G_BOX, 0, BOX_SPEC, 0, 0, 300, 120, NIL, 1, 2),
+        exit_btn(20, 2, true, false),
+        exit_btn(190, 0, false, true),
+    ]
+}
+
+/// `ADCPALER`'s shape: `CAOK`, `CASKIP`, `CASTOP` (`desk_rsc.c:1263-1279`).
+const CAOK: usize = 1;
+
+fn cpaler() -> Vec<Object> {
+    vec![
+        mk(G_BOX, 0, BOX_SPEC, 0, 0, 340, 120, NIL, 1, 3),
+        exit_btn(20, 2, true, false),
+        exit_btn(125, 3, false, false),
+        exit_btn(230, 0, false, true),
+    ]
+}
+
+/// Park the VDI mouse pointer, button **up**, at `(x, y)`.
+///
+/// An `EXIT` button is not an `RBUTTON`, so `fm_button` sends it through
+/// `graf::watchbox` (`tos-api/src/aes/graf.rs:400-419`), which answers "was the
+/// release inside the object?". With the pointer parked inside and no button
+/// held, the watch loop breaks on its first pass and answers `true` — a
+/// completed click. That is the release edge `form_do` reacts to, and without
+/// it `watchbox` reports a release *outside* the button and the dialog stays up
+/// (which is correct behaviour, and is why this parking is not a fudge).
+fn park(x: i16, y: i16) {
+    let backend = Host::raster(host_only()).expect("the harness host has a raster backend");
+    // Relative feed: walk hard into the top-left clamp first, then out to the
+    // wanted position.
+    tos_api::vdi::feed_relative(-4000, -4000, 0, backend);
+    tos_api::vdi::feed_relative(x, y, 0, backend);
+}
+
+/// `form_button(tree, obj, clks)` — `int_out[0]` is "keep the dialog running",
+/// `int_out[1]` the next object. The pointer is parked over `obj` first, as a
+/// real click has it.
+fn form_button(pb: &mut Pb, tree: &mut [Object], obj: usize) -> (i16, i16) {
+    let o = &tree[obj];
+    park(o.ob_x + o.ob_width / 2, o.ob_y + o.ob_height / 2);
+    pb.intin.fill(0);
+    pb.addrin[0] = tree.as_mut_ptr() as u64;
+    pb.intin[0] = obj as i16;
+    pb.intin[1] = 1; // one click
+    pb.call(OP_FORM_BUTTON, 2, 2, 1, 0);
+    (pb.intout[0], pb.intout[1])
+}
+
+/// `inf_gindex` (`util/optimize.c:134-147`) — the index, counted from the
+/// start, of the first `SELECTED` object in `tree[base .. base+n]`, or `-1`.
+/// Reproduced from `kernel/src/desk/inf.rs`.
+fn inf_gindex(tree: &[Object], base: usize, n: usize) -> i16 {
+    for (k, obj) in tree.iter().skip(base).take(n).enumerate() {
+        if obj.ob_state & SELECTED != 0 {
+            return k as i16;
+        }
+    }
+    -1
+}
+
+#[test]
+fn the_copy_delete_box_can_tell_ok_from_cancel_by_state_alone() {
+    let _lock = AES_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let _ctx = context();
+    let mut pb = Pb::new();
+
+    // Cancel: `tree[CDOK].ob_state & SELECTED` must be clear, which is what
+    // `dir_op` turns into "stop before touching a single file".
+    let mut tree = cpydel();
+    let (cont, _next) = form_button(&mut pb, &mut tree, CDOK + 1);
+    assert_eq!(cont, 0, "an EXIT button ends the dialog");
+    assert_eq!(tree[CDOK].ob_state & SELECTED, 0, "OK must not be selected by a Cancel click");
+    assert_ne!(tree[CDOK + 1].ob_state & SELECTED, 0, "Cancel is");
+
+    // OK: the same read, the other way round.
+    let mut tree = cpydel();
+    let (cont, _next) = form_button(&mut pb, &mut tree, CDOK);
+    assert_eq!(cont, 0);
+    assert_ne!(tree[CDOK].ob_state & SELECTED, 0, "`deskdir.c:963` reads exactly this bit");
+    assert_eq!(tree[CDOK + 1].ob_state & SELECTED, 0);
+}
+
+#[test]
+fn the_name_conflict_box_identifies_one_of_its_three_buttons() {
+    let _lock = AES_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let _ctx = context();
+    let mut pb = Pb::new();
+
+    // OK (0), Skip (1), Stop (2) — `do_namecon` adds `CAOK` to the index and
+    // compares the result against `CASTOP` / `CASKIP` (`deskdir.c:121,346-349`).
+    for pressed in 0..3usize {
+        let mut tree = cpaler();
+        let (cont, _next) = form_button(&mut pb, &mut tree, CAOK + pressed);
+        assert_eq!(cont, 0, "every one of the three is an EXIT button");
+        assert_eq!(
+            inf_gindex(&tree, CAOK, 3),
+            pressed as i16,
+            "the pressed button, and only it, is left SELECTED — a Skip read as \
+             an OK would overwrite a file the user asked to keep"
+        );
+        let selected: Vec<usize> = (0..3).filter(|&k| tree[CAOK + k].ob_state & SELECTED != 0).collect();
+        assert_eq!(selected, vec![pressed], "exactly one");
+    }
+}
