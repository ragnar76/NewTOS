+    files: u32,
+    /// Folders still to go, shown in `CDFOLDS` (`deskdir.c:592`).
+    dirs: u32,
+    /// Set once the user pressed *Stop*; every loop checks it, which is what
+    /// EmuTOS's `more == 0` propagation does.
