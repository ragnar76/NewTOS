+        let v: u64;
+        // SAFETY: read-only system-register read, permitted at EL1.
+        unsafe {
+            core::arch::asm!("mrs {0}, cntfrq_el0", out(reg) v,
+                             options(nomem, nostack, preserves_flags));
+        }
+        v
+    }
+    #[cfg(not(target_arch = "aarch64"))]
+    {
+        1
+    }
